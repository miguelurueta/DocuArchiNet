@startuml
title Flujo de Datos entre Capas (SPA Dashboard)

actor Usuario
rectangle "Presentación" {
  component "DashboardLayout"
  component "Sidebar"
  component "Navbar"
  component "DashboardHome"
  component "CardComponent"
}

rectangle "Aplicación" {
  component "React Router\n(Outlet + navigate)" as Router
  component "useMenuItems" as UseMenuItems
  component "useDashboardMetrics" as UseMetrics
}

rectangle "Dominio/Transformación" {
  component "buildMenuTree"
  component "BuildCard"
  component "menuFallback"
}

database "Infraestructura/API" {
  component "menuService"
  component "Endpoints backend"
}

Usuario --> DashboardLayout : navega /dashboard
DashboardLayout --> Router
Router --> DashboardHome
DashboardHome --> UseMenuItems : solicitar menú
DashboardHome --> UseMetrics : solicitar métricas

UseMenuItems --> menuService : fetch menu
menuService --> "Endpoints backend" : HTTP
"Endpoints backend" --> menuService : RawMenuItem[]
menuService --> UseMenuItems

UseMenuItems --> buildMenuTree : normalizar/arbolizar
buildMenuTree --> menuFallback : fallback (si aplica)
buildMenuTree --> UseMenuItems : MenuNode[]

UseMenuItems --> Sidebar : menuTree
UseMenuItems --> CardComponent : menuTree
UseMetrics --> CardComponent : metricMap
CardComponent --> BuildCard : accesos directos

Usuario --> CardComponent : click en card
CardComponent --> Router : navigate(UrlNode)
Router --> DashboardLayout : render destino sin recarga
@enduml
