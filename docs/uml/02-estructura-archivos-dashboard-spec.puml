@startuml
title Estructura de Archivos - Dashboard + OpenSpec Validation
left to right direction

package "DocuArchiCore.react" {
  folder "src/modules/dashboard" {
    folder "components" {
      [DashboardLayout.tsx]
      [Sidebar.tsx]
      [Navbar.tsx]
      [CardComponent.tsx]
    }
    folder "hooks" {
      [useMenuItems.ts]
      [useDashboardMetrics.ts]
    }
    folder "pages" {
      [DashboardHome.tsx]
    }
    folder "__tests__" {
      [dashboard.spec-coverage.test.tsx]
    }
  }

  folder "tools/spec-validator" {
    [validateSpec.ts]
    [parseOpenSpec.ts]
    [extractTestCases.ts]
  }

  folder "openspec" {
    [dashboard.behavior.yaml]
    [dashboard.contract.yaml]
  }

  folder ".github/workflows" {
    [spec-validation.yml]
  }

  [package.json]
}

[spec-validation.yml] --> [package.json] : usa scripts npm
[validateSpec.ts] --> [parseOpenSpec.ts]
[validateSpec.ts] --> [extractTestCases.ts]
[parseOpenSpec.ts] --> [dashboard.behavior.yaml]
[parseOpenSpec.ts] --> [dashboard.contract.yaml]
[extractTestCases.ts] --> [dashboard.spec-coverage.test.tsx]
@enduml
