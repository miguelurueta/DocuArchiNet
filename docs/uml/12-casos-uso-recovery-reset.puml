@startuml
left to right direction
actor "Usuario sin sesión" as User
actor "API Recovery" as Api
rectangle "DocuArchiCore SPA" {
  usecase "UC-RECOVERY-REQUEST\nSolicitar recuperación" as UC_REC
  usecase "UC-RESET-PASSWORD\nCambiar contraseña" as UC_RST
}
User --> UC_REC
User --> UC_RST
UC_REC --> Api : POST /recovery/start
UC_RST --> Api : POST /recovery/reset-password
@enduml
