@startuml
title Actividad: Login -> OTP -> Token
start
:Usuario envía credenciales;
if (Respuesta login) then (SUCCESS)
  :Persistir token;
  :Refrescar claims;
  :Navegar a /dashboard;
  stop
else (SECOND_FACTOR_REQUIRED)
  :Navegar a /verificar-otp;
  :Iniciar timer OTP;
  if (OTP válido) then (Sí)
    :Persistir token;
    :Refrescar claims;
    :Navegar a /dashboard;
    stop
  else (No)
    if (OTP expirado) then (Sí)
      :Mostrar modal expiración;
      :Redirigir a login/reintento;
      stop
    else (Inválido)
      :Mostrar error funcional;
      :Permitir reintento;
      stop
    endif
  endif
endif
@enduml
