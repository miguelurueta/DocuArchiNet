# Visual Studio
.vs/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# Archivos temporales del proyecto
Temp_Image/
temp/
tmp/

# Credenciales locales de las automatizaciones OPSXJ
.env.jira
env.jira

# Archivos de usuario de Visual Studio
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs
*.log

# Resultados de compilación
TestResults/
Generated_Code/

# Evidencia local asociada al SHA; se regenera en cada validación.
/.opsxj/evidence/

# Artefactos locales de Playwright: pueden incluir cookies de sesión o trazas.
/tools/e2e/artifacts/
/tools/e2e/node_modules/
/tools/e2e/.env
/tools/e2e/.env.*

# Bitacora local append-only del flujo OPSXJ; no se versiona ni contiene secretos.
/.opsxj/runs/

# Paquetes restaurables
packages/
*.nupkg

# Sistema operativo
Thumbs.db
Desktop.ini

# Archivos temporales
*.tmp
*.temp

# Artefacto PDF local de inspeccion; no forma parte del codigo fuente.
/pdfjs/pdf_anotate_view/ojo.pdf
