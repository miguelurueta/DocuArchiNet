        If id_flujo_trabajo = 0 And actividades_generales_workflow_.Nombre_tipo_actividad <> "USUARIORESPONSABLE" And actividades_generales_workflow_.Nombre_tipo_actividad <> "USUARIORESPONSABLERADICADOR" Then
