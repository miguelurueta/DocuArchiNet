        For i4 As Integer = 0 To Matri_Datos.Length - 1
            If Matri_Datos(i4).Campo_Obligatorio = 1 And Matri_Datos(i4).Estado_Campo = 1 And Matri_Datos(i4).campo_sistema = 1 _
                And Matri_Datos(i4).Campo_Plantilla <> "REMITENTE_COR" And Matri_Datos(i4).Campo_rad_interno = 1 And Matri_Datos(i4).Campo_Plantilla <> "Destinatario_Cor" Then
                If Matri_Datos(i4).Comportamiento_Campo = "SELECCION" Then
                    If Matri_Datos(i4).TEXTO_CAMPO = "" Or Matri_Datos(i4).TEXTO_CAMPO = "SELECCIONE" Then
