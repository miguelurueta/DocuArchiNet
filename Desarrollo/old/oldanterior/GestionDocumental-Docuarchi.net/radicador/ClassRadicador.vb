                End If
                'ASUNTO
                If Matri_Datos(i3).Campo_Plantilla = "ASUNTO" Then

                    Matri_Datos(i3).TEXTO_CAMPO = estru.ASUNTO
                    Matri_Datos(i3).Alias_Campo = "Asunto"

                End If
                If Matri_Datos(i3).Campo_Plantilla = "REMITENTE_COR" Then
                    Dim ref_class_remit_interno As New Class_remit_dest_interno
                    Result = ref_class_remit_interno.Retorna_nombre_cargo_destinatario_interno(HttpContext.Current.Session.Item("GA_IDUSUARIOGESTION"), _
                                                                                               nombre_remitente, _
                                                                                               cargo_remit)
                    If Result <> "YES" Then
                        Registra_Radicado_plantilla_respuesta = Result
                        Exit Function
                    End If
                    Matri_Datos(i3).TEXTO_CAMPO = nombre_remitente
                    Matri_Datos(i3).Alias_Campo = "Destinatario correspondencia"
                End If
                '
                If Matri_Datos(i3).Campo_Plantilla = "Destinatario_Cor" Then
                    Matri_Datos(i3).TEXTO_CAMPO = Destinatario_cor
                End If
            End If
        Next

        '***************************************************************************
        'Verifcia existencia destinatario externo
        '***************************************************************************
        Dim codigo_script As Integer = 0
        For i As Integer = 0 To Matri_Datos.Length - 1
            If Matri_Datos(i).Campo_Plantilla = "REMITENTE_COR" Then
                If Matri_Datos(i).ID_SCRIPT = 0 Then
                    Registra_Radicado_plantilla_respuesta = "El sistema ha detectado que el campo remitente no tiene una plantilla de validación relacionada por favor seleccione una plantilla"
                    Exit Function
                Else
                    codigo_script = Matri_Datos(i).ID_SCRIPT
                End If

            End If
        Next
        Dim campo_comparacion As String = ""
        Dim id_plantilla_validacion As Integer = 0
        Dim nombre_plantilla_validacion As String = ""
        Dim codigo_dest_externo As Integer = estru.codigo_dest_externo
        Dim nombre_dest_externo As String = ""
        Dim Ref_Class_relacion_script_plantilla As New Class_relacion_script_plantilla
        If codigo_script <> 0 Then
            Result = Ref_Class_relacion_script_plantilla.retorna_campo_compracion_plantilla(codigo_script, _
                                                                                            campo_comparacion, _
                                                                                            nombre_plantilla_validacion, _
                                                                                            id_plantilla_validacion)
            If Result <> "YES" Then
                Registra_Radicado_plantilla_respuesta = Result
                Exit Function
            End If
            Result = solicita_nombre_destinatario_externo(codigo_dest_externo, _
                                                          nombre_plantilla_validacion, _
                                                          campo_comparacion, _
                                                          nombre_dest_externo)
            If Result <> "YES" Then
                Registra_Radicado_plantilla_respuesta = Result
                Exit Function
            End If
        End If
        For i As Integer = 0 To Matri_Datos.Length - 1
            If Matri_Datos(i).Campo_Plantilla = "Destinatario_Cor" Then
                Matri_Datos(i).TEXTO_CAMPO = nombre_dest_externo
                Destinatario_cor = nombre_dest_externo
            End If
        Next
        '****************************************************************************
        'Asigna expediente al documento registrado
        '****************************************************************************
        Dim expediente_documento As String = "Null"

        '*********************************************************************************
        'Retorna id usuario destino radicacion
        '*********************************************************************************
        Dim codigo_destinatario As Integer = HttpContext.Current.Session.Item("GA_IDUSUARIOGESTION")
        Dim ref_Destinatario_Cor As String = nombre_remitente
        Dim ref_cargo_festinatario As String = cargo_remit

        '*********************************************************************************
        'Retorna nombre y id area destinatario
        '*********************************************************************************
        Dim nombre_area As String = ""
        Dim id_area As Integer = -1
        Dim Ref_class_remit_dest_int As New Class_remit_dest_interno
        Result = Ref_class_remit_dest_int.Solicita_id_area_nombre_area_destinatario(codigo_destinatario, _
                                                                                    id_area, _
                                                                                    nombre_area)
        If Result <> "YES" Then
            Registra_Radicado_plantilla_respuesta = Result
            'Destinatario_Cor.Focus()
            Exit Function
        End If
        '*********************************************************************************
        '14-000-000-000000000
        '
        'Arma el consecutivo radicado año-depedencia-sede-id_plantilla-consecutivo-tipo
        '*********************************************************************************
        Dim año_radic As String = Now.Year.ToString.Substring(2, 2)
        '-------------------------------------------------------
        'Retorna sede empresa usuario radicador
        '-------------------------------------------------------
        Dim nombre_sede As String = ""
        Dim id_sede As Integer = -1
        Dim Ref_Class_usuario_radicador As New Class_usuario_radicador
        Result = Ref_Class_usuario_radicador.Retorna_Id_Nombre_sede_Empresa(HttpContext.Current.Session.Item("RA_ID_USUARIO"), _
                                                                            id_sede, _
                                                                            nombre_sede)
        If Result <> "YES" Then
            Registra_Radicado_plantilla_respuesta = Result
            Exit Function
        End If
        Dim pre_consecutivo As String = año_radic & id_area.ToString.PadLeft((4 - id_area.ToString.Length) + id_area.ToString.Length, "0") & _
          Codigo_Plantilla.ToString.PadLeft((2 - Codigo_Plantilla.ToString.Length) + Codigo_Plantilla.ToString.Length, "0")
        Dim SqlCampos As String = ""
        SqlCampos = "INSERT INTO " & nombre_plantilla & " ( Destinatario_Externo_id_Dest_Ext," & _
            "Remit_Dest_Interno_id_Remit_Dest_Int,Usuario_Radicador_id_usuario,System_Plantilla_Radicado_id_Plantilla," & _
            "Consecutivo_Rad,Consecutivo_CodBarra,Fecha_Radicado,Codigo_Sede,Id_area_remit_dest_interno,Area_remit_dest_interno,Tipo_radicado_plantilla,CARGO_REMITENTE"
        '------------------------------------------------------
        'Agrega campos dinamicos
        '------------------------------------------------------
        For i4 As Integer = 0 To Matri_Datos.Length - 1
            If Matri_Datos(i4).Estado_Campo = 1 Then
                SqlCampos = SqlCampos & "," & Matri_Datos(i4).Campo_Plantilla
            End If
        Next
        '------------------------------------------------------
        'Asignar datos radicacion
        '------------------------------------------------------
        Dim stiempo As Object = Nothing
        Dim minuno As Object = Nothing
        Dim hora As Object = Nothing
        Dim dias_calendario As Object = Nothing
        Dim dias_no_habiles As Object = Nothing
        Dim refclas_gestion_fechas As New ClassGestionFechas
        Result = refclas_gestion_fechas.Solicita_tiempo_respuesta_tramite(estru.FECHA_REGISTRO,
                                                                          stiempo,
                                                                          hora,
                                                                          minuno,
                                                                          dias_calendario,
                                                                          dias_no_habiles)
        If Result <> "YES" Then
            Registra_Radicado_plantilla_respuesta = Result
            Exit Function
        End If
        '---------------------------------------
        'Implementa consecutivo radicado general
        '---------------------------------------
        Dim Ref_Class_system_plantilla_consecutivo_radicado As New Class_system_plantilla_consecutivo_radicado
        Dim Estado_consecutivo_radicado_general As String = ""
        Result = Ref_Class_system_plantilla_consecutivo_radicado.Solicita_estado_registro_consecutivo_radicado(Estado_consecutivo_radicado_general)
        If Result <> "YES" Then
            Registra_Radicado_plantilla_respuesta = Result
            Exit Function
        End If
        '---------------------------------------
        'Asigna sql consecutivo radicado
        '---------------------------------------
        Dim Parametro_Select_System1 As String = ""
        If Estado_consecutivo_radicado_general = "YES" Then
            Parametro_Select_System1 = " SELECT Consecutivo_Rad,Consecutivo_CodBarra FROM system_plantilla_consecutivo_radicado  for update"
        Else
            Parametro_Select_System1 = " SELECT Consecutivo_Rad,Consecutivo_CodBarra FROM system_plantilla_Radicado " & _
            " where id_plantilla=" & Codigo_Plantilla & " for update"
        End If
        '----------------------------------------------------------
        'Implemetar función Inicializa consecutivo radicado anual
        '----------------------------------------------------------
        If Estado_consecutivo_radicado_general = "YES" Then
            Result = Ref_Class_system_plantilla_consecutivo_radicado.Inicializa_consecutivo_radicado_anual()
            If Result <> "YES" Then
                Registra_Radicado_plantilla_respuesta = Result
                Exit Function
            End If
        End If
        '------------------------------------------------------
        'Deteramina tipo radicado en la plantilla
        '------------------------------------------------------
        Dim tipo_radicado_plnatilla As Integer = 1
        Dim SqlDatos As String = "( '" & codigo_destinatario & "','" & codigo_dest_externo & "','" & HttpContext.Current.Session.Item("RA_ID_USUARIO") & "','" & _
        Codigo_Plantilla & "'"
        Dim myConnection As New MySqlConnection
        Dim ref As New conect.Dbase_Conction_Mysql_RA
        ref.Returna_Conexion_Mysql(myConnection)
        Dim myTrans As MySqlTransaction
        Dim mySqldatReader As MySqlDataReader
        Dim sqlresultinsert As Integer = 0
        Dim Class_zero_fill As New Class_zero_fill
        Try
            'myConnection.Open()
            Dim myCommand As MySqlCommand = myConnection.CreateCommand()
            myTrans = myConnection.BeginTransaction()
            myCommand.Connection = myConnection
            myCommand.Transaction = myTrans
            myCommand.CommandText = Parametro_Select_System1
            mySqldatReader = myCommand.ExecuteReader()
            If mySqldatReader Is Nothing Then
                Registra_Radicado_plantilla_respuesta = "Imposible Encontrar Registro En Tabla Systema Error Conexion"
                myTrans.Rollback()
                myConnection.Close()
                Exit Function
            End If
            If mySqldatReader.HasRows = False Then
                Registra_Radicado_plantilla_respuesta = "Imposible Encontrar Registro En Tabla Systema"
                'myTrans.Rollback()
                myConnection.Close()
                Exit Function
            End If

            '********************************************************
            'Valores recuperados de la consulta de la tabla system1
            '********************************************************
            mySqldatReader.Read()
            ConseCRadicado = mySqldatReader.Item(0)
            ConseCCodbarra = mySqldatReader.Item(1)
            ConseCRadicado = ConseCRadicado + 1
            ConseCCodbarra = ConseCCodbarra + 1
            Dim ConsecutivoRadicadoString As String = ConseCRadicado.ToString
            Result = Class_zero_fill.zero_fill(ConsecutivoRadicadoString, 5, "0")
            If Result <> "YES" Then
                Registra_Radicado_plantilla_respuesta = "Imposible agregar zerofill " & Result
                myConnection.Close()
                Exit Function
            End If
            Dim conseCCodbarrastrin As String = ConseCCodbarra.ToString
            Result = Class_zero_fill.zero_fill(conseCCodbarrastrin, 5, "0")
            If Result <> "YES" Then
                Registra_Radicado_plantilla_respuesta = "Imposible agregar zerofill " & Result
                'myTrans.Rollback()
                myConnection.Close()
                Exit Function
            End If
            ConsecutivoRadicadoString = pre_consecutivo & ConsecutivoRadicadoString
            conseCCodbarrastrin = pre_consecutivo & conseCCodbarrastrin
            SqlDatos = SqlDatos & ",'" & ConsecutivoRadicadoString & "'"
            SqlDatos = SqlDatos & ",'" & conseCCodbarrastrin & "'"
            SqlDatos = SqlDatos & ",'" & date1al & "'"
            SqlDatos = SqlDatos & ",'" & id_sede & "'"
            SqlDatos = SqlDatos & ",'" & id_area & "'"
            SqlDatos = SqlDatos & ",'" & nombre_area & "'"
            SqlDatos = SqlDatos & ",'" & tipo_radicado_plnatilla & "'"
            SqlDatos = SqlDatos & ",'" & ref_cargo_festinatario & "'"
            mySqldatReader.Close()
            For i4 As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i4).Estado_Campo = 1 Then
                    If Matri_Datos(i4).TEXTO_CAMPO = "" Then
                        SqlDatos = SqlDatos & "," & "null"
                    Else

                        If Matri_Datos(i4).Campo_Plantilla = "Remitente_Cor" Then
                            SqlDatos = SqlDatos & ",'" & Trim(ref_Destinatario_Cor) & "'"
                        Else
                            SqlDatos = SqlDatos & ",'" & Trim(Matri_Datos(i4).TEXTO_CAMPO) & "'"
                        End If

                    End If

                End If
            Next
            '-------------------------------------------
            'Isertar expediente
            '-------------------------------------------
            SqlCampos = SqlCampos & "," & "Flag_Flow"
            SqlCampos = SqlCampos & "," & "Estado_Radicado"
            SqlCampos = SqlCampos & " ) values "
            SqlDatos = SqlDatos & ",'" & "0" & "'"
            SqlDatos = SqlDatos & ",'" & "1" & "'"
            SqlDatos = SqlDatos & ")"
            Dim Parametro_Insercio As String = SqlCampos & SqlDatos
            Dim Parametro_Actualiza_System1 As String = ""
            If Estado_consecutivo_radicado_general = "YES" Then
                Parametro_Actualiza_System1 = "update system_plantilla_consecutivo_radicado set Consecutivo_Rad = " & "'" & ConseCRadicado & "' ," & _
                " Consecutivo_CodBarra = " & "'" & ConseCRadicado & "'"
            Else
                Parametro_Actualiza_System1 = "update system_plantilla_radicado set Consecutivo_Rad = " & "'" & ConseCRadicado & "' ," & _
                " Consecutivo_CodBarra = " & "'" & ConseCRadicado & "'" & " where id_Plantilla =" & _
                Codigo_Plantilla
            End If
            '------------------------------------------
            'actualiza control plantilla radicación
            '------------------------------------------
            myCommand.CommandText = Parametro_Actualiza_System1
            sqlresultinsert = myCommand.ExecuteNonQuery()
            If sqlresultinsert = 0 Then
                Registra_Radicado_plantilla_respuesta = "Imposible actualizar el consecutivo del radicación en la plantilla  "
                myConnection.Close()
                Exit Function
            End If
            '----------------------------------
            'Registra radicado respuesta
            '-----------------------------------
            myCommand.CommandText = Parametro_Insercio
            sqlresultinsert = myCommand.ExecuteNonQuery()
            If sqlresultinsert = 0 Then
                Registra_Radicado_plantilla_respuesta = "Imposible registrar el radicado en la plantilla  "
                myTrans.Rollback()
                myConnection.Close()
                Exit Function
            End If
            '---------------------------------------
            'Actualiza estado radicado respuesta
            '---------------------------------------
            Dim sqlupdate_actualiza_estado_respuesta As String = "Update ra_respuesta_radicado " & _
              " set RADICADO_RESPUESTA='" & ConsecutivoRadicadoString & "',ID_RUTA_WF=" & id_ruta & ",ID_TAREA_WF=" & id_tarea & _
              ",ID_TIPO_DOC_RESPUESTA=" & id_tipo_documento_respuesta & _
              ", DESTINATARIO='" & Destinatario_cor & "'" & _
              ", estado_respuesta='" & "4" & "'" & _
              "  where ID_RESPUESTA_RADICADO=" & id_registro_respuesta
            myCommand.CommandText = sqlupdate_actualiza_estado_respuesta
            sqlresultinsert = myCommand.ExecuteNonQuery()
            If sqlresultinsert = 0 Then
                Registra_Radicado_plantilla_respuesta = "Imposible actualizar radicado en la tabla respuesta radicado  "
                myTrans.Rollback()
                myConnection.Close()
                Exit Function
            End If
            codigo_radicado_consecutivo = ConsecutivoRadicadoString
            myTrans.Commit()
            myConnection.Close()
            Registra_Radicado_plantilla_respuesta = "YES"
        Catch e As Exception
            Try
                myTrans.Rollback()
            Catch ex As MySqlException
                If Not myTrans.Connection Is Nothing Then
                    Registra_Radicado_plantilla_respuesta = "An exception of type " + ex.GetType().ToString() + _
                                      " was encountered while attempting to roll back the transaction."
                    Exit Function
                End If
            End Try
            If Not myConnection Is Nothing Then
                myConnection.Close()
            End If
            Registra_Radicado_plantilla_respuesta = "Error General función Registra_Radicado_plantilla_respuesta" & e.Message
            Exit Function
        End Try
    End Function
