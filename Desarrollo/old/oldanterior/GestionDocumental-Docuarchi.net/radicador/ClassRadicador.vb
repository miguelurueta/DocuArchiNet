    Function DateAgregarLaborales(ByRef add As Object,
                                  ByRef FechaInicial As Object,
                                  ByRef fecha_salida As Object) As String
        Try

            If FechaInicial.DayOfWeek = DayOfWeek.Saturday Then
                FechaInicial = FechaInicial.AddDays(2)
            End If
            If FechaInicial.DayOfWeek = DayOfWeek.Sunday Then
                FechaInicial = FechaInicial.AddDays(1)
            End If
            Dim fechaini_ref = FechaInicial
            Dim dai() As Object
            Dim ic As Integer = 0
            '**********************************************
            'Lista fechas festivos
            '**********************************************
            Dim fechafin = FechaInicial
            fechafin.AddDays(add)
            Dim rago_feriados() As String
            Erase rago_feriados
            Dim Result As String = LibresEntre(FechaInicial,
                                               fechafin.AddDays(add),
                                               rago_feriados)
            If Result <> "YES" Then
                DateAgregarLaborales = Result
                Exit Function
            End If
            '**********************************************
            'Recorrre el rango de fechas
            '**********************************************
            Dim i As Integer = 0
            While i <= add
                Dim fech = fechaini_ref.AddDays(i)
                If fech.DayOfWeek = 6 Or fech.DayOfWeek = 0 Then
                    If fech.DayOfWeek = 6 Then
                        add = add + 1
                    End If
                    If fech.DayOfWeek = 0 Then
                        add = add + 1
                    End If


                Else
                    '**************************************
                    'Busca la fecha en el rango de feriados
                    '**************************************
                    If Not rago_feriados Is Nothing Then
                        Dim datempo As String = fech.date.ToString
                        Dim testigo As Integer = 0
                        Result = determina_dia_festivo(rago_feriados, datempo, testigo)
                        If Result <> "YES" Then
                            DateAgregarLaborales = Result
                            Exit Function
                        End If
                        If testigo = 0 Then
                            ReDim Preserve dai(ic)
                            dai(ic) = fech
                            'FechaInicial.AddDays(1)
                            ic = ic + 1
                        Else
                            add = add + 1
                        End If
                    Else
                        ReDim Preserve dai(ic)
                        dai(ic) = fech
                        'FechaInicial.AddDays(1)
                        ic = ic + 1
                    End If

                End If
                i = i + 1
            End While
            FechaInicial = dai(ic - 1)
            Dim ffff = FechaInicial.DayOfWeek
            If FechaInicial.DayOfWeek = 6 Then
                FechaInicial.AddDays(2)
            End If
            If FechaInicial.DayOfWeek = 0 Then
                FechaInicial.AddDays(1)
            End If
            fecha_salida = FechaInicial
            Dim testigo_final As Integer = 0
            Dim contador As Integer = 0
            Dim datempo_2 As String = FechaInicial.date.ToString
            While testigo_final = 0

                Dim testigo As Integer = 0
                Result = determina_dia_festivo(rago_feriados, datempo_2, testigo)
                If Result <> "YES" Then
                    DateAgregarLaborales = Result
                    Exit Function
                End If
                If testigo = 1 Then
                    FechaInicial.AddDays(1)
                    If FechaInicial.DayOfWeek = 6 Then
                        FechaInicial.AddDays(2)
                    End If
                    If FechaInicial.DayOfWeek = 0 Then
                        FechaInicial.AddDays(1)
                    End If
                    datempo_2 = FechaInicial.date.ToString
                Else
                    testigo_final = 1
                End If
                contador = contador + 1
            End While
            fecha_salida = FechaInicial.date
            DateAgregarLaborales = "YES"
        Catch ex As Exception
            DateAgregarLaborales = "Funcion DateAgregarLaborales " & ex.Message
        End Try
    End Function
    Function determina_dia_festivo(ByVal rago_feriados() As Object,
                                   ByRef datempo As Object,
                                   ByRef testigo As Integer) As String
        Try
            Dim refclas_gestion_fechas As New ClassGestionFechas
            Dim Result As String = refclas_gestion_fechas.formata_fecha_tipo_date(datempo)
            If Result <> "YES" Then
                determina_dia_festivo = Result
                Exit Function
            End If
            datempo = Left(datempo, 10)
            Dim spli() As String = datempo.Split("/")
            datempo = spli(2) & "/" & spli(1) & "/" & spli(0)
            testigo = 0
            For z As Integer = 0 To rago_feriados.Length - 1
                If rago_feriados(z) = datempo Then
                    testigo = 1
                    Exit For
                End If
            Next
            determina_dia_festivo = "YES"
        Catch ex As Exception
            determina_dia_festivo = "Inconsistencia funcion determina_dia_festivo " & ex.Message
        End Try
    End Function

