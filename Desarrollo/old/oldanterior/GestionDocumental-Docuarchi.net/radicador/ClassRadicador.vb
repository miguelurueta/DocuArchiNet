            Dim dateplantilla() As String = HttpContext.Current.Session("RA_DATO_VALIDACION").ToString.Split("|")
            If update Is Nothing Then
                Agregar_Nuevo_Registro_plantilla_validacion = "Imposible el control UpdatePanelContenido en la funcion Agregar_Nuevo_Registro_plantilla_validacion"
                Exit Function
            End If
            If hide Is Nothing Then
                Agregar_Nuevo_Registro_plantilla_validacion = "Imposible el control hdnEmailID en la funcion Agregar_Nuevo_Registro_plantilla_validacion"
                Exit Function
            End If
            Dim hidepais As Object = pag1.FindControl("Hiddenselecionpais")
            If hidepais Is Nothing Then
                Agregar_Nuevo_Registro_plantilla_validacion = "Imposible el control Hiddenselecionpais en la funcion Agregar_Nuevo_Registro_plantilla_validacion"
                Exit Function
            End If
            Dim hidepartamento As Object = pag1.FindControl("Hiddenseleciondepartamento")
            If hidepartamento Is Nothing Then
                Agregar_Nuevo_Registro_plantilla_validacion = "Imposible el control Hiddenselecionpais en la funcion Agregar_Nuevo_Registro_plantilla_validacion"
                Exit Function
            End If
            Dim hidemunicipio As Object = pag1.FindControl("Hiddenmunicipio")
            If hidemunicipio Is Nothing Then
                Agregar_Nuevo_Registro_plantilla_validacion = "Imposible el control hidemunicipio en la funcion Agregar_Nuevo_Registro_plantilla_validacion"
                Exit Function
            End If
            Dim data_grid As GridView = pag1.FindControl("data_grid")
            If data_grid Is Nothing Then
                Agregar_Nuevo_Registro_plantilla_validacion = "Imposible el control data_grid en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If

            Dim Result As String = ""
            Dim Matri_Datos() As CAMPOS_PLANTILLA_VALIDACION
            Erase Matri_Datos
            Dim campo_idex As String = ""
            '****************************************************
            'Lista campos plantilla validacion
            '****************************************************
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Lista_Campos_Plantilla_Validacion(dateplantilla(2), Matri_Datos)
            If Result <> "YES" Then
                Agregar_Nuevo_Registro_plantilla_validacion = Result
                Exit Function
            End If
            '*****************************************************
            'Busca campo identi en la mtriz campos
            '*****************************************************
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).IDENTI_CAMPO = 1 Then
                    campo_idex = Matri_Datos(i).Nombre_Campo
                End If
            Next
            If campo_idex = "" Then
                Agregar_Nuevo_Registro_plantilla_validacion = "La plantilla carece de campo identi por favor agregelo en el modulo administracion"
                Exit Function
            End If
            '***************************************************
            'Retorna nombre plantilla validacion
            '***************************************************
            Dim nombre_plantillas As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(dateplantilla(2),
                                                                                    nombre_plantillas)
            If Result <> "YES" Then
                Agregar_Nuevo_Registro_plantilla_validacion = Result
                Exit Function
            End If
            '-----------------------------------------------------
            'Asigna datos a los campos de la palntilla con el id
            '-----------------------------------------------------
            'Result = Asigna_Datos_Matri_Validacion(nombre_plantillas, Matri_Datos, hide.Value)
            'If Result <> "YES" Then
            '    Agregar_Nuevo_Registro_plantilla_validacion = Result
            '    Exit Function
            'End If
            '--------------------------------------------------------
            'Asignacion a los campos de formulario
            '--------------------------------------------------------
            Dim estado_ubicacion As Integer = -1
            For i As Integer = 0 To Matri_Datos.Length - 1
                '----------------------------------------------------------
                'Asignacion de de datos de la intrface a la matriz
                '---------------------------------------------------------
                If Matri_Datos(i).Nombre_Campo = "Pais" Or Matri_Datos(i).Nombre_Campo = "Municipio" _
                               Or Matri_Datos(i).Nombre_Campo = "Departemento" Then
                    Select Case Matri_Datos(i).Nombre_Campo
                        Case "Pais"
                            Dim ob As Object = pag1.FindControl("" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidepais.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If
                        Case "Departemento"
                            Dim ob As Object = pag1.FindControl("" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidepartamento.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If

                        Case "Municipio"
                            Dim ob As Object = pag1.FindControl("" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidemunicipio.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If

                    End Select

                Else
                    Dim ob As Object = pag1.FindControl("" & Matri_Datos(i).Nombre_Campo)
                    If Not ob Is Nothing Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = ob.text
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida los formatos fecha
            '---------------------------------------------------------------------------------
            Dim ClassGestionFechas As New ClassGestionFechas
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then
                    If Matri_Datos(i).Tipo_Campo = "DATE" And Matri_Datos(i).TEXTO_CAMPO_MODIFICADO <> "" Then
                        Result = ClassGestionFechas.Verifi_campo_fecha(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                        If Result <> "YES" Then
                            Agregar_Nuevo_Registro_plantilla_validacion = "El formato fecha no cumple " & Result
                            Exit Function
                        End If
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida campos obligatorios vacios
            '---------------------------------------------------------------------------------
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).Obligatorio_Campo = 1 Then
                    If Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "" Then
                        Dim ob As Object = pag1.FindControl("" & Matri_Datos(i).Nombre_Campo)
                        If Not ob Is Nothing Then
                            ob.focus()
                        End If
                        Agregar_Nuevo_Registro_plantilla_validacion = "El campo " & Matri_Datos(i).Nombre_Campo & " es obligatorio"
                        Exit Function

                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida campos ubicacion 
            '---------------------------------------------------------------------------------
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).Obligatorio_Campo = 1 Then
                    If Matri_Datos(i).Nombre_Campo = "Pais" Or Matri_Datos(i).Nombre_Campo = "Municipio" _
                       Or Matri_Datos(i).Nombre_Campo = "Departemento" Then
                        If Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "" Or Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "SELECCIONE" Then
                            Dim ob As Object = pag1.FindControl("" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.focus()
                            End If
                            Agregar_Nuevo_Registro_plantilla_validacion = "El campo " & Matri_Datos(i).Nombre_Campo & " es obligatorio"
                            Exit Function

                        End If
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Verifica existencia de los campos unicos
            '---------------------------------------------------------------------------------

            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then

                    If Matri_Datos(i).Unico_campo = 1 Then
                        Dim sql As String = "Select " & Matri_Datos(i).Nombre_Campo & " from " & nombre_plantillas & _
                            " where " & Matri_Datos(i).Nombre_Campo & "='" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                        Result = Class_plantilla_validacion.Verifica_Existencia_Campos_Unico_Validacion(sql, Matri_Datos(i).Nombre_Campo,
                                                                                                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO,
                                                                                                        Matri_Datos(i).Aleas_Campo_pqr)
                        If Result <> "YES" Then
                            Agregar_Nuevo_Registro_plantilla_validacion = Result
                            Exit Function
                        End If
                    End If

                End If
            Next
            '-------------------------------------------------------------
            'Actualiza los campos de letra capital, upercase o towupercase
            '-------------------------------------------------------------
            Dim clas_trd_documental As New ClassTrdDocumental
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).TEXTO_CAMPO_MODIFICADO <> "" Then
                    If Matri_Datos(i).valida_capital_text = 1 Then
                        clas_trd_documental.Formato_sub_serie(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO, _
                                                              Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                    If Matri_Datos(i).valida_capital_text = 2 Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = UCase(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                    If Matri_Datos(i).valida_capital_text = 3 Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = LCase(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                End If
            Next
            '---------------------------------------------------------------------------- -----
            'Genera comnando de insertcion
            '---------------------------------------------------------------------------------
            Dim sqlactualizacion As String = "INSERT INTO " & nombre_plantillas & " "
            Dim sqlcampos As String = ""
            Dim sqlvalores As String = ""
            '---------------------------------------------------------------------------------
            'Lista campos de insertcion
            '---------------------------------------------------------------------------------
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then

                    If sqlcampos = "" Then
                        sqlcampos = sqlcampos & "(" & Matri_Datos(i).Nombre_Campo
                    Else
                        sqlcampos = sqlcampos & " , " & Matri_Datos(i).Nombre_Campo
                    End If

                    If sqlvalores = "" Then
                        sqlvalores = sqlvalores & "(" & "'" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                    Else
                        sqlvalores = sqlvalores & " , " & "'" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                    End If
                End If
            Next
            sqlvalores = sqlvalores & ")"
            sqlcampos = sqlcampos & ")"
            sqlactualizacion = sqlactualizacion & sqlcampos & " values " & sqlvalores
            Dim lastinsert As Object = Nothing
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Result = Ref_Car_Conec.SELECTION_LAST_INSERT_COMMAND(sqlactualizacion, lastinsert)
            If Result <> "YES" Then
                Agregar_Nuevo_Registro_plantilla_validacion = Result
                Exit Function
            End If
            hide.value = lastinsert
            '------------------------------------------------------------
            'Actualiza data gred con los nuevos datos consultando
            '------------------------------------------------------------
            Result = Genera_Consulta_Validacion_Post_Agregar_Registro(pag1, lastinsert, campo_idex, nombre_plantillas, Matri_Datos)
            If Result <> "YES" Then
                Agregar_Nuevo_Registro_plantilla_validacion = Result
                Exit Function
            End If
            Agregar_Nuevo_Registro_plantilla_validacion = "YES"
        Catch ex As Exception
            Agregar_Nuevo_Registro_plantilla_validacion = "Inconsistencia funcion Agregar_Nuevo_Registro_plantilla_validacion " & ex.Message
        End Try
    End Function
    Function Verifica_Permisos_usuario_plantilla_validacion(ByVal id_script As Integer, _
                                                            ByVal nombre_plantilla As String, _
                                                            Optional ByVal identifica_existencia As Integer = 1) As String
        '********************************************************************
        'Funcion retorna los permisos de usuario sobre la plantilla
        'de validacion externa y setea los permisos
        'Fecha : 2014-08-07
        'Ingeniero : Miguel Angel Urueta Miranda
        '********************************************************************
        Try

            '---------------------------------------------------------------
            'Retorna id plantilla validacion
            '---------------------------------------------------------------
            HttpContext.Current.Session.Item("RA_VALIDACION_AGREGAR") = "0"
            HttpContext.Current.Session.Item("RA_VALIDACION_ELIMINAR") = "0"
            HttpContext.Current.Session.Item("RA_VALIDACION_EDITAR") = "0"
            Dim id_plantilla_validacion As Integer = -1
            Dim Result As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_id_plantilla_validacion_nombre(nombre_plantilla,
                                                                                       id_plantilla_validacion)
            If Result <> "YES" Then
                Verifica_Permisos_usuario_plantilla_validacion = Result
                Exit Function
            End If
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "select agregar,eliminar,editar from ra_relacion_usuario_plantilla_validacion " & _
            " where usuario_radicador_Id_usuario=" & HttpContext.Current.Session.Item("RA_ID_USUARIO") & " and plantilla_validacion_id_plantilla_validacion=" & id_plantilla_validacion
            Dim Dat_reader As New DataSet
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Dat_reader)
            If Result <> "YES" Then
                Verifica_Permisos_usuario_plantilla_validacion = " Error verificando permisos usuario plantilla validación  " & Result
                Exit Function
            End If
            If Dat_reader.Tables(0).Rows.Count = 0 Then
                If identifica_existencia = 1 Then
                    Verifica_Permisos_usuario_plantilla_validacion = "Imposible encontrar permisos plantilla validación"
                    Exit Function
                Else
                    Verifica_Permisos_usuario_plantilla_validacion = "YES"
                    Exit Function
                End If

            Else
                HttpContext.Current.Session.Item("RA_VALIDACION_AGREGAR") = Dat_reader.Tables(0).Rows(0).Item(0).ToString
                HttpContext.Current.Session.Item("RA_VALIDACION_ELIMINAR") = Dat_reader.Tables(0).Rows(0).Item(1).ToString
                HttpContext.Current.Session.Item("RA_VALIDACION_EDITAR") = Dat_reader.Tables(0).Rows(0).Item(2).ToString
                Verifica_Permisos_usuario_plantilla_validacion = "YES"
                Exit Function
            End If
        Catch ex As Exception
            Verifica_Permisos_usuario_plantilla_validacion = "Inconsistencia funcion Verifica_Permisos_usuario_plantilla_validacion " & ex.Message
        End Try
    End Function
    Function Verifca_Existencia_Relacion_pla_validacion_pla_radicacion(ByVal id_plantilla_validacion As Integer, _
                                                                       ByVal id_registro_plantilla_validacion As Integer) As String
        '**************************************************************************************
        'Funcion : Verifica la existencia de radicados relacinados con registro de plantilla
        'validacion
        'Fecha : 2014-08-04
        'Ingeniero : Miguel Angel Urueta Miranda
        '**************************************************************************************
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "select id_relacion from ra_relacion_pla_validacion_pla_radicacion " & _
            " where id_plantilla_validacion=" & id_plantilla_validacion & " and id_registro_plantilla_validacion=" & _
            id_registro_plantilla_validacion & " LIMIT 1"
            Dim Dat_reader As New DataSet
            Dim Result As String = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Dat_reader)
            If Result <> "YES" Then
                Verifca_Existencia_Relacion_pla_validacion_pla_radicacion = " Error verificando relacion plantillas radicacion validacion   " & Result
                Exit Function
            End If
            If Dat_reader.Tables(0).Rows.Count = 0 Then
                Verifca_Existencia_Relacion_pla_validacion_pla_radicacion = "YES"
                Exit Function
            Else
                Verifca_Existencia_Relacion_pla_validacion_pla_radicacion = "El registro " & id_registro_plantilla_validacion & " esta relacionado con radicados imposible eliminar"
                Exit Function
            End If

        Catch ex As Exception
            Verifca_Existencia_Relacion_pla_validacion_pla_radicacion = "Inconsistencia funcion Verifca_Existencia_Relacion_pla_validacion_pla_radicacion " & ex.Message
        End Try

    End Function


    Function Eliminar_Registro_Plantilla_Validacion(ByVal pag1 As Page) As String
        Try
            Dim clasjava As New Classscrripjava
            Dim updateboton As UpdatePanel = pag1.FindControl("UpdatePanelbotones")
            Dim hiderepuesta As Object = pag1.FindControl("Hiddenrespuesta")
            If updateboton Is Nothing Then
                Eliminar_Registro_Plantilla_Validacion = "Imposible encontrar valor seleccionado UpdatePanelbotones "
                Exit Function
            End If
            'Hiddenrespuesta
            'Dim resultado As String = clasjava.ShowScripmanRespuesta("Desea eliinar", updateboton, "Hiddenrespuesta")
            Dim hide As Object = pag1.FindControl("hdnEmailID")
            If hide.value = "-1" Then
                Eliminar_Registro_Plantilla_Validacion = "Imposible encontrar valor seleccionado hdnEmailID "
                Exit Function
            End If
            If hide Is Nothing Then
                Eliminar_Registro_Plantilla_Validacion = "Imposible el control hdnEmailID en la funcion Agregar_Nuevo_Registro_plantilla_validacion"
                Exit Function
            End If
            Dim dateplantilla() As String = HttpContext.Current.Session("RA_DATO_VALIDACION").ToString.Split("|")
            If dateplantilla.Length <2 Then
                Eliminar_Registro_Plantilla_Validacion="El sistema no pudo encontrar el nombre de la plantilla en la variable RA_DATO_VALIDACION"
                Exit Function
            End If
            Dim dat_gred As GridView = pag1.FindControl("data_grid")
            If dat_gred Is Nothing Then
                Eliminar_Registro_Plantilla_Validacion = "Imposible el control data_grid en la funcion Agregar_Nuevo_Registro_plantilla_validacion"
                Exit Function
            End If
            Dim Result As String = ""
            '---------------------------------------------------------------
            'Verifica la existencia de guias relacionadas con destinatarios externos
            '---------------------------------------------------------------
            Dim refclasenvio As New ClassRaEnvioCorrespondencia
            Dim estado_existencia As String = "YES"
            Result = refclasenvio.Verifica_existencia_destina_ext_guia(Val(hide.value), estado_existencia)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            If estado_existencia = "YES" Then
                Eliminar_Registro_Plantilla_Validacion = "El destinatario externo tiene quias de envio registradas, no se puede eliminar"
                Exit Function
            End If
            '---------------------------------------------
            'Consulta el id de la plantilla de validacion
            '---------------------------------------------
            Dim nombre_plantilla As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(dateplantilla(2),
                                                                                    nombre_plantilla)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            Dim id_plantilla_validacion As Integer = -1
            Result = Class_plantilla_validacion.Retorna_id_plantilla_validacion_nombre(nombre_plantilla,
                                                                                      id_plantilla_validacion)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            '---------------------------------------------
            'Verifica la existencia de registros
            '---------------------------------------------
            Dim plantilla_radic() As String = Nothing
            Result = Me.Retorna_plantillas_relacionadas_script(Val(dateplantilla(2)), plantilla_radic)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            Dim Resultado As String = ""
            Result = Me.Retorna_registros_relacion_validacion_plantillas(plantilla_radic, _
                                                                         Resultado, Val(hide.value))
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            Dim plantillas_valid As String = ""
            If Not plantilla_radic Is Nothing Then
                For i As Integer = 0 To plantilla_radic.Length - 1
                    plantillas_valid = plantillas_valid & plantilla_radic(i) & ","
                Next
            End If
            If Resultado = "YES" Then
                Eliminar_Registro_Plantilla_Validacion = "Imposible eliminar el registro, existen valores relacionados en las plantillas de validación " & plantillas_valid
                Exit Function
            End If
            '-----------------------------------------------------
            'Retorna nombre campo primary key
            '-----------------------------------------------------
            Dim nombre_campo_key As String = ""
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Retorna_Campo_Primary_key_plantilla_validacion(id_plantilla_validacion,
                                                                                                      nombre_campo_key)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            '----------------------------------------------------
            'Verfica relacion plantilla validacion vs radicacion
            '----------------------------------------------------
            Result = Verifca_Existencia_Relacion_pla_validacion_pla_radicacion(id_plantilla_validacion, hide.value)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            '-----------------------------------------------------
            'Elimina registro plantilla
            '-----------------------------------------------------
            Dim sql As String = "delete from " & nombre_plantilla & " where " & nombre_campo_key & "='" & hide.value & "'"
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Result = Ref_Car_Conec.SELECTION_INSERT_COMMAND(sql)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            hide.value = "-1"
            '------------------------------------------------------------
            'Actualiza data gred con los nuevos datos consultando
            '------------------------------------------------------------
            Result = Genera_consulta_validacion_post(pag1)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion = Result
                Exit Function
            End If
            Eliminar_Registro_Plantilla_Validacion = "YES"
        Catch ex As Exception
            Eliminar_Registro_Plantilla_Validacion = "Inconsistencia función Eliminar_Registro_Plantilla_Validacion " & ex.Message
        End Try
    End Function
    Function Eliminar_Registro_Plantilla_Validacion_edicion(ByVal pag1 As Page, _
                                                            ByVal id_script As Integer) As String
        Dim Hidden_resultado_eliminar As Object = pag1.FindControl("Hidden_resultado_eliminar")
        Try
            Dim clasjava As New Classscrripjava
            Hidden_resultado_eliminar.value = "-1"
            Dim hide As Object = pag1.FindControl("hdnEmailID_VAL")
            If hide Is Nothing Then
                Eliminar_Registro_Plantilla_Validacion_edicion = "Imposible el control hdnEmailID en la funcion Agregar_Nuevo_Registro_plantilla_validacion"
                Exit Function
            End If
            If hide.value = "-1" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = "Imposible encontrar valor seleccionado hdnEmailID "
                Exit Function
            End If

            Dim Result As String = ""
            '---------------------------------------------------------------
            'Verifica la existencia de guias relacionadas con destinatarios externos
            '---------------------------------------------------------------
            Dim refclasenvio As New ClassRaEnvioCorrespondencia
            Dim estado_existencia As String = "YES"
            Result = refclasenvio.Verifica_existencia_destina_ext_guia(Val(hide.value),
                                                                       estado_existencia)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = Result
                Exit Function
            End If
            If estado_existencia = "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = "El destinatario externo tiene quías de envío registradas, no se puede eliminar"
                Exit Function
            End If
            '---------------------------------------------
            'Verifica la existencia de registros
            '---------------------------------------------
            Dim plantilla_radic() As String = Nothing
            Result = Me.Retorna_plantillas_relacionadas_script(id_script, plantilla_radic)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = Result
                Exit Function
            End If
            Dim Resultado As String = ""
            Result = Me.Retorna_registros_relacion_validacion_plantillas(plantilla_radic, Resultado, Val(hide.value))
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = Result
                Exit Function
            End If
            Dim plantillas_valid As String = ""
            If Not plantilla_radic Is Nothing Then
                For i As Integer = 0 To plantilla_radic.Length - 1
                    plantillas_valid = plantillas_valid & plantilla_radic(i) & ","
                Next
            End If
            If Resultado = "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = "Imposible eliminar el registro, existen valores relacionados en las plantillas de validación " & plantillas_valid
                Exit Function
            End If
            '---------------------------------------------
            'Consulta el id de la plantilla de validacion
            '---------------------------------------------
            Dim nombre_plantilla As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(id_script,
                                                                                    nombre_plantilla)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = Result
                Exit Function
            End If
            Dim id_plantilla_validacion As Integer = -1
            Result = Class_plantilla_validacion.Retorna_id_plantilla_validacion_nombre(nombre_plantilla,
                                                                                       id_plantilla_validacion)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = Result
                Exit Function
            End If
            '-----------------------------------------------------
            'Retorna nombre campo primary key
            '-----------------------------------------------------
            Dim nombre_campo_key As String = ""
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Retorna_Campo_Primary_key_plantilla_validacion(id_plantilla_validacion,
                                                                                                      nombre_campo_key)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = Result
                Exit Function
            End If
            '----------------------------------------------------
            'Verfica relacion plantilla validacion vs radicacion
            '----------------------------------------------------
            Result = Verifca_Existencia_Relacion_pla_validacion_pla_radicacion(id_plantilla_validacion, hide.value)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = Result
                Exit Function
            End If
            '-----------------------------------------------------
            'Elimina registro plantilla
            '-----------------------------------------------------
            Dim sql As String = "delete from " & nombre_plantilla & " where " & nombre_campo_key & "='" & hide.value & "'"
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Result = Ref_Car_Conec.SELECTION_INSERT_COMMAND(sql)
            If Result <> "YES" Then
                Eliminar_Registro_Plantilla_Validacion_edicion = Result
                Hidden_resultado_eliminar.value = "-1"
                Exit Function
            End If
            Hidden_resultado_eliminar.value = "1"
            Eliminar_Registro_Plantilla_Validacion_edicion = "YES"
        Catch ex As Exception
            Eliminar_Registro_Plantilla_Validacion_edicion = "Inconsistencia función Eliminar_Registro_Plantilla_Validacion_edicion " & ex.Message
            Hidden_resultado_eliminar = "-1"
        End Try
    End Function
