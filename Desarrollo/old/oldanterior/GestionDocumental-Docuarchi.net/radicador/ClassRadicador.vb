            For x As Integer = 0 To spli.Length - 1
                Dim textigo As Integer = -1
                If droup.Items.Count > 0 Then
                    For i As Integer = 0 To droup.Items.Count - 1
                        If droup.Items(i).Text = spli(x).ToString Then
                            textigo = 1
                            Exit For
                        End If
                    Next
                    If textigo = -1 Then
                        droup.Items.Add(spli(x).ToString)
                    End If
                Else
                    droup.Items.Add(spli(x).ToString)
                End If
            Next

            If optio.Checked = False Then
                optio.Checked = True
                chek_anexo_radicado.Checked = False
                chek_nuevo_radicado.Checked = False

            End If
            uptade.Update()
            Asigna_valores_seleccionados_gridview_vieestate = "YES"
        Catch ex As Exception
            Asigna_valores_seleccionados_gridview_vieestate = "Inconsistencia general funcion Asigna_valores_seleccionados_gridview_vieestate " & ex.Message
        End Try
    End Function
    Function Asigna_valores_seleccionados_gridview(ByVal grid As GridView, ByRef droup As DropDownList, _
        ByRef uptade As UpdatePanel, ByVal remplaza As Integer, ByVal optio As CheckBox) As String
        '*************************************************************************************
        'Funcion : Asigna los valores seleccionado en en los chekbox del data gredview
        'Fecha : 2014-08-29
        'Ingeniero Miguel Angel Urueta Miranda
        '*************************************************************************************
        Try
            Dim chek_anexo_radicado As CheckBox = grid.Page.FindControl("Check_anexo_radicado")
            If chek_anexo_radicado Is Nothing Then
                Asigna_valores_seleccionados_gridview = "Imposible encontrar el control Check_anexo_radicado"
                Exit Function
            End If
            Dim chek_nuevo_radicado As CheckBox = grid.Page.FindControl("check_nuevo_radicado")
            If chek_nuevo_radicado Is Nothing Then
                Asigna_valores_seleccionados_gridview = "Imposible encontrar el control chek_nuevo_radicado"
                Exit Function
            End If
            Dim checkedProd As List(Of String) = (From item In grid.Rows.Cast(Of GridViewRow)() Let check = DirectCast(item.FindControl("chkSelection"), CheckBox) Where check.Checked Select Convert.ToString(grid.DataKeys(item.RowIndex).Value)).ToList()

            Dim productsIdSel As List(Of String) = TryCast(HttpContext.Current.Session("ProdSelection"), List(Of String))

            If productsIdSel Is Nothing Then
                productsIdSel = New List(Of String)()
            End If
            productsIdSel = (From item In productsIdSel Group Join item2 In grid.Rows.Cast(Of GridViewRow)() _
                             On item Equals Convert.ToString(grid.DataKeys(item2.RowIndex).Value) _
                            Into g = Group Where Not g.Any() Select item).ToList()
            productsIdSel.AddRange(checkedProd)
            If productsIdSel.Count = 0 Then
                Asigna_valores_seleccionados_gridview = "Debe chekear en la lista el radicado a relacionar"
                Exit Function
            End If
            If remplaza = 0 Then
                droup.Items.Clear()
            End If
            Dim x As String
            For Each x In productsIdSel
                Dim textigo As Integer = -1
                If droup.Items.Count > 0 Then
                    For i As Integer = 0 To droup.Items.Count - 1
                        If droup.Items(i).Text = x.ToString Then
                            textigo = 1
                            Exit For
                        End If
                    Next
                    If textigo = -1 Then
                        droup.Items.Add(x.ToString)
                    End If
                Else
                    droup.Items.Add(x.ToString)
                End If
            Next
            If optio.Checked = False Then
                optio.Checked = True
                chek_anexo_radicado.Checked = False
                chek_nuevo_radicado.Checked = False

            End If
            uptade.Update()
            Asigna_valores_seleccionados_gridview = "YES"
        Catch ex As Exception
            Asigna_valores_seleccionados_gridview = "Inconsistencia general funcion Asigna_valores_seleccionados_gridview " & ex.Message
        End Try
    End Function
    Public Shared Sub RestoreSelection(grid As GridView, ByRef res As String)
        Try
            res = "YES"
            Dim productsIdSel As List(Of String) = TryCast(HttpContext.Current.Session("ProdSelection"), List(Of String))

            If productsIdSel Is Nothing Then
                Return
            End If

            '
            ' se comparan los registros de la pagina del grid con los recuperados de la Session
            ' los coincidentes se devuelven para ser seleccionados
            '
            Dim result As List(Of GridViewRow) = (From item In grid.Rows.Cast(Of GridViewRow)() Group Join item2 In productsIdSel On _
                              Convert.ToString(grid.DataKeys(item.RowIndex).Value) _
                              Equals item2 Into g = Group Where g.Any() Select item).ToList()

            '
            ' se recorre cada item para marcarlo
            '
            Dim x As Object
            'result.ForEach(x >= (DirectCast(x.FindControl("chkSelection"), CheckBox).Checked = True))
            'result.ForEach(Function(x) InlineAssignHelper(DirectCast(x.FindControl("chkSelection"), CheckBox).Checked, True))
            For Each x In result
                x.findcontrol("chkSelection").Checked = True
            Next
        Catch ex As Exception
            res = ex.Message
        End Try

    End Sub

    
    Function Solicta_Correo_Electronico_remitente_por_radicado(ByVal id_remit_dext_interno As Integer, _
                                                               ByRef correo_electronico As String, _
                                                               ByVal codigo_plantilla_radicado As Integer) As String
        '*****************************************************************
        'Funcion : Retorna campo plantilla radicacion
        'correo electronico
        'Fecha : 2016-03-15
        'Ing : Miguel Angel Urueta Miranda
        '*****************************************************************
        Try
            Dim Result As String = ""
            Dim nombre_plantilla As String = ""
            Dim ref_Class_ra_script_actividades As New Class_ra_script_actividades
            Dim matri() As validacion_plantilla
            Erase matri
            Result = ref_Class_ra_script_actividades.lista_campos_Validacion_plantilla(codigo_plantilla_radicado, _
                                                                                        matri)
            If Result <> "YES" Then
                Solicta_Correo_Electronico_remitente_por_radicado = Result
                Exit Function
            End If
            Dim Estado_opcion_fecha As Integer = 0
            Dim Estado_opcion_cita_respuesta As Integer = 0
            Dim Estado_opcion_radicado_general As Integer = 0
            Dim Estado_opcion_valida_externo As Integer = 0
            Dim Matri_Datos() As Campos_Plantilla = Nothing
            '---------------------------------------
            '------Lista opciones plantilla
            '---------------------------------------
            Dim ref_Class_system_plantilla_radicado As New Class_system_plantilla_radicado
            Result = ref_Class_system_plantilla_radicado.Lista_Opcion_Plantilla_Radicacion(codigo_plantilla_radicado, _
                                                                                            Estado_opcion_fecha, _
                                                                                            Estado_opcion_cita_respuesta, _
                                                                                            Estado_opcion_radicado_general, _
                                                                                            Estado_opcion_valida_externo)
            If Result <> "YES" Then
                Solicta_Correo_Electronico_remitente_por_radicado = Result
                Exit Function
            End If
            Dim ref_Class_ra_detalle_plantilla_radicado As New Class_ra_detalle_plantilla_radicado
            Erase Matri_Datos
            Result = ref_Class_ra_detalle_plantilla_radicado.Lista_Campos_Adicionales_Plantilla(codigo_plantilla_radicado, _
                                                                                                Matri_Datos, _
                                                                                                Estado_opcion_fecha, _
                                                                                                Estado_opcion_cita_respuesta, _
                                                                                                Estado_opcion_radicado_general)
            If Result <> "YES" Then
                Solicta_Correo_Electronico_remitente_por_radicado = Result
                Exit Function
            End If
            If Not matri Is Nothing Then
                For i2 As Integer = 0 To matri.Length - 1
                    For i3 As Integer = 0 To Matri_Datos.Length - 1
                        If Matri_Datos(i3).Campo_Plantilla = matri(i2).Campo_Plantilla Then
                            Matri_Datos(i3).TIPO_SCRIPT = matri(i2).TIPO_SCRIPT
                            Matri_Datos(i3).COMBINACION_TECLA = matri(i2).COMBINACION_TECLA
                            Matri_Datos(i3).VALOR_SCRIPT = matri(i2).VALOR_SCRIPT
                            Matri_Datos(i3).ESTADO_ESCRIPT = matri(i2).ESTADO_ESCRIPT
                            Matri_Datos(i3).PLATAFORMA_SCRIPT = matri(i2).PLATAFORMA_SCRIPT
                            Matri_Datos(i3).ID_SCRIPT = matri(i2).ID_SCRIPT

                        End If
                    Next
                Next
            End If
            Dim Tipo_script As String = ""
            Dim id_escript As Integer = -1
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Tipo_Validacion_Campo(Matri_Datos,
                                                                              "REMITENTE_COR",
                                                                              Tipo_script,
                                                                              id_escript)
            If Result <> "YES" Then
                Solicta_Correo_Electronico_remitente_por_radicado = Result
                Exit Function
            End If
            Dim nombre_plantilla_validacion As String = ""
            Dim id_plantilla_validacion As Integer = 0
            Result = Retorna_Nombre_id_Plantilla_Validacion(id_escript, _
                                                            nombre_plantilla_validacion, _
                                                            id_plantilla_validacion)
            If Result <> "YES" Then
                Solicta_Correo_Electronico_remitente_por_radicado = Result
                Exit Function
            End If
            Dim stru_campos_vald() As CAMPOS_PLANTILLA_VALIDACION = Nothing
            Dim refclasvalidacion As New Classvalidacion
            Result = refclasvalidacion.Lista_Campos_Plantilla_Validacion(id_escript,
                                                                         stru_campos_vald)
            If Result <> "YES" Then
                Solicta_Correo_Electronico_remitente_por_radicado = Result
                Exit Function
            End If
            Dim campo_correo As String = "NO"
            If stru_campos_vald Is Nothing Then
                Solicta_Correo_Electronico_remitente_por_radicado = "YES"
                Exit Function
            Else
                For z As Integer = 0 To stru_campos_vald.Length - 1
                    If stru_campos_vald(z).Nombre_Campo = "CORREO_ELECTRONICO" Then
                        campo_correo = "YES"
                        Exit For
                    End If
                Next
            End If
            If campo_correo = "YES" Then
                Result = Retorna_correo_remitente(nombre_plantilla_validacion, "CORREO_ELECTRONICO", id_remit_dext_interno, correo_electronico)
                If Result <> "YES" Then
                    Solicta_Correo_Electronico_remitente_por_radicado = Result
                    Exit Function
                End If
            End If
            Solicta_Correo_Electronico_remitente_por_radicado = "YES"
            Exit Function
        Catch ex As Exception
            Solicta_Correo_Electronico_remitente_por_radicado = "Inconsistencia función Solicta_Correo_Electronico_remitente_por_radicado " & ex.Message
        End Try
    End Function
    Function Retorna_Nombre_id_Plantilla_Validacion(ByVal Id_dcript As Integer, _
    ByRef Nombre_Plantilla As String, ByRef id_plantilla As Integer) As String
        '*****************************************************************
        'Funcion : Retorna nombre plantilla validacion con el id de la
        'plantilla
        'Fecha : 2014-07-28
        'Ing : Miguel Angel Urueta Miranda
        '*****************************************************************
        Try
            Dim Result As String = ""
            Dim Parametro_Consulta As String = "SELECT pv.Nombre_Plantilla,pv.Id_Plantilla_Validacion FROM relacion_script_plantilla as rsp INNER JOIN PLANTILLA_VALIDACION as pv on " & _
            " (pv.Id_Plantilla_Validacion=rsp.Plantilla_Validacion_Id_Plantilla_Validacion) where rsp.script_actividades_id_script=" & Id_dcript
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Datset As DataSet = New DataSet("relacion_script_plantilla")
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Datset)
            If Result <> "YES" Then
                Retorna_Nombre_id_Plantilla_Validacion = Result
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count = 0 Then
                Retorna_Nombre_id_Plantilla_Validacion = "Imposible econtrar el nombre de la plantilla validación"
                Exit Function
            Else
                Nombre_Plantilla = Datset.Tables(0).Rows(0).Item(0)
                id_plantilla = Datset.Tables(0).Rows(0).Item(1)
                Retorna_Nombre_id_Plantilla_Validacion = "YES"
                Exit Function
            End If

        Catch ex As Exception
            Retorna_Nombre_id_Plantilla_Validacion = "Inconsistencia general funcion Retorna_Nombre_Plantilla_Validacion " & ex.Message
        End Try
    End Function
    Function Retorna_correo_remitente(ByVal nombre_plantilla As String, ByVal nombre_campo As String, _
    ByVal id_remit_dest_interno As Integer, ByRef resultado_correo As String) As String
        '*****************************************************************
        'Funcion : Retorna campo plantilla radicacion
        '
        'Fecha : 2016-03-15
        'Ing : Miguel Angel Urueta Miranda
        '*****************************************************************
        Try
            Dim Parametro_Consulta As String = "SELECT " & nombre_campo & " FROM " & nombre_plantilla & _
            " where id_dest_Ext=" & id_remit_dest_interno
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Datset As DataSet = New DataSet("relacion_script_plantilla")
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Datset)
            If Result <> "YES" Then
                Retorna_correo_remitente = Result
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count = 0 Then
                Retorna_correo_remitente = "Imposible econtrar el codigo del destinatario externo " & id_remit_dest_interno & " en la plantilla validación, es posible se halla eliminado de la plantilla"
                Exit Function
            Else
                If Datset.Tables(0).Rows(0).IsNull(0) = True Then
                    resultado_correo = ""
                Else
                    resultado_correo = Datset.Tables(0).Rows(0).Item(0)
                End If
                Retorna_correo_remitente = "YES"
                Exit Function
            End If

        Catch ex As Exception
            Retorna_correo_remitente = "Inconsistencia general funcion Retorna_correo_remitente " & ex.Message
        End Try
    End Function

