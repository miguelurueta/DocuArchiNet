    Function Retorna_fecha_vence_radicado(ByVal radicado As String, ByVal nombre_plantilla As String, _
                                              ByRef fecha_limite_respuesta As String) As String
        '**************************************************************
        'Función : retorna fecha vence radicado seleccionado por
        'el numero de radicado y la plantilla radicado
        'Feecha 2015-05-19
        'Ingemiero : Miguel Angel Urueta Miranda
        '**************************************************************
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "select FECHALIMITERESPUESTA from " & nombre_plantilla & " where Consecutivo_Rad='" & radicado & "'"
            Dim Datset As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Datset)
            If Result <> "YES" Then
                Retorna_fecha_vence_radicado = "Función retorna_tipo_documental_radicado dice " & Result
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count = 0 Then
                Retorna_fecha_vence_radicado = "Función retorna_tipo_documental_radicado dice imposible encontrar tipo clase documento o tramite"
                Exit Function
            Else
                If Datset.Tables(0).Rows(0).IsNull(0) = False Then
                    fecha_limite_respuesta = Left(Datset.Tables(0).Rows(0).Item(0), 10)
                    Dim plit() As String = fecha_limite_respuesta.Split("/")
                    fecha_limite_respuesta = plit(2) & "-" & plit(1) & "-" & plit(0)
                    Retorna_fecha_vence_radicado = "YES"
                    Exit Function
                Else
                    fecha_limite_respuesta = ""
                    Retorna_fecha_vence_radicado = "YES"
                    Exit Function
                End If       
               
            End If
        Catch ex As Exception
            Retorna_fecha_vence_radicado = "Función retorna_fecha_vence_radicado dice " & ex.Message
        End Try
    End Function
    
