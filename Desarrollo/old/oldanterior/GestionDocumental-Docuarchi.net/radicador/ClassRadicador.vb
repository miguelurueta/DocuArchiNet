    Public Function KeepSelection(ByVal grid As GridView) As String
        Try
            '
            ' se obtienen los id de producto checkeados de la pagina actual
            '
            Dim checkedProd As List(Of String) = (From item In grid.Rows.Cast(Of GridViewRow)() Let check = DirectCast(item.FindControl("chkSelection"), CheckBox) Where check.Checked Select Convert.ToString(grid.DataKeys(item.RowIndex).Value)).ToList()

            '
            ' se recupera de session la lista de seleccionados previamente
            '
            Dim productsIdSel As List(Of String) = TryCast(HttpContext.Current.Session("ProdSelection"), List(Of String))

            If productsIdSel Is Nothing Then
                productsIdSel = New List(Of String)()
            End If

            '
            ' se cruzan todos los registros de la pagina actual del gridview con la lista de seleccionados,
            ' si algun item de esa pagina fue marcado previamente no se devuelve
            '
            'productsIdSel = (From item In productsIdSel Join item2 In grid.Rows.Cast(Of GridViewRow)() On item equals Convert.ToInt32(grid.DataKeys(item2.RowIndex).Value) into g Where Not g.Any()item).ToList()

            '
            ' se agregan los seleccionados
            '
            productsIdSel = (From item In productsIdSel Group Join item2 In grid.Rows.Cast(Of GridViewRow)() _
                             On item Equals Convert.ToString(grid.DataKeys(item2.RowIndex).Value) _
                            Into g = Group Where Not g.Any() Select item).ToList()
            productsIdSel.AddRange(checkedProd)

            HttpContext.Current.Session("ProdSelection") = productsIdSel
            KeepSelection = "YES"
        Catch ex As Exception
            KeepSelection = "Inconsistencia fucnion KeepSelection " & ex.Message
        End Try
    End Function
