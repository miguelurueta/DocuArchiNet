                    Matri_Datos(i3).TEXTO_CAMPO = ob.text
                    Matri_Datos(i3).ID_CAMPO_ASPNET = ob.id
                End If
                If Matri_Datos(i3).Campo_Plantilla = "Descripcion_Documento" Then
                    Dim ob1 As Object = Page1.FindControl("Hiddentramiteseleccion")
                    If Not ob1 Is Nothing Then
                        Descripcion_documento = ob1.value
                        Matri_Datos(i3).TEXTO_CAMPO = ob1.value
                        Matri_Datos(i3).Alias_Campo = "Descripcion tramite documento"

