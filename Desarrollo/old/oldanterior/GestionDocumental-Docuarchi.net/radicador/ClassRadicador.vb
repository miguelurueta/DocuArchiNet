                                '************************
                                'fill codigo barras
                                '************************
                                If _Plantilla_Impresion(i).Campo_Plantilla = "Consecutivo_CodBarra" Then
                                    Ceros_Fill(DatSet.Tables(0).Rows(0).Item(_Plantilla_Impresion(i).Campo_Plantilla).ToString, Tempo_Val)
                                    _Plantilla_Impresion(i).Valor_Campo = _
                                _Plantilla_Impresion(i).Campo_Plantilla & "=" & Tempo_Val
                                Else
                                    _Plantilla_Impresion(i).Valor_Campo = _
                                _Plantilla_Impresion(i).Campo_Plantilla & "=" & DatSet.Tables(0).Rows(0).Item(_Plantilla_Impresion(i).Campo_Plantilla).ToString
                                End If

                            End If
                        Else
                            If Tipo_Radicacion = "RADICACION GUIA" Then
                                _Plantilla_Impresion(i).Valor_Campo = DatSet.Tables(0).Rows(0).Item(_Plantilla_Impresion(i).Campo_Plantilla).ToString & _
                                " user-" & Matri_Datos_Radicado(2) & " PT-" & LCase(Nombre_Plantilla)
