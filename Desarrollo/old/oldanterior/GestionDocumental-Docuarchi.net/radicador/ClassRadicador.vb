    Function Solicita_autorizacion_dias_hora_de_radicacion(ByVal id_tipo_radicacion As Integer, _
                                                           ByVal id_plantilla As Integer, _
                                                           ByRef estado_autorizacion As String) As String
        Try
            Dim Result As String = ""
            Dim Refclas_system_plantilla_Radicado As New Class_system_plantilla_radicado
            Dim stru_opciones_permisos As stru_opciones_tiempo_autorizacion
            '-------------------------------------------
            'Solicita opciones de tiempos de radicación
            '-------------------------------------------
            Result = Refclas_system_plantilla_Radicado.Solicita_opciones_tiempos_radicacion(id_plantilla, _
                                                                                            stru_opciones_permisos)
            If Result <> "YES" Then
                Solicita_autorizacion_dias_hora_de_radicacion = Result
                Exit Function
            End If
            '---------------------------------------------------------------------
            'Valida solicitud de autorizacion dia hora radicado  radicado general
            '---------------------------------------------------------------------
            If id_tipo_radicacion = 1 And stru_opciones_permisos.util_evalua_periodo_general = 0 Then
                estado_autorizacion = "YES"
                Solicita_autorizacion_dias_hora_de_radicacion = "YES"
                Exit Function
            End If
            '----------------------------------------------------------------------
            'Valida solicitud de autorizacion dia hora radicado  radicado pqrs web
            '----------------------------------------------------------------------
            If id_tipo_radicacion = 2 And stru_opciones_permisos.utill_evalua_periodo_pqr = 0 Then
                estado_autorizacion = "YES"
                Solicita_autorizacion_dias_hora_de_radicacion = "YES"
                Exit Function
            End If
            '----------------------------------------------------------------------
            'Valida solicitud de autorizacion dia hora radicado  radicado interno
            '----------------------------------------------------------------------
            If id_tipo_radicacion = 3 And stru_opciones_permisos.util_evalua_periodo_interno = 0 Then
                estado_autorizacion = "YES"
                Solicita_autorizacion_dias_hora_de_radicacion = "YES"
                Exit Function
            End If
            '----------------------------------
            'Verifica existencia dia no festivo
            '----------------------------------
            Dim Estado_confirmacion As String = ""
            Dim Descripcion_dia_festivo As String = ""
            Dim Refclass_feriados As New ClassRea_001_feriados
            Dim Fecha_actual As String = Trim(CStr(Now.ToString("yyyy'-'MM'-'dd")))
            If stru_opciones_permisos.util_evalua_festivo = 1 Then
                Result = Refclass_feriados.Solicita_confirmacion_dia_feriado("COLOMBIA", _
                                                                             Fecha_actual, _
                                                                             Estado_confirmacion, _
                                                                             Descripcion_dia_festivo)
                If Result <> "YES" Then
                    Solicita_autorizacion_dias_hora_de_radicacion = Result
                    Exit Function
                End If
                '----------------------------------------------------
                'Confirma día festivo no autorizado para radicación
                '----------------------------------------------------
                If Estado_confirmacion = "YES" Then
                    estado_autorizacion = "Día festivo en COLOMBIA " & Descripcion_dia_festivo & " No hábil para radicar "
                    Solicita_autorizacion_dias_hora_de_radicacion = "YES"
                    Exit Function
                End If
            End If
            Dim dat_time As DateTime = Now
            Dim nuemero_dia As Integer = 0
            Dim estado_autorizacion_dia_habil As Integer = 0
            nuemero_dia = dat_time.DayOfWeek
            Dim nombre_dia As String = ""
            Dim Refclas_ra_per_dias_radicacion As New ClassRa_per_dias_radicacion
            Result = Refclas_ra_per_dias_radicacion.Solicita_estado_autorizacion_dia_habil(nuemero_dia, _
                                                                                           id_plantilla, _
                                                                                            estado_autorizacion_dia_habil, _
                                                                                            nombre_dia)
            If Result <> "YES" Then
                Solicita_autorizacion_dias_hora_de_radicacion = Result
                Exit Function
            End If
            If estado_autorizacion_dia_habil = 0 Then
                estado_autorizacion = "Día  " & nombre_dia & " No autorizado para radicar "
                Solicita_autorizacion_dias_hora_de_radicacion = "YES"
                Exit Function
            End If
            Dim identificacion_dia As Integer = 0
            Result = Refclas_ra_per_dias_radicacion.Solicita_identificacion_dia_habil(nuemero_dia, _
                                                                                      id_plantilla, _
                                                                                      identificacion_dia)
            If Result <> "YES" Then
                Solicita_autorizacion_dias_hora_de_radicacion = Result
                Exit Function
            End If
            Dim Refclas_per_horas_dias_radicacion As New ClassRe_Per_Horas_Dia_Radicacion
            Dim stru_rango_hora() As stru_rangos_horas = Nothing
            Result = Refclas_per_horas_dias_radicacion.Solicita_estructura_rangos_horas_dia(identificacion_dia, _
                                                                                            stru_rango_hora)
            If Result <> "YES" Then
                Solicita_autorizacion_dias_hora_de_radicacion = Result
                Exit Function
            End If
            '---------------------------
            'Valida ragos horas hábiles
            '---------------------------
            If stru_rango_hora Is Nothing Then
                estado_autorizacion = "YES"
                Solicita_autorizacion_dias_hora_de_radicacion = "YES"
                Exit Function
            End If
            Dim date_t As DateTime = Now
            Dim hora As Object = date_t.ToString("HH:mm:ss")
            '-------------------------------------------------
            'Evalua rangos de horas habiles de radicación
            '-------------------------------------------------
            For i As Integer = 0 To stru_rango_hora.Length - 1
                If Val(hora) >= Val(stru_rango_hora(i).Hora_inicio) And Val(hora) <= Val(stru_rango_hora(i).Hora_final) Then
                    estado_autorizacion = "YES"
                    Solicita_autorizacion_dias_hora_de_radicacion = "YES"
                    Exit Function
                End If
            Next
            estado_autorizacion = "La hora actual " & hora & " no esta habilitada para radicar"
            Solicita_autorizacion_dias_hora_de_radicacion = "YES"
            Exit Function
        Catch ex As Exception
            Solicita_autorizacion_dias_hora_de_radicacion = "Inconsistencia general función Solicita_autorizacion_dias_hora_de_radicacion " & ex.Message
        End Try
    End Function
    Function Lista_dias_horas_habiles_radicacion(ByVal id_plantilla As Integer, _
                                                  ByRef treeview As TreeView, _
                                                  ByRef up_panel As UpdatePanel) As String
        Try
            treeview.Nodes.Clear()
            Dim Stru_dia() As stru_dias = Nothing
            Dim Result As String
            Dim Refclas_per_dias_radicacion As New ClassRa_per_dias_radicacion
            Result = Refclas_per_dias_radicacion.Solicita_estructura_dias_plantilla(id_plantilla, Stru_dia)
            If Result <> "YES" Then
                Lista_dias_horas_habiles_radicacion = Result
                Exit Function
            End If
            If Stru_dia Is Nothing Then
                Lista_dias_horas_habiles_radicacion = "No hay un esquema de autorización de dias y horas hábiles para mostrar"
                Exit Function
            End If
            Dim stru_rango_hora() As stru_rangos_horas = Nothing
            For i As Integer = 0 To Stru_dia.Length - 1
                Dim trenod As New TreeNode
                Dim habil As String = ""
                If Stru_dia(i).Estado_Habil = 1 Then
                    habil = " (Hábil)"
                Else
                    habil = " (Inhábil)"
                End If
                trenod.Value = Stru_dia(i).id_per_dias_radicacion
                trenod.Text = Stru_dia(i).Nombre_dia & habil
                Dim Refclas_ra_per_horas_dia_radicacion As New ClassRe_Per_Horas_Dia_Radicacion
                Result = Refclas_ra_per_horas_dia_radicacion.Solicita_estructura_rangos_horas_dia(Stru_dia(i).id_per_dias_radicacion, _
                                                               stru_rango_hora)
                If Result <> "YES" Then
                    Lista_dias_horas_habiles_radicacion = Result
                    Exit Function
                End If
                If Not stru_rango_hora Is Nothing Then
                    For i2 As Integer = 0 To stru_rango_hora.Length - 1
                        Dim trenodes As New TreeNode
                        trenodes.Value = stru_rango_hora(i2).id_per_horas
                        trenodes.Text = stru_rango_hora(i2).Hora_inicio & " - " & stru_rango_hora(i2).Hora_final
                        trenod.ChildNodes.Add(trenodes)
                    Next

                End If
                treeview.Nodes.Add(trenod)
            Next
            treeview.ExpandAll()
            Lista_dias_horas_habiles_radicacion = "YES"
        Catch ex As Exception
            Lista_dias_horas_habiles_radicacion = "Inconsistencia general función Lista_dias_horas_habiles_radicacion " & ex.Message
        Finally
            up_panel.Update()
        End Try
    End Function

End Class
