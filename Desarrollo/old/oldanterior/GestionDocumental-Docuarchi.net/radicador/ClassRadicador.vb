    Function Lista_Nombre_Entidad(ByRef _Plantilla_Impresion() As String, ByVal p As Integer) As String
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim datset As New DataSet
            Dim Parametro_Consulta As String = "select * from Empresa_Radicacion_correspondencia"
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, datset)
            If Result <> "YES" Then
                Lista_Nombre_Entidad = " Error consultando entidad radicadora   " & Result
                Return Lista_Nombre_Entidad
                Exit Function
            End If
            If datset.Tables(0).Rows.Count = 0 Then
                Lista_Nombre_Entidad = "Imposible encontrar entidad radicadora"
                Exit Function
            Else
                For i As Integer = 0 To datset.Tables(0).Columns.Count - 1
                    ReDim Preserve _Plantilla_Impresion(i)
                    _Plantilla_Impresion(i) = datset.Tables(0).Rows(0).Item(i)
                Next

                Lista_Nombre_Entidad = "YES"
                Exit Function
            End If
            Lista_Nombre_Entidad = "YES"
        Catch ex As Exception
            Lista_Nombre_Entidad = ex.Message
        End Try
    End Function
