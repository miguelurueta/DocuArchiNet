            id_usuario_workflow = Val(Hidden_id_user_wf.value)
            Dim id_grupo_usuario_workflow As Integer = 0
            '----Solicita id grupo usuario workflow
            Result = Class_usuario_workflow.Solicita_id_grupo_usuario_workflow(id_usuario_workflow,
                                                                               id_grupo_usuario_workflow)
            If Result <> "YES" Then
                Registra_Radicacion_entrante_interna = Result
