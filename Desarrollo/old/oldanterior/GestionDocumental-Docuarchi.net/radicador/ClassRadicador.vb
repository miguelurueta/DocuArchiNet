    Function Genera_Archivo_Impresion(ByVal archivo As String, _
                                      ByVal plantilla() As Plantilla_Impresion) As String
        
        Try
            If File.Exists(archivo) = True Then
                File.Delete(archivo)
            End If
            Dim doc As iTextSharp.text.Document
            Dim writer As iTextSharp.text.pdf.PdfWriter
            Dim archivo_pdf As String = archivo
            doc = New iTextSharp.text.Document(New iTextSharp.text.Rectangle(283.0F, 283.0F))
            doc.SetMargins(20, 0, 1, 1)
            writer = iTextSharp.text.pdf.PdfWriter.GetInstance(doc, _
                                New FileStream(archivo_pdf, FileMode.Create))
            doc.Open()
            For i As Integer = 0 To plantilla.Length - 1
                If plantilla(i).Estado_Campo = 1 Then
                    Dim _standardFont As iTextSharp.text.Font = New iTextSharp.text.Font(iTextSharp.text.Font.NORMAL, _
                    plantilla(i).Tamano_Letra, iTextSharp.text.Font.NORMAL, iTextSharp.text.BaseColor.BLACK)
                    Dim paragraf As New iTextSharp.text.Paragraph
                    paragraf.Leading = 0
                    paragraf.SpacingBefore = -10
                    paragraf.SpacingAfter = -10
                    paragraf = New iTextSharp.text.Paragraph(plantilla(i).Campo_Plantilla & ":" & UCase(plantilla(i).Valor_Campo), _standardFont)
                    paragraf.Alignment = iTextSharp.text.Element.ALIGN_MIDDLE
                    doc.Add(paragraf)
                End If
            Next
            doc.Close()
            writer.Close()
            Genera_Archivo_Impresion = "YES"
        Catch ex As Exception
            Genera_Archivo_Impresion = ex.Message
        Finally

        End Try
    End Function
