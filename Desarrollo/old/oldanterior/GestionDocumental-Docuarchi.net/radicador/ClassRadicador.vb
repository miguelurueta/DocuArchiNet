    Public Function Ceros_Fill(ByVal Numero_Doc As String, ByRef Doc_Carpet As String) As String
        Try
            Select Case Len(Numero_Doc.ToString)
                Case "1"
                    Doc_Carpet = "00000000" & Numero_Doc
                Case "2"
                    Doc_Carpet = "0000000" & Numero_Doc
                Case "3"
                    Doc_Carpet = "000000" & Numero_Doc
                Case "4"
                    Doc_Carpet = "00000" & Numero_Doc
                Case "5"
                    Doc_Carpet = "0000" & Numero_Doc
                Case "6"
                    Doc_Carpet = "000" & Numero_Doc
                Case "7"
                    Doc_Carpet = "00" & Numero_Doc
                Case "8"
                    Doc_Carpet = "0" & Numero_Doc
                Case "9"
                    Doc_Carpet = "" & Numero_Doc
            End Select
            Ceros_Fill = "YES"
        Catch ex As Exception
            Ceros_Fill = "Error General Funcion Ceros_Doc_Carpeta" & ex.ToString
        End Try
    End Function
    
