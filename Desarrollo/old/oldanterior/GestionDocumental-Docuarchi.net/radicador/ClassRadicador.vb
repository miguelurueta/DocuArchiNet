            End If
            Registra_radicado_pqr = "YES"
            Exit Function
        Catch e As Exception
            Try
                myTrans.Rollback()
            Catch ex As MySqlException
                If Not myTrans.Connection Is Nothing Then
                    Registra_radicado_pqr = "An exception of type " + ex.GetType().ToString() +
                                      " was encountered while attempting to roll back the transaction."
                    Exit Function
                End If
            End Try
            If Not myConnection Is Nothing Then
                myConnection.Close()
            End If
            Registra_radicado_pqr = "Error General " & e.Message
            Exit Function
        End Try
    End Function
    Function Retorna_feha_vencimiento_tramite(ByVal tramite As String,
                                              ByVal id_plantilla_radicado As String,
                                              ByRef fecha_liminte As String) As String
        Try
            Dim numero_dias As Integer = 0
            Dim ob As Object = Nothing
            Dim Result As String = Me.Retorna_Dias_Vencimiento_tramite(id_plantilla_radicado,
                                                                       tramite,
                                                                       numero_dias)
            If Result <> "YES" Then
                Retorna_feha_vencimiento_tramite = Result
                Exit Function
            End If

            Result = Me.DateAgregarLaborales(numero_dias,
                                             Date.Now,
                                             ob)
            If Result <> "YES" Then
                Retorna_feha_vencimiento_tramite = Result
                Exit Function
            Else
                Dim feha As String = ob
                Dim refclas_gestion_fechas As New ClassGestionFechas
                Result = refclas_gestion_fechas.formata_fecha_tipo_date(feha)
                If Result <> "YES" Then
                    Retorna_feha_vencimiento_tramite = Result
                    Exit Function
                Else
                    feha = Left(feha, 10)
                    fecha_liminte = feha.Replace("/", "-")
                End If
                Retorna_feha_vencimiento_tramite = "YES"
            End If
        Catch ex As Exception
            Retorna_feha_vencimiento_tramite = "Inconsistencia general función Retorna_feha_vencimiento_tramite " & ex.Message
        End Try
    End Function

