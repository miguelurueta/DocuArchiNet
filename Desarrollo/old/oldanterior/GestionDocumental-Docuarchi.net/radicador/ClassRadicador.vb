                                End If
                            Case "Remitente_Cor" & "|" & "Destinatario_Cor" & "|" & "VARCHAR"
                                If Objet.text = "" Then
                                    Registra_Radicacion_Guia = "Debe digitar o seleccionar el campo remitente"
                                    Objet.focus()
                                    Exit Function
                                Else
                                    Nombre_Remitente = Objet.text
                                End If

                            Case "Destinatario_Cor" & "|" & "Remitente_Cor" & "|" & "VARCHAR"
                                If Objet.text = "" Then
                                    Registra_Radicacion_Guia = "Debe digitar o seleccionar el campo destinatario"
                                    Objet.focus()
                                    Exit Function
                                Else
                                    Nombre_Destinatario = Objet.text
                                End If
                            Case "DIRECIONDESTINATARIO" & "|" & "Direccion_Dest" & "|" & "VARCHAR"
                                If Objet.text = "" Then
                                    Registra_Radicacion_Guia = "Debe digitar o seleccionar el campo diereccion destinatario"
                                    Objet.focus()
                                    Exit Function
                                Else
                                    Direccion_Dest = Objet.text
                                End If
                            Case "MUNICIPIO|MUNICIPIO" & "|" & "VARCHAR"
                                If Objet.text = "" Then
                                    Registra_Radicacion_Guia = "Debe digitar o seleccionar el campo municipio destinatario"
                                    Objet.focus()
                                    Exit Function
                                Else
                                    Municipio_Dest = Objet.text
                                End If

                            Case "TELEFONO" & "|" & "Telefono_Dest" & "|" & "VARCHAR"
                                If Objet.text = "" Then
                                    Telefono_Dest = ""
                                Else
                                    Telefono_Dest = Objet.text
                                End If

                            Case "Numero_Folios" & "|" & "Numero_Folios" & "|" & "VARCHAR"
                                If Objet.text = "" Then
                                    Registra_Radicacion_Guia = "Debe digitar el numero de folios "
                                    Objet.focus()
                                    Exit Function
                                End If
                            Case "Fecha_Documento" & "|" & "Fecha_Documento" & "|" & "DATE"
                                If Objet.text = "" Then
                                    Registra_Radicacion_Guia = "Debe digitar la fecha del documento "
                                    Objet.focus()
                                    Exit Function
                                End If

                        End Select

                    End If
                Next
            Next
        Next
        '****************************
        'Identifica campos vacios 
        'variables de radicacion
        '****************************
        Dim Result As String = ""
        Dim ref_Class_ra_detalle_plantilla_radicado As New Class_ra_detalle_plantilla_radicado
        Dim Matri_Datos() As Campos_Plantilla
        Erase Matri_Datos
        Result = ref_Class_ra_detalle_plantilla_radicado.Lista_Campos_Adicionales_Plantilla(Codigo_Plantilla, _
                                                                                            Matri_Datos)
        If Result <> "YES" Then
            Registra_Radicacion_Guia = Result
            Exit Function
        End If

        If Not Matri_Datos Is Nothing Then
            'For Each Objet In _RefPnel.Controls
            'If Objet.GetType().Name = "TextBox" Or Objet.GetType().Name = "ComboBox" Then
            For iz As Integer = 0 To UBound(Matri_Datos)
                Objet = Nothing
                Objet = pag.FindControl(Matri_Datos(iz).Campo_Plantilla & "|" & _
                 Matri_Datos(iz).Campo_Plantilla & "|" & Matri_Datos(iz).Tipo_Campo)
                If Not Objet Is Nothing Then
                    If Objet.GetType().Name = "TextBox" Or Objet.GetType().Name = "DropDownList" Then
                        If Matri_Datos(iz).Campo_Obligatorio = 1 And Objet.text = "" Then
                            Registra_Radicacion_Guia = "Debe digitar " & Matri_Datos(iz).Alias_Campo
                            Objet.focus()
                            Exit Function
                        End If
                    End If

                End If
            Next

            'End If
            'Next
        End If
        '*******************************
        'Verifica la existencia del 
        'destinatario  Nombre_Remitente
        '*******************************
        Dim Confirmacion As String = ""
        Dim Codigo_Remitente As Integer = -1
        Result = ""
        Dim Ref_Class_destinatario_externo As New Class_destinatario_externo
        Result = Ref_Class_destinatario_externo.verifica_existencia_destinatario_externo(Nombre_Remitente, _
                                                                                         Codigo_Remitente, _
                                                                                         "", _
                                                                                         "")
        If Result <> "YES" Then
            Registra_Radicacion_Guia = Result
            Exit Function
        End If

        '**********************************
        'Obtiene id del dest interno
        '**********************************
        Dim Ref_Class_remit_dest_interno As New Class_remit_dest_interno
        Result = ""
        Dim Codigo_Dest As String = ""
        Result = Ref_Class_remit_dest_interno.Retorna_Id_Destinatario(Nombre_Destinatario, _
                                                                      Codigo_Dest)
        If Result <> "YES" Then
            Registra_Radicacion_Guia = Result
            Exit Function
        End If
        If Codigo_Dest = "" Then
            Registra_Radicacion_Guia = "Imposible encontrar codigo remitente "
            Exit Function
        End If
        '****************************
        'Obtiene el nombre de la pla
        'ntilla de radicacion
        '****************************
        Dim Nombre_Plantilla As String = ""
        Result = ""
        Dim Ref_Clas_sytem_plantilla As New Class_system_plantilla_radicado
        Result = Ref_Clas_sytem_plantilla.Solicita_nombre_plantilla_radicado(Codigo_Plantilla, _
                                                                             Nombre_Plantilla)
        If Result <> "YES" Then
            Registra_Radicacion_Guia = Result
            Exit Function
        End If
        '******************************
        'Contruye datos de radicacion
        '******************************
        Dim SqlCampos As String = ""
        SqlCampos = "INSERT INTO " & Nombre_Plantilla & " ( Remit_Dest_Interno_id_Remit_Dest_Int," & _
        "Destinatario_Externo_id_Dest_Ext,Usuario_Radicador_id_usuario,System_Plantilla_Radicado_id_Plantilla," & _
        "Consecutivo_Rad,Consecutivo_CodBarra,Fecha_Radicado"
        For i As Integer = 0 To _RefPnel.Rows.Count - 1
            For i2 As Integer = 0 To _RefPnel.Rows(i).Cells.Count - 1
                For i3 As Integer = 0 To _RefPnel.Rows(i).Cells(i2).Controls.Count - 1
                    Objet = _RefPnel.Rows(i).Cells(i2).Controls(i3)
                    If Objet.GetType().Name = "TextBox" Or Objet.GetType().Name = "DropDownList" Then
                        Dim splicampo() As String = Objet.id.ToString.Split("|")
                        If splicampo.Length > 1 Then
                            SqlCampos = SqlCampos & "," & splicampo(1)
                        End If

                    End If
                Next
            Next
        Next
        Dim SqlDatos As String = "( '" & Codigo_Dest & "','" & Codigo_Remitente & "','" & HttpContext.Current.Session("RA_ID_USUARIO") & "','" & _
        Codigo_Plantilla & "'"
        '****************************
        'Busca fecha radicacion
        '****************************
        Dim refclasalmacen As New ClassAlmacenamiento
        Dim date1al As String = Date.Now
        Result = ""
        Dim refclas_gestion_fechas As New ClassGestionFechas
        Result = refclas_gestion_fechas.Formatea_Fecha_Almacenamiento_Time(date1al)
        If Result <> "YES" Then
            Registra_Radicacion_Guia = "Imposible formatear fecha " & Result
            Exit Function
        End If
        '---------------------------------------
        'Implementa consecutivo radicado general
        '---------------------------------------
        Dim Ref_Class_system_plantilla_consecutivo_radicado As New Class_system_plantilla_consecutivo_radicado
        Dim Estado_consecutivo_radicado_general As String = ""
        Result = Ref_Class_system_plantilla_consecutivo_radicado.Solicita_estado_registro_consecutivo_radicado(Estado_consecutivo_radicado_general)
        If Result <> "YES" Then
            Registra_Radicacion_Guia = Result
            Exit Function
        End If
        '---------------------------------------
        'Asigna sql consecutivo radicado
        '---------------------------------------
        Dim Parametro_Select_System1 As String = ""
        If Estado_consecutivo_radicado_general = "YES" Then
            Parametro_Select_System1 = " SELECT Consecutivo_Rad,Consecutivo_CodBarra FROM system_plantilla_consecutivo_radicado  for update"
        Else
            Parametro_Select_System1 = " SELECT Consecutivo_Rad,Consecutivo_CodBarra FROM system_plantilla_Radicado " & _
            " where id_plantilla=" & Codigo_Plantilla & " for update"
        End If
        '----------------------------------------------------------
        'Implemetar función Inicializa consecutivo radicado anual
        '----------------------------------------------------------
        If Estado_consecutivo_radicado_general = "YES" Then
            Result = Ref_Class_system_plantilla_consecutivo_radicado.Inicializa_consecutivo_radicado_anual()
            If Result <> "YES" Then
                Registra_Radicacion_Guia = Result
                Exit Function
            End If
        End If
        Dim myConnection As New MySqlConnection
        Dim ref As New conect.Dbase_Conction_Mysql_RA
        ref.Returna_Conexion_Mysql(myConnection)
        Dim myTrans As MySqlTransaction
        Dim mySqldatReader As MySqlDataReader
        Try
            Dim myCommand As MySqlCommand = myConnection.CreateCommand()
            myTrans = myConnection.BeginTransaction()
            myCommand.Connection = myConnection
            myCommand.Transaction = myTrans
            myCommand.CommandText = Parametro_Select_System1
            mySqldatReader = myCommand.ExecuteReader()
            If mySqldatReader Is Nothing Then
                Registra_Radicacion_Guia = "Imposible Encontrar Registro En Tabla Systema Error Conexion"
                myTrans.Rollback()
                myConnection.Close()
                Exit Function
            End If
            If mySqldatReader.HasRows = False Then
                Registra_Radicacion_Guia = "Imposible Encontrar Registro En Tabla Systema"
                myTrans.Rollback()
                myConnection.Close()
                Exit Function
            End If
            '********************************************************
            'Valores recuperados de la consulta de la tabla system1
            '********************************************************
            mySqldatReader.Read()
            ConseCRadicado = mySqldatReader.Item(0)
            ConseCCodbarra = mySqldatReader.Item(1)
            ConseCRadicado = ConseCRadicado + 1
            ConseCCodbarra = ConseCCodbarra + 1
            SqlDatos = SqlDatos & ",'" & ConseCRadicado & "'"
            SqlDatos = SqlDatos & ",'" & ConseCCodbarra & "'"
            SqlDatos = SqlDatos & ",'" & date1al & "'"
            mySqldatReader.Close()
            For i As Integer = 0 To _RefPnel.Rows.Count - 1
                For i2 As Integer = 0 To _RefPnel.Rows(i).Cells.Count - 1
                    For i3 As Integer = 0 To _RefPnel.Rows(i).Cells(i2).Controls.Count - 1
                        Objet = _RefPnel.Rows(i).Cells(i2).Controls(i3)
                        If Objet.GetType().Name = "TextBox" Or Objet.GetType().Name = "DropDownList" Then
                            SqlDatos = SqlDatos & ",'" & Objet.text & "'"
                        End If
                    Next
                Next
            Next
            SqlCampos = SqlCampos & "," & "Flag_Flow"
            SqlCampos = SqlCampos & "," & "Estado_Radicado"
            SqlCampos = SqlCampos & " ) values "
            SqlDatos = SqlDatos & ",'" & "0" & "'"
            SqlDatos = SqlDatos & ",'" & "1" & "'"
            SqlDatos = SqlDatos & ")"
            Dim Parametro_Insercio As String = SqlCampos & SqlDatos
            Dim Parametro_Actualiza_System1 As String = ""
            If Estado_consecutivo_radicado_general = "YES" Then
                Parametro_Actualiza_System1 = "update system_plantilla_consecutivo_radicado set Consecutivo_Rad = " & "'" & ConseCRadicado & "' ," & _
                " Consecutivo_CodBarra = " & "'" & ConseCRadicado & "'"
            Else
                Parametro_Actualiza_System1 = "update system_plantilla_radicado set Consecutivo_Rad = " & "'" & ConseCRadicado & "' ," & _
                " Consecutivo_CodBarra = " & "'" & ConseCRadicado & "'" & " where id_Plantilla =" & _
                Codigo_Plantilla
            End If
            myCommand.CommandText = Parametro_Actualiza_System1
            myCommand.ExecuteNonQuery()
            myCommand.CommandText = Parametro_Insercio
            myCommand.ExecuteNonQuery()
            myTrans.Commit()
            myConnection.Close()
            For i As Integer = 0 To _RefPnel.Rows.Count - 1
                For i2 As Integer = 0 To _RefPnel.Rows(i).Cells.Count - 1
                    For i3 As Integer = 0 To _RefPnel.Rows(i).Cells(i2).Controls.Count - 1
                        Objet = _RefPnel.Rows(i).Cells(i2).Controls(i3)
                        If Objet.GetType().Name = "TextBox" Or Objet.GetType().Name = "DropDownList,,,," Then
                            Objet.text = ""
                        End If
                    Next
                Next
            Next
        Catch e As Exception
            Try
                myTrans.Rollback()
            Catch ex As MySqlException
                If Not myTrans.Connection Is Nothing Then
                    Registra_Radicacion_Guia = "An exception of type " + ex.GetType().ToString() + _
                                      " was encountered while attempting to roll back the transaction."
                    Exit Function
                End If
            End Try
            If Not myConnection Is Nothing Then
                myConnection.Close()
            End If
            Registra_Radicacion_Guia = "Error General " & e.Message
            Exit Function
        End Try
        Consecutivo_Impresion = Codigo_Dest & "¬" & Codigo_Remitente & "¬" & HttpContext.Current.Session("RA_ID_USUARIO") & "¬" & _
        Codigo_Plantilla & "¬" & ConseCRadicado & "¬" & ConseCCodbarra & _
        "¬" & date1al
        Datoradicacion.value = Consecutivo_Impresion
        Registra_Radicacion_Guia = "YES"

    End Function




