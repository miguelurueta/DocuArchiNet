            Agregar_Calendar = "YES"
        Catch ex As Exception
            Agregar_Calendar = "Funcion clalendar inconsistencia " & ex.Message
        End Try
    End Function
    Function Inicializa_interface_gestion_plantilla_validacion(ByRef pag As Page) As String
        Try
            Dim result As String = ""
            Dim refclas As New ClassRadicador
            Dim refclas_consulta As New ClassRaConsultaRadicados
            Dim rescrip As New Classscrripjava
            Dim inter As String = HttpContext.Current.Session.Item("SESIONITERCAMBIOPLANTILLAVALIDACION")
            Dim Hiddenselecionpais As Object = pag.FindControl("Hiddenselecionpais_EDIT")
            Dim Hiddenseleciondepartamento As Object = pag.FindControl("Hiddenseleciondepartamento_EDIT")
            Dim Hiddenmunicipio As Object = pag.FindControl("Hiddenmunicipio_EDIT")
            Dim UpdatePanel_edita_campos_dinamicos As UpdatePanel = pag.FindControl("UpdatePanel_edita_campos_dinamicos")
            result = Me.Genera_Interface_Gestion_Plantilla_edicion_plantilla_validacion(pag, _
                                                                                        HttpContext.Current.Session.Item("SESIONITERCAMBIOPLANTILLAVALIDACION"))
            If result <> "YES" Then
                Inicializa_interface_gestion_plantilla_validacion = result
                Exit Function
            Else
                Dim estado_ubicacion As Integer = 0
                result = refclas.Retorna_Estado_Ubicacion_Plantilla_Validacion(HttpContext.Current.Session.Item("SESIONITERCAMBIOPLANTILLAVALIDACION"), _
                                                                               estado_ubicacion)
                If result <> "YES" Then
                    Inicializa_interface_gestion_plantilla_validacion = result
                    Exit Function
                End If
                If estado_ubicacion = 1 Then
                    Dim controles As String = ""
                    Dim droplista As DropDownList = pag.FindControl("EDIT_PAIS")
                    If droplista Is Nothing Then
                        Inicializa_interface_gestion_plantilla_validacion = "Imposible encontrar el control PAIS"
                        Exit Function
                    End If
                    'droplista.Items.Clear()
                    Dim ilist As New ListItem
                    ilist.Text = "SELECCIONE"
                    ilist.Value = "SELECCIONE"
                    droplista.Items.Add(ilist)
                    ilist = New ListItem
                    ilist.Text = "COLOMBIA"
                    ilist.Value = "COLOMBIA"
                    droplista.Items.Add(ilist)
                    If Hiddenselecionpais.Value <> "SELECCIONE" And Hiddenselecionpais.Value <> "" Then
                        Hiddenselecionpais.Value = "COLOMBIA"
                        droplista.SelectedIndex = 1

                    End If
                    '------------------------------------------------
                    'Lista los departamentos en el evento postback
                    'y conserva el elemento seleccionado
                    '-----------------------------------------------
                    Dim droplistadepartamento As DropDownList = pag.FindControl("EDIT_DEPARTEMENTO")
                    If droplistadepartamento Is Nothing Then
                        Inicializa_interface_gestion_plantilla_validacion = "Imposible encontrar el control DEPARTEMENTO"
                        Exit Function

                    End If
                    If Hiddenselecionpais.Value <> "SELECCIONE" And Hiddenselecionpais.Value <> "" Then
                        Dim Refclasra As New ClassRaConsultaRadicados
                        Dim Resulta As String = ""
                        Resulta = Refclasra.Lista_Departamentos_Paises(droplistadepartamento, _
                                                                       Hiddenselecionpais.Value, _
                                                                       UpdatePanel_edita_campos_dinamicos)
                        If Resulta = "YES" Then
                            droplistadepartamento.Text = Hiddenseleciondepartamento.Value
                            For i As Integer = 0 To droplistadepartamento.Items.Count - 1
                                If droplistadepartamento.Items(i).Text = Hiddenseleciondepartamento.Value Then
                                    droplistadepartamento.SelectedIndex = i
                                    Exit For
                                End If
                            Next

                        End If

                    End If
                    '------------------------------------------------
                    'Lista los municipio en el evento postback
                    'y conserva el elemento seleccionado
                    '-----------------------------------------------
                    Dim droplistmunicipio As DropDownList = pag.FindControl("EDIT_MUNICIPIO")
                    If droplistmunicipio Is Nothing Then
                        Inicializa_interface_gestion_plantilla_validacion = "Imposible encontrar el control MUNICIPIO"
                        Exit Function
                    End If
                    If Hiddenseleciondepartamento.Value <> "SELECCIONE" And Hiddenseleciondepartamento.Value <> "" Then
                        'Dim Refclasra As New ClassRaConsultaRadicados
                        'Dim Resulta As String = ""
                        result = refclas_consulta.lista_Municipios_Departamentos_carga_inicio(droplistmunicipio, _
                                                                                              Hiddenseleciondepartamento.Value, _
                                                                                              UpdatePanel_edita_campos_dinamicos)
                        If result = "YES" Then
                            droplistmunicipio.Text = Hiddenmunicipio.Value
                            For i As Integer = 0 To droplistmunicipio.Items.Count - 1
                                If droplistmunicipio.Items(i).Text = Hiddenmunicipio.Value Then
                                    droplistadepartamento.SelectedIndex = i
                                    Exit For
                                End If
                            Next

                        End If

                    End If

                End If
            End If
            Inicializa_interface_gestion_plantilla_validacion = "YES"
        Catch ex As Exception
            Inicializa_interface_gestion_plantilla_validacion = "Inconsistencia general función Inicializa_interface_gestion_plantilla_validacion " & ex.Message
        End Try
    End Function
    '--Asigna datos plantilla para edicion
    Function Asignar_Datos_Plantilla_Para_Edicion_validacion(ByRef pag1 As Page, _
                                                             ByVal id_script As Integer) As String
        '**************************************************************************************************************
        'Funcion : Asignar datos plantilla car los dato seleccionados en la celda
        'de un datagredview de resultados relacionado con el control "hdnEmailID"
        'cullo valor guarda el id de plantilla de validacion, la estructura de los
        'campos que componen la plantilla se consultan en la base de datos con el id 
        'escrip de validacion que se alamacena en la varieable general "RA_DATO_VALIDACION"
        'en el split(2) en una matriz de tipo CAMPOS_PLANTILLA_VALIDACION que contiene la estruc
        'tura de cada campo, la cual se llena en una segunda instancia con los datos recuperados
        'de la plantilla con el ID, para luego buscar los campos y asignar los datos, hay que tener en cuenta
        'que cuando esta activa la opcion ubicaión el sistema carga los datos de los combos con dos fucniones externas
        'Ing : Miguel Angel Urueta Miranda
        'Fecha : 2014-08-01
        '**************************************************************************************************************
        Try
            '--------------------------------------------------------------------------------
            'ubicacion de campos en la pagina web y comprobacion de existencia
            '--------------------------------------------------------------------------------
            Dim update As UpdatePanel = pag1.FindControl("UpdatePanel_edita_campos_dinamicos")
            Dim hide As Object = pag1.FindControl("hdnEmailID_VAL")
            'Dim dateplantilla() As String = HttpContext.Current.Session("RA_DATO_VALIDACION").ToString.Split("|")
            If update Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = "Imposible el control UpdatePanelContenido en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            If hide Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = "Imposible el control hdnEmailID en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            If hide.Value = "-1" Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = "Imposible encontrar la celda seleccionada"
                Exit Function
            End If

            Dim hidepais As Object = pag1.FindControl("Hiddenselecionpais_EDIT")
            If hidepais Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = "Imposible el control Hiddenselecionpais en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            Dim hidepartamento As Object = pag1.FindControl("Hiddenseleciondepartamento_EDIT")
            If hidepartamento Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = "Imposible el control Hiddenselecionpais en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            Dim hidemunicipio As Object = pag1.FindControl("Hiddenmunicipio_EDIT")
            If hidemunicipio Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = "Imposible el control hidemunicipio en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
           
            Dim Result As String = ""
            Dim Matri_Datos() As CAMPOS_PLANTILLA_VALIDACION
            Erase Matri_Datos

            '****************************************************
            'Lista campos plantilla validacion
            '****************************************************
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Lista_Campos_Plantilla_Validacion(id_script,
                                                                                         Matri_Datos)
            If Result <> "YES" Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = Result
                Exit Function
            End If

            '****************************************************
            'Retorna nombre plantilla
            '****************************************************
            Dim nombre_plantillas As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(id_script,
                                                                                    nombre_plantillas)
            If Result <> "YES" Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = Result
                Exit Function
            End If

            '-----------------------------------------------------
            'Asigna datos a los campos de la palntilla con el id
            '-----------------------------------------------------
            Result = Asigna_Datos_Matri_Validacion(nombre_plantillas, _
                                                   Matri_Datos, _
                                                   hide.Value)
            If Result <> "YES" Then
                Asignar_Datos_Plantilla_Para_Edicion_validacion = Result
                Exit Function
            End If
            '--------------------------------------------------------
            'Asignacion a los campos de formulario
            '--------------------------------------------------------
            Dim estado_ubicacion As Integer = -1
            For i As Integer = 0 To Matri_Datos.Length - 1
                '----------------------------------------------------------
                'Asignacion de de datos a campos interface de ubicacion
                '---------------------------------------------------------
                If Matri_Datos(i).Nombre_Campo = "Pais" Or Matri_Datos(i).Nombre_Campo = "Municipio" _
                               Or Matri_Datos(i).Nombre_Campo = "Departemento" Then
                    Select Case Matri_Datos(i).Nombre_Campo
                        Case "Pais"
                            Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.text = Matri_Datos(i).TEXTO_CAMPO
                                hidepais.value = Matri_Datos(i).TEXTO_CAMPO
                                estado_ubicacion = 1
                            End If
                        Case "Departemento"
                            Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.text = Matri_Datos(i).TEXTO_CAMPO
                                hidepartamento.value = Matri_Datos(i).TEXTO_CAMPO
                                estado_ubicacion = 1
                            End If

                        Case "Municipio"
                            Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.text = Matri_Datos(i).TEXTO_CAMPO
                                hidemunicipio.value = Matri_Datos(i).TEXTO_CAMPO
                                estado_ubicacion = 1
                            End If

                    End Select

                Else
                    Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                    If Not ob Is Nothing Then
                        ob.text = Matri_Datos(i).TEXTO_CAMPO
                    End If
                End If
            Next
            '-----------------------------------------------------------------------------
            'Asignacion de datos a campos de ubicacion de la pagina web
            '-----------------------------------------------------------------------------
            If estado_ubicacion <> -1 Then
                Dim obpais As Object = pag1.FindControl("EDIT_Pais")
                If obpais Is Nothing Then
                    Asignar_Datos_Plantilla_Para_Edicion_validacion = "Funcion asignar datos plantilla para edicion imposible encontrar control  combo pais"
                    Exit Function
                End If
                Dim obmunicipio As Object = pag1.FindControl("EDIT_Municipio")
                If obmunicipio Is Nothing Then
                    Asignar_Datos_Plantilla_Para_Edicion_validacion = "Funcion asignar datos plantilla para edicion imposible encontrar control  combo obmunicipio"
                    Exit Function
                End If
                Dim obmdepartamento As Object = pag1.FindControl("EDIT_Departemento")
                If obmdepartamento Is Nothing Then
                    Asignar_Datos_Plantilla_Para_Edicion_validacion = "Funcion asignar datos plantilla para edicion imposible encontrar control  combo Departemento"
                    Exit Function

                End If
                '-----------------------------------------
                'Asignacion del pais
                '-----------------------------------------
                If obpais.items.count > 0 Then
                    If hidepais.value <> "" Then
                        obpais.SelectedIndex = 1
                    Else
                        obpais.SelectedIndex = 0
                    End If
                Else
                    obpais.items.add("SELECCIONE")
                    obpais.items.add("COLOMBIA")
                End If
                '------------------------------------------
                'Asignacion departamento
                '------------------------------------------
                If hidepais.value <> "" And hidepais.value <> "SELECCIONE" Then
                    Result = Me.Lista_Departamentos_Paises(obmdepartamento, _
                                                           hidepais.value, _
                                                           update, _
                                                           hidepartamento.value)
                    If Result <> "YES" Then
                        Asignar_Datos_Plantilla_Para_Edicion_validacion = Result
                        Exit Function
                    End If
                Else
                    obmdepartamento.Items.Clear()
                End If
                '-------------------------------------------
                'Asignacion municipio o ciudad
                '-------------------------------------------
                If hidepartamento.value <> "" And hidepartamento.value <> "SELECCIONE" Then
                    Result = Me.lista_Municipios_Departamentos_asignado(obmunicipio, _
                                                                        hidepartamento.value, _
                                                                        hidemunicipio.value)
                    If Result <> "YES" Then
                        Asignar_Datos_Plantilla_Para_Edicion_validacion = Result
                        Exit Function
                    End If
                Else
                    obmunicipio.Items.Clear()

                End If
            End If
            'butonactualiza.Enabled = True
            update.Update()
            Asignar_Datos_Plantilla_Para_Edicion_validacion = "YES"
        Catch ex As Exception
            Asignar_Datos_Plantilla_Para_Edicion_validacion = "Inconsistencia función Asignar_Datos_Plantilla_Para_Edicion_validacion " & ex.Message
        End Try
    End Function
    Function Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion(ByRef pag1 As Page, _
                                                                             ByVal id_sript As Integer) As String
        '********************************************************************************
        'Funcion : Recupera los campos de la pagina web direccionado por la matriz
        'de de tipo CAMPOS_PLANTILLA_VALIDACION el sistema determina los cambios
        'realizados sobre los campos en el formulario, verifica los campos unicos,
        'campos obligatorios, determina la estrucutura de los campos de ubicacion
        'Ingeniero : Miguel Angel Urueta Miranda
        'Fecha : 2014-08-02
        '*********************************************************************************
        Dim Hidden_campos_validacion As Object = pag1.FindControl("Hidden_campos_validacion")
        If Hidden_campos_validacion Is Nothing Then
            Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control Hidden_campos_validacion en la funcion  Editar_Indice_Plnatilla_Validacion"
            Exit Function
        End If
        Dim Hidden_valores_validacion As Object = pag1.FindControl("Hidden_valores_validacion")
        If Hidden_valores_validacion Is Nothing Then
            Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control Hidden_valores_validacion en la funcion Editar_Indice_Plnatilla_Validacion"
            Exit Function
        End If
        Try
            '--------------------------------------------------------------------------------
            'ubicacion de campos en la pagina web y comprobacion de existencia
            '--------------------------------------------------------------------------------
            'Dim update As UpdatePanel = pag1.FindControl("UpdatePanelContenido")
            Dim hide As Object = pag1.FindControl("hdnEmailID_VAL")
            'Dim dateplantilla() As String = HttpContext.Current.Session("RA_DATO_VALIDACION").ToString.Split("|")
            'If update Is Nothing Then
            '    Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control UpdatePanelContenido en la funcion Editar_Indice_Plnatilla_Validacion"
            '    Exit Function
            'End If
            If hide Is Nothing Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control hdnEmailID en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            If hide.Value = "-1" Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Debe seleccionar el registro a  editar"
                Exit Function
            End If

            Dim hidepais As Object = pag1.FindControl("Hiddenselecionpais_EDIT")
            If hidepais Is Nothing Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control Hiddenselecionpais en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            Dim hidepartamento As Object = pag1.FindControl("Hiddenseleciondepartamento_EDIT")
            If hidepartamento Is Nothing Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control Hiddenselecionpais en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            Dim hidemunicipio As Object = pag1.FindControl("Hiddenmunicipio_EDIT")
            If hidemunicipio Is Nothing Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control hidemunicipio en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If

            Hidden_campos_validacion.value = ""
            Hidden_valores_validacion.value = ""
            'Dim data_grid As GridView = pag1.FindControl("data_grid") Hidden_valores_validacion
            'If data_grid Is Nothing Then
            '    Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control data_grid en la funcion Editar_Indice_Plnatilla_Validacion"
            '    Exit Function
            'End If
            'Dim butonactualiza As Button = pag1.FindControl("" & "ACT_PLA" & "Actualizar")
            'If butonactualiza Is Nothing Then
            '    Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Imposible el control buton actualizar(ACT_PLAActualizar) en la funcion Editar_Indice_Plnatilla_Validacion"
            '    Exit Function
            'End If
            Dim Result As String = ""
            Dim Matri_Datos() As CAMPOS_PLANTILLA_VALIDACION
            Erase Matri_Datos
            Dim campo_idex As String = ""
            '****************************************************
            'Lista campos plantilla validacion
            '****************************************************
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Lista_Campos_Plantilla_Validacion(id_sript, Matri_Datos)
            If Result <> "YES" Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = Result
                Exit Function
            End If
            '*****************************************************
            'Busca campo identi en la mtriz campos
            '*****************************************************
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).IDENTI_CAMPO = 1 Then
                    campo_idex = Matri_Datos(i).Nombre_Campo
                End If
            Next
            If campo_idex = "" Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "La plantilla carece de campo identi por favor agregelo en el modulo administracion"
                Exit Function
            End If
            '***************************************************
            'Retorna nombre plantilla validacion
            '***************************************************
            Dim nombre_plantillas As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(id_sript,
                                                                                    nombre_plantillas)
            If Result <> "YES" Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = Result
                Exit Function
            End If
            '-----------------------------------------------------
            'Asigna datos a los campos de la palntilla con el id
            '-----------------------------------------------------
            Result = Asigna_Datos_Matri_Validacion(nombre_plantillas, Matri_Datos, hide.Value)
            If Result <> "YES" Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = Result
                Exit Function
            End If
            '--------------------------------------------------------
            'Asignacion a los campos de formulario
            '--------------------------------------------------------
            Dim estado_ubicacion As Integer = -1
            For i As Integer = 0 To Matri_Datos.Length - 1
                '----------------------------------------------------------
                'Asignacion de de datos de la intrface a la matriz
                '---------------------------------------------------------
                If Matri_Datos(i).Nombre_Campo = "Pais" Or Matri_Datos(i).Nombre_Campo = "Municipio" _
                               Or Matri_Datos(i).Nombre_Campo = "Departemento" Then
                    Select Case Matri_Datos(i).Nombre_Campo
                        Case "Pais"
                            Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidepais.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If
                        Case "Departemento"
                            Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidepartamento.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If

                        Case "Municipio"
                            Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidemunicipio.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If

                    End Select

                Else
                    Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                    If Not ob Is Nothing Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = ob.text
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida los formatos fecha
            '---------------------------------------------------------------------------------
            Dim ClassGestionFechas As New ClassGestionFechas
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then
                    If Matri_Datos(i).Tipo_Campo = "DATE" And Matri_Datos(i).TEXTO_CAMPO_MODIFICADO <> "" Then
                        Result = ClassGestionFechas.Verifi_campo_fecha(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                        If Result <> "YES" Then
                            Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "El formato fecha no cumple " & Result
                            Exit Function
                        End If
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida campos obligatorios vacios
            '---------------------------------------------------------------------------------
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).Obligatorio_Campo = 1 Then
                    If Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "" Then
                        Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                        If Not ob Is Nothing Then
                            ob.focus()
                        End If
                        Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "El campo " & Matri_Datos(i).Nombre_Campo & " es obligatorio"
                        Exit Function

                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida campos ubicacion 
            '---------------------------------------------------------------------------------
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).Obligatorio_Campo = 1 Then
                    If Matri_Datos(i).Nombre_Campo = "Pais" Or Matri_Datos(i).Nombre_Campo = "Municipio" _
                       Or Matri_Datos(i).Nombre_Campo = "Departemento" Then
                        If Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "" Or Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "SELECCIONE" Then
                            Dim ob As Object = pag1.FindControl("EDIT_" & Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.focus()
                            End If
                            Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "El campo " & Matri_Datos(i).Nombre_Campo & " es obligatorio"
                            Exit Function

                        End If
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Verifica existencia de los campos unicos
            '---------------------------------------------------------------------------------

            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then
                    If Matri_Datos(i).TEXTO_CAMPO <> Matri_Datos(i).TEXTO_CAMPO_MODIFICADO Then
                        If Matri_Datos(i).Unico_campo = 1 Then
                            Dim sql As String = "Select " & Matri_Datos(i).Nombre_Campo & " from " & nombre_plantillas & _
                                " where " & Matri_Datos(i).Nombre_Campo & "='" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                            Result = Class_plantilla_validacion.Verifica_Existencia_Campos_Unico_Validacion(sql, Matri_Datos(i).Nombre_Campo,
                                                                                                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO,
                                                                                                        Matri_Datos(i).Aleas_Campo_pqr)
                            If Result <> "YES" Then
                                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = Result
                                Exit Function
                            End If
                        End If
                    End If
                End If
            Next
            '-------------------------------------------------------------
            'Actualiza los campos de letra capital, upercase o towupercase
            '-------------------------------------------------------------
            Dim clas_trd_documental As New ClassTrdDocumental
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).TEXTO_CAMPO_MODIFICADO <> "" Then
                    If Matri_Datos(i).valida_capital_text = 1 Then
                        clas_trd_documental.Formato_sub_serie(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO, _
                                                              Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                    If Matri_Datos(i).valida_capital_text = 2 Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = UCase(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                    If Matri_Datos(i).valida_capital_text = 3 Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = LCase(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                End If
            Next
            '---------------------------------------------------------------------------- -----
            'Genera comnando de actualizacion
            '---------------------------------------------------------------------------------
            Dim sqlactualizacion As String = "Update " & nombre_plantillas & " set "
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then
                    If Matri_Datos(i).TEXTO_CAMPO <> Matri_Datos(i).TEXTO_CAMPO_MODIFICADO Then
                        If sqlactualizacion = "Update " & nombre_plantillas & " set " Then

                            sqlactualizacion = sqlactualizacion & Matri_Datos(i).Nombre_Campo & "='" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                        Else

                            sqlactualizacion = sqlactualizacion & " , " & Matri_Datos(i).Nombre_Campo & "='" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                        End If
                        Hidden_campos_validacion.value = Hidden_campos_validacion.value & Matri_Datos(i).Nombre_Campo & "¬"
                        Hidden_valores_validacion.value = Hidden_valores_validacion.value & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "¬"

                    End If
                End If
            Next
            If sqlactualizacion = "Update " & nombre_plantillas & " set " Then
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "No se modificaron campos para actualizar"
                Exit Function
            End If
            sqlactualizacion = sqlactualizacion & " where " & campo_idex & "='" & hide.value & "'"
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Result = Ref_Car_Conec.SELECTION_INSERT_COMMAND(sqlactualizacion)
            If Result <> "YES" Then
                Hidden_campos_validacion.value = ""
                Hidden_valores_validacion.value = ""
                Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = Result
                Exit Function
            End If
            Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "YES"
        Catch ex As Exception
            Hidden_campos_validacion.value = ""
            Hidden_valores_validacion.value = ""
            Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion = "Inconsistencia funcion Editar_Indice_Plantilla_Validacion_eidcion_plantilla_validacion " & ex.Message
        End Try
    End Function
