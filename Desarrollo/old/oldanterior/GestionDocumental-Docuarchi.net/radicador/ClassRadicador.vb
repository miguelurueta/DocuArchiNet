    Function Lista_AreasDep_Organigrama_Series_Items(ByVal Id_Organigrama As Integer, _
    ByRef LisRef As DropDownList) As String
        '******************************************************************************
        'Funcion lista las areas permitidas para el usuario de radicacion incorporando
        'items 
        'Fecha : 2018-09-07
        'Ingeniero : Miguel Angel Urueta Miranda
        '******************************************************************************
        Try

            LisRef.Items.Clear()
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "Select Codigo_Area,Nombre_Area from areas_depart_radicacion where " & _
            " Registro_Organigrama_Id_Organigrama=" & Id_Organigrama & " and Estado_Area=1"
            Dim Dat_reader As New DataSet
            Dim result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Dat_reader)
            If result <> "YES" Then
                Lista_AreasDep_Organigrama_Series_Items = " Error Lista_AreasDep_Organigrama_Series_Items   " & result
                Exit Function
            End If

            If Dat_reader.Tables(0).Rows.Count > 0 Then
                LisRef.Items.Add("SELECCIONE")
                LisRef.Items.Add("TODAS LAS AREAS")
                Dim ilist As New ListItem
                ilist.Text = "SELECCIONE"
                ilist.Value = "-1"
                LisRef.Items.Add(ilist)
                ilist = New ListItem
                ilist.Text = "TODAS LAS AREAS"
                ilist.Value = "0"
                LisRef.Items.Add(ilist)
                For i As Integer = 0 To Dat_reader.Tables(0).Rows.Count - 1
                    ilist.Text = Dat_reader.Tables(0).Rows(i).Item(1)
                    ilist.Value = Dat_reader.Tables(0).Rows(i).Item(0)
                Next
                Lista_AreasDep_Organigrama_Series_Items = "YES"
                Exit Function
            Else
                Lista_AreasDep_Organigrama_Series_Items = "YES"
                Exit Function
            End If

        Catch ex As Exception
            Lista_AreasDep_Organigrama_Series_Items = "Inconsistencia general funcuón Lista_AreasDep_Organigrama_Series_Items " & ex.Message
        End Try

    End Function
    
    
    Function Retorna_ID_Empresa_Usuario_Radicador(ByVal id_usuario_radicador As Integer, _
                                                  ByRef id_empresa As Integer) As String
        '*****************************************************************
        'Retorna id empresa usuario radicacion
        'Fecha : 2014-08-07
        'Ingeniero : Miguel Angel Urueta Miranda
        '*****************************************************************
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "Select Empresa_Gestion_Documental_id_empresa " & _
              " from usuario_radicador where id_usuario=" & id_usuario_radicador
            Dim Dat_reader As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Dat_reader)
            If Result <> "YES" Then
                Retorna_ID_Empresa_Usuario_Radicador = " Error consultando ide empresa usuario radicador   " & Result
                Return Retorna_ID_Empresa_Usuario_Radicador
                Exit Function
            End If
            If Dat_reader.Tables(0).Rows.Count = 0 Then
                Retorna_ID_Empresa_Usuario_Radicador = "Imposible encontrar id empresa usuario radicacion"
                Return Retorna_ID_Empresa_Usuario_Radicador
                Exit Function
            Else

                id_empresa = Dat_reader.Tables(0).Rows(0).Item(0)
                If id_empresa = 0 Then
                    Retorna_ID_Empresa_Usuario_Radicador = "El usuario radicador no tiene empresa asignada"
                    Exit Function
                Else
                    Retorna_ID_Empresa_Usuario_Radicador = "YES"
                    Return Retorna_ID_Empresa_Usuario_Radicador
                    Exit Function
                End If

            End If

        Catch ex As Exception
            Retorna_ID_Empresa_Usuario_Radicador = "Inconsistencia General Funcion Retorna_ID_Empresa_Usuario_Radicador " & ex.Message
        End Try
    End Function
