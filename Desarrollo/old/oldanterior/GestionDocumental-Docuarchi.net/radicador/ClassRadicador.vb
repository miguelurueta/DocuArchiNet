    Function Seleccion_tipo_tramite(ByRef pag As Page) As String
        Dim combo As DropDownList = pag.FindControl("RE_Descripcion_Documento")
        Try
            Dim Hidden_id_activividad As Object = pag.FindControl("Hidden_id_activividad")
            Dim Hiddentramiteseleccion As Object = pag.FindControl("Hiddentramiteseleccion")
            Dim text As TextBox = pag.FindControl("RE_FECHALIMITERESPUESTA" & "-" & "FECHALIMITERESPUESTA" & "-" & "DATE")
            If text Is Nothing Then
                Seleccion_tipo_tramite = "Imposible encontrar el control " & "RE_FECHALIMITERESPUESTA" & "-" & "FECHALIMITERESPUESTA" & "-" & "DATE"
                Exit Function
            End If
            Dim RE_flujo_trabajo As DropDownList = pag.FindControl("RE_flujo_trabajo")
            Dim text_user As TextBox = pag.FindControl("RE_USUARIO-DESTINATARIO-VARCHAR")
            Dim RE_actividad_asignacion_trabajo_flujo As DropDownList = pag.FindControl("RE_actividad_asignacion_trabajo_flujo")
            Dim RE_asignacion_asignacion_trabajo_flujo As DropDownList = pag.FindControl("RE_asignacion_asignacion_trabajo_flujo")
            If Not Hidden_id_activividad Is Nothing Then
                If Hidden_id_activividad.Value = "" Then
                    If Not RE_actividad_asignacion_trabajo_flujo Is Nothing Then
                        RE_actividad_asignacion_trabajo_flujo.Items.Clear()
                    End If
                End If     
            End If       
            If Not RE_asignacion_asignacion_trabajo_flujo Is Nothing Then
                RE_asignacion_asignacion_trabajo_flujo.Items.Clear()
            End If
            If Hiddentramiteseleccion.Value = "" Then
                Seleccion_tipo_tramite = "YES"
                Exit Function
            End If
            If Hiddentramiteseleccion.Value = "SELECCIONE" Then
                text.Text = ""
                RE_flujo_trabajo.Items.Clear()
                combo.Focus()
                Seleccion_tipo_tramite = "YES"
                Exit Function
            End If
            Dim id_tramite As Integer = 0
            If Not combo.SelectedItem Is Nothing Then
                id_tramite = combo.SelectedItem.Value
            End If
            Dim ob As Object = Nothing
            Dim Refclas As New ClassRadicador
            Dim refclas_gestion_fechas As New ClassGestionFechas
            Dim Result As String = ""
            Dim numero_dias As Integer = 0
            Dim split() As String = HttpContext.Current.Session.Item("RA_MODULO_SELECCIONADO").ToString.Split("|")
            Result = Refclas.Retorna_Dias_Vencimiento_tramite(split(1), Hiddentramiteseleccion.Value, numero_dias)
            If Result <> "YES" Then
                Seleccion_tipo_tramite = Result
                Exit Function
            End If
            If numero_dias = 0 Then Exit Function
            Dim fecha_actual As Object = Date.Now
            Result = refclas_gestion_fechas.Formatea_Fecha_Almacenamiento_Time(fecha_actual)
            If Result <> "YES" Then
                Seleccion_tipo_tramite = Result
                Exit Function
            End If
            'Result = Refclas.DateAgregarLaborales(numero_dias, fecha_actual, ob)
            Result = Refclas.DateAgregarLaborales(numero_dias, Date.Now, ob)
            If Result <> "YES" Then
                Seleccion_tipo_tramite = Result
                Exit Function
            Else
                Dim feha As String = ob
                Result = refclas_gestion_fechas.formata_fecha_tipo_date(feha)
                If Result <> "YES" Then
                    Seleccion_tipo_tramite = Result
                    Exit Function
                Else
                    feha = Left(feha, 10)
                    text.Text = feha.Replace("/", "-")
                End If
            End If
            Dim Class_ra_relacion_tramite_flujo_wokflow As New Class_ra_relacion_tramite_flujo_wokflow
            If id_tramite <> 0 Then
                Result = Class_ra_relacion_tramite_flujo_wokflow.Solicita_relaciones_flujo_trabajo_tramite(id_tramite,
                                                                                                           0,
                                                                                                           RE_flujo_trabajo)
                If Result <> "YES" Then
                    Seleccion_tipo_tramite = Result
                    Exit Function
                End If
            End If
            Dim Class_wf_registro_actividaes_flujos_trabajo As New Class_wf_registro_actividaes_flujos_trabajo
            If Not RE_actividad_asignacion_trabajo_flujo Is Nothing Then
                Result = Class_wf_registro_actividaes_flujos_trabajo.Solicita_trareas_inicio_flujo_trabajo(Val(RE_flujo_trabajo.SelectedValue),
                                                                                                           -1,
                                                                                                          RE_actividad_asignacion_trabajo_flujo)
                If Result <> "YES" Then
                    Seleccion_tipo_tramite = Result
                    Exit Function
                End If

            End If
            '-----Solicita actividades de ruta
            Dim Class_Listado_Actividades_workflow As New Class_Listado_Actividades_workflow
            If RE_flujo_trabajo.Items.Count = 0 Then
                If Not RE_actividad_asignacion_trabajo_flujo Is Nothing Then
                    Class_Listado_Actividades_workflow.Solicita_actividades_ruta(-1, _
                                                                                 RE_actividad_asignacion_trabajo_flujo)
                    If Result <> "YES" Then
                        Seleccion_tipo_tramite = Result
                        Exit Function
                    End If
                End If
            End If
            Dim Ref_clas_usuario_resp_flujo As New Class_ra_usuario_gestion_responsable_flujo
            Dim Ref_class_remit_dest_interno As New Class_remit_dest_interno
            Dim id_usuario_gestion_responsable As Integer = 0
            If Not text_user Is Nothing Then
                If Not RE_flujo_trabajo.SelectedValue Is Nothing Then
                    Ref_clas_usuario_resp_flujo.Solicita_usuario_responsable_flujo(Val(RE_flujo_trabajo.SelectedValue), _
                                                                                   id_usuario_gestion_responsable)
                    If Result <> "YES" Then
                        Seleccion_tipo_tramite = Result
                        Exit Function
                    End If
                    If id_usuario_gestion_responsable <> 0 Then
                        Ref_class_remit_dest_interno.Solicita_estructura_usuario_gestion_radicacion(id_usuario_gestion_responsable, _
                                                                                                    text_user.Text)
                        If Result <> "YES" Then
                            Seleccion_tipo_tramite = Result
                            Exit Function
                        End If
                    End If
                End If
            End If
            Seleccion_tipo_tramite = "YES"
            Exit Function
        Catch ex As Exception
            Seleccion_tipo_tramite = "Inconsistencia general función Seleccion_tipo_tramite " & ex.Message
        Finally
            combo.Focus()
        End Try
    End Function
