            Dim _Calendar As New CalendarExtender
            _Calendar.TargetControlID = id_target_calendar
            _Calendar.Format = "yyyy-MM-dd"
            _Calendar.PopupButtonID = id_puput_boton
            If Not _Calendar Is Nothing Then
                Panelref.Controls.Add(_Calendar)
