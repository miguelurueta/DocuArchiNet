        For i3 As Integer = 0 To Matri_Datos.Length - 1
            If Matri_Datos(i3).Estado_Campo = 1 Then
                Dim ob As Object = Page1.FindControl("RE_" & UCase(Matri_Datos(i3).Campo_Plantilla & "-" & UCase(Matri_Datos(i3).Campo_Plantilla) & "-" _
                                                     & UCase(Matri_Datos(i3).Tipo_Campo)))
