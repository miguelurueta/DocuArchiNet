                        Matri_Datos(i3).PLATAFORMA_SCRIPT = matri(i2).PLATAFORMA_SCRIPT
                        Matri_Datos(i3).ID_SCRIPT = matri(i2).ID_SCRIPT

                    End If
                Next
            Next
        End If

        '----------------------------------------------------
        'Asigna datos a los campos extraidos del formulario
        '----------------------------------------------------
        Dim refclasgestio_fecha As New ClassGestionFechas
        Dim dat As Date = Date.Now
        Dim date1al As String = ""
        Result = ""
        Result = refclasgestio_fecha.Formatea_fecha_time_framework(dat, date1al)
        If Result <> "YES" Then
