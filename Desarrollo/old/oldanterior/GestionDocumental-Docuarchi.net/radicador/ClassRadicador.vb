                                '_Plantilla_Impresion(i).Valor_Campo = DatSet.Tables(0).Rows(0).Item(_Plantilla_Impresion(i).Campo_Plantilla)
                                '_Plantilla_Impresion(i).Valor_Campo = _Plantilla_Impresion(i).Valor_Campo.ToString.Replace("p", "")
                                '_Plantilla_Impresion(i).Valor_Campo = _Plantilla_Impresion(i).Valor_Campo.ToString.Replace("m", "")
                                '_Plantilla_Impresion(i).Valor_Campo = _Plantilla_Impresion(i).Valor_Campo.ToString.Replace(".", "")
                                '_Plantilla_Impresion(i).Valor_Campo = _Plantilla_Impresion(i).Valor_Campo.ToString.Replace("M", "")
                                '_Plantilla_Impresion(i).Valor_Campo = _Plantilla_Impresion(i).Valor_Campo.ToString.Replace("P", "")
                                '_Plantilla_Impresion(i).Valor_Campo = _Plantilla_Impresion(i).Valor_Campo.ToString.Replace("A", "")
                                '_Plantilla_Impresion(i).Valor_Campo = _Plantilla_Impresion(i).Valor_Campo.ToString.Replace("a", "")
                                '_Plantilla_Impresion(i).Valor_Campo = Trim(_Plantilla_Impresion(i).Valor_Campo.ToString)
                            Else

                                _Plantilla_Impresion(i).Valor_Campo = DatSet.Tables(0).Rows(0).Item(_Plantilla_Impresion(i).Campo_Plantilla).ToString
                            End If
                        Else
                            _Plantilla_Impresion(i).Valor_Campo = ""
                        End If

                    Next
                End If
                If Tipo_Radicacion = "RADICACION GUIA" Then

                    For i As Integer = Visible_Campo_Empresa To UBound(_Plantilla_Impresion)
                        Dim Tempo_Val As String = ""
