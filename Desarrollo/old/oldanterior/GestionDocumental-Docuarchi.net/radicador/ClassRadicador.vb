    Function Retorna_registros_relacion_validacion_plantillas(ByVal plantilla_radic() As String, _
                                                              ByRef resultado As String, _
                                                              ByVal dest_ext As Integer) As String
        Try
            If plantilla_radic Is Nothing Then
                resultado = "NO"
                Retorna_registros_relacion_validacion_plantillas = "YES"
                Exit Function
            End If
            Dim seleccion As String = "Select * "
            Dim condiciones As String = ""
            Dim fromdes As String = ""
            For i As Integer = 0 To plantilla_radic.Length - 1
                If i = 0 Then
                    fromdes = "from " & plantilla_radic(i)
                    condiciones = " where " & plantilla_radic(i) & ".remit_dest_interno_id_remit_dest_int=" & dest_ext
                Else
                    condiciones = condiciones & " or " & plantilla_radic(i) & ".remit_dest_interno_id_remit_dest_int=" & dest_ext
                    fromdes = fromdes & "," & plantilla_radic(i)
                End If
            Next
            Dim Result As String = ""
            Dim conext As New conect.Dbase_Conction_Mysql_RA
            Dim datset As New DataSet
            Erase plantilla_radic
            Dim Parametro_Consulta As String = seleccion & fromdes & condiciones & " limit 1"
            Result = conext.SELECTION_SELECT_FIELD(Parametro_Consulta, datset)
            If Result <> "YES" Then
                Retorna_registros_relacion_validacion_plantillas = "Inconsistencia tratando de determinar la lista de relaciones " & Result
                Exit Function
            End If
            If datset.Tables(0).Rows.Count = 0 Then
                resultado = "NO"
                Retorna_registros_relacion_validacion_plantillas = "YES"
                Exit Function
            Else
                resultado = "YES"
                Retorna_registros_relacion_validacion_plantillas = "YES"
                Exit Function
            End If
        Catch ex As Exception
            Retorna_registros_relacion_validacion_plantillas = "Inconsistencia funcion Retorna_registros_relacion_validacion_plantillas " & ex.Message
        End Try
    End Function

