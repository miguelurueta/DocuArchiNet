                    End If
                Else
                    If Matri_Datos(i4).TEXTO_CAMPO = "" Then
                        Dim ob As Object = Page1.FindControl(Matri_Datos(i4).ID_CAMPO_ASPNET)
                        If Not ob Is Nothing Then
                            ob.focus()
                        End If
                        Registra_Radicacion_entrante_interna = "Debe informar el campo " & UCase(Matri_Datos(i4).Alias_Campo)
                        Exit Function
                    End If
                End If
            End If
        Next
        '----------------------------------------------------
        'Verifica campos fecha
        '----------------------------------------------------
        Dim ClassGestionFechas As New ClassGestionFechas
        For i4 As Integer = 0 To Matri_Datos.Length - 1
            If Matri_Datos(i4).Estado_Campo = 1 And Matri_Datos(i4).Tipo_Campo = "DATE" And Matri_Datos(i4).TEXTO_CAMPO <> "" Then
                Result = ClassGestionFechas.Verifi_campo_fecha(Matri_Datos(i4).TEXTO_CAMPO)
                If Result <> "YES" Then
                    Registra_Radicacion_entrante_interna = Result & "El formato del campo  " & Matri_Datos(i4).Campo_Plantilla
                    Exit Function
                End If
            End If
        Next
        '----------------------------------------------------
        'Verifica campo asunto este lleno
        '----------------------------------------------------
        For i4 As Integer = 0 To Matri_Datos.Length - 1
            If Matri_Datos(i4).ID_CAMPO_ASPNET = "RE_ASUNTO-ASUNTO-VARCHAR" Then
                If Matri_Datos(i4).TEXTO_CAMPO = "" Then
                    Registra_Radicacion_entrante_interna = "Debe informar el campo asunto para el radicado  interno"
                    Exit Function
                End If
            End If
        Next
        Dim ref_Class_tipo_doc_entrante As New Class_tipo_doc_entrante
        Result = ref_Class_tipo_doc_entrante.retorna_id_tipo_tramite_radicado(Codigo_Plantilla,
                                                                              Descripcion_documento,
                                                                              id_tipo_tramite_documento)
        If Result <> "YES" Then
            Registra_Radicacion_entrante_interna = Result
            Exit Function
        End If
        '***************************************************************************
        'Verifcia existencia destinatario externo
        '***************************************************************************
        Dim codigo_script As Integer = 0
        For i As Integer = 0 To Matri_Datos.Length - 1
            If Matri_Datos(i).Campo_Plantilla = "REMITENTE_COR" Then
                If Matri_Datos(i).ID_SCRIPT = 0 Then
                    Registra_Radicacion_entrante_interna = "El sistema ha detectado que el campo remitente no tiene una plantilla de validación relacionada por favor seleccione una plantilla"
                    Exit Function
                Else
                    codigo_script = Matri_Datos(i).ID_SCRIPT
                End If
            End If
        Next
        Dim campo_comparacion As String = ""
        Dim id_plantilla_validacion As Integer = 0
        Dim nombre_plantilla_validacion As String = ""
        Dim codigo_dest_externo As Integer = -1
        Dim Ref_Class_relacion_script_plantilla As New Class_relacion_script_plantilla
        If codigo_script <> 0 Then
            Result = Ref_Class_relacion_script_plantilla.retorna_campo_compracion_plantilla(codigo_script,
                                                                                            campo_comparacion,
                                                                                            nombre_plantilla_validacion,
                                                                                            id_plantilla_validacion)
            If Result <> "YES" Then
                Registra_Radicacion_entrante_interna = Result
                Exit Function
            End If

            Dim nombre_dest_externo As String = ""
            Result = Me.solicita_nombre_destinatario_externo(id_destinatario_externo,
                                                             nombre_plantilla_validacion,
                                                             campo_comparacion,
                                                             nombre_dest_externo)
            If Result <> "YES" Then
                Registra_Radicacion_entrante_interna = Result
                Exit Function
            End If
