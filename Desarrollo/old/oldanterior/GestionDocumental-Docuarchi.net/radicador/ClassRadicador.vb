                Exit Function
            End If
        Catch ex As Exception
            Retorna_id_registro_plantilla_validacion = "Inconsistencia general funcion Retorna_id_registro_plantilla_validacion " & ex.Message
        End Try
    End Function
    Function Asigna_datos_validacion_interface_radicacion(ByVal pag1 As Page) As String
        Try
            Dim spli() As String = HttpContext.Current.Session("RA_DATO_VALIDACION").ToString.Split("|")
            If spli.Length < 3 Then
                Asigna_datos_validacion_interface_radicacion = "El sistema no puede encontrar la variable con el id plantilla validacion funcion Asigna_datos_validacion_interface_radicacion"
                Exit Function
            End If
            Dim hidevalorselccion As Object = pag1.FindControl("hdnEmailID")
            If hidevalorselccion Is Nothing Then
                Asigna_datos_validacion_interface_radicacion = "Imposible encontrar el control hdnEmailID"
                Exit Function
            End If
            If hidevalorselccion.Value = "-1" Then
                Asigna_datos_validacion_interface_radicacion = "Debe seleccionar el registro a asignar"
                Exit Function
            End If
            Dim updat As UpdatePanel = pag1.FindControl("UpdatePnaelcontrolesradicacion")
            If updat Is Nothing Then
                Asigna_datos_validacion_interface_radicacion = "Imposible encontrar el control UpdatePnaelcontrolesradicacion"
                Exit Function
            End If
            Dim Hiddenrelacionvalidacion As Object = pag1.FindControl("Hiddenrelacionvalidacion")
            If Hiddenrelacionvalidacion Is Nothing Then
                Asigna_datos_validacion_interface_radicacion = "Imposible encontrar el control Hiddenrelacionvalidacion"
                Exit Function
            End If
            Dim ModalPopupExtenderdestinatario As ModalPopupExtender = pag1.FindControl("ModalPopupExtenderdestinatario")
            If ModalPopupExtenderdestinatario Is Nothing Then
                Asigna_datos_validacion_interface_radicacion = "Imposible encontrar el control ModalPopupExtenderdestinatario"
                Exit Function
            End If
            '**********************************************************
            'Solicita campo padre validacion
            '**********************************************************
            Dim campo_validacion As String = ""
            Dim campo_radicacion As String = spli(1)
            Dim nombre_plantilla_validacion As String = ""
            Dim nombre_plantilla_radicacion As String = ""
            Dim Result As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Campo_Validacion_nombre_plantilla_validacion(spli(2),
                                                                                                     nombre_plantilla_radicacion,
                                                                                                     campo_radicacion)
            If Result <> "YES" Then
                Asigna_datos_validacion_interface_radicacion = Result
                Exit Function
            End If

            '**********************************************************
            'Lista campos destino y fuente validacion
            '**********************************************************
            Dim matri_campo_fuente_destino() As asignacion_plantilla_validacion
            Erase matri_campo_fuente_destino
            Result = Class_plantilla_validacion.Lista_Campos_fuente_destino_validacion_dinamica_externa(spli(2),
                                                                                                        matri_campo_fuente_destino)
            If Result <> "YES" Then
                Asigna_datos_validacion_interface_radicacion = Result
                Exit Function
            End If
            '*********************************************************
            'Retorna  plantilla validacion 
            '*********************************************************
            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(spli(2),
                                                                                    nombre_plantilla_validacion)
            If Result <> "YES" Then
                Asigna_datos_validacion_interface_radicacion = Result
                Exit Function
            End If
            Dim id_plantilla_validacion As Integer = -1
            Result = Class_plantilla_validacion.Retorna_id_plantilla_validacion_nombre(nombre_plantilla_validacion,
                                                                                       id_plantilla_validacion)
            If Result <> "YES" Then
                Asigna_datos_validacion_interface_radicacion = Result
                Exit Function
            End If
            '*********************************************************
            'Retorna id plantilla radciacion
            '*********************************************************
            Dim id_plantilla_radicacion As Integer = -1
            Dim Ref_Class_system_plantilla_radicado As New Class_system_plantilla_radicado
            Result = Ref_Class_system_plantilla_radicado.SolicitaIdPlantillaRadicado(id_plantilla_radicacion, _
                                                                                       nombre_plantilla_radicacion)
            If Result <> "YES" Then
                Asigna_datos_validacion_interface_radicacion = Result
                Exit Function
            End If
            '*********************************************************
            'Retorna campo crieterio busqueda validacion
            '********************************************************
            Result = Class_plantilla_validacion.Lista_Campo_criterio_busqueda_Plantilla_Validacion(spli(2),
                                                                                                   campo_validacion)
            If Result <> "YES" Then
                Asigna_datos_validacion_interface_radicacion = Result
                Exit Function
            End If

            '*********************************************************
            'Retorna campo primary key plantilla validacion
            '*********************************************************
            Dim nombre_campo_prinary As String = ""
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Retorna_Campo_Primary_key_plantilla_validacion(id_plantilla_validacion,
                                                                                                      nombre_campo_prinary)
            If Result <> "YES" Then
                Asigna_datos_validacion_interface_radicacion = Result
                Exit Function
            End If
            Dim val_leng As Integer = 0
            If matri_campo_fuente_destino Is Nothing Then
            Else
                val_leng = matri_campo_fuente_destino.Length
            End If
            ReDim Preserve matri_campo_fuente_destino(val_leng)
            Dim Class_ra_detalle_plantilla_radicado As New Class_ra_detalle_plantilla_radicado
            matri_campo_fuente_destino(val_leng).Nombre_Campo_Fuente_Pla_Validacion = campo_validacion
            matri_campo_fuente_destino(val_leng).Nombre_Campo_Destino_Pla_Radicacion = campo_radicacion
            If campo_radicacion = "REMITENTE_COR" Or campo_radicacion = "DESTINATARIO_COR" Then
                matri_campo_fuente_destino(val_leng).Tipo_Campo_Destino_Pla_Radciacion = "VARCHAR"
            Else
                Result = Class_ra_detalle_plantilla_radicado.Retorna_Tipo_Campo_Plantilla_Radicacion(id_plantilla_radicacion,
                                                                                                     matri_campo_fuente_destino(val_leng).Nombre_Campo_Destino_Pla_Radicacion,
                                                                                                     matri_campo_fuente_destino(val_leng).Tipo_Campo_Destino_Pla_Radciacion)
                If Result <> "YES" Then
                    Asigna_datos_validacion_interface_radicacion = Result
                    Exit Function
                End If
            End If
            Result = Class_plantilla_validacion.Asigna_Datos_Fuente_Destino_Plantilla_Validacion(spli(2),
                                                                                                 matri_campo_fuente_destino,
                                                                                                 nombre_plantilla_validacion,
                                                                                                 nombre_campo_prinary,
                                                                                                 hidevalorselccion.Value)
            If Result <> "YES" Then
                Asigna_datos_validacion_interface_radicacion = Result
                Exit Function
            End If
            '******************************************************************
            'Asignar datos interface radicacion
            '******************************************************************
            For i As Integer = 0 To matri_campo_fuente_destino.Length - 1
                Dim id_campo As String = "RE_" & matri_campo_fuente_destino(i).Nombre_Campo_Destino_Pla_Radicacion & "-" & _
                     matri_campo_fuente_destino(i).Nombre_Campo_Destino_Pla_Radicacion & "-" & matri_campo_fuente_destino(i).Tipo_Campo_Destino_Pla_Radciacion
                If id_campo = "RE_DESTINATARIO_COR-DESTINATARIO_COR-VARCHAR" Then
                    id_campo = "RE_REMITENTE_COR-REMITENTE_COR-VARCHAR"
                End If
                Dim objcontrol As Object = pag1.FindControl(id_campo)
                If objcontrol Is Nothing Then
                    Asigna_datos_validacion_interface_radicacion = "Imposible encontrar el campo " & id_campo
                    Exit Function
                Else
                    objcontrol.text = matri_campo_fuente_destino(i).Valor_Campo_Destino_Pla_Radicacion
                End If
            Next
            '----------------------------------------------------
            'Determina si es primera vez el valor del relacion
            '----------------------------------------------------
            If Hiddenrelacionvalidacion.Value = "-1" Then
                Hiddenrelacionvalidacion.Value = id_plantilla_validacion & "-" & hidevalorselccion.Value & "-" & spli(2) & "|"
            Else
                'Dim testigo As Integer = -1
                'Dim splithiden() As String = Hiddenrelacionvalidacion.Value.ToString.Split("|")
                ''------------------------------------------------
                ''Remplaza el valor del id validacion
                ''------------------------------------------------
                'For i As Integer = 0 To splithiden.Length - 1
                '    Dim spliplantilla() As String = splithiden(i).Split("-")
                '    If spliplantilla(0) = id_plantilla_validacion Then
                '        '---Remplaza el valor del nuevo id validacion
                '        splithiden(i) = id_plantilla_validacion & "-" & hidevalorselccion.Value & "-" & spli(2)
                '        testigo = 1
                '        Exit For
                '    End If
                'Next
                'If testigo = -1 Then
                '    '------Adiciona un nuevo registro de relacion
                '    Hiddenrelacionvalidacion.Value = Hiddenrelacionvalidacion.Value & id_plantilla_validacion & "-" & hidevalorselccion.Value & "-" & spli(2) & "|"

                'Else
                '    '-----Remplaza los nuevos valores del control hiden
                '    For i As Integer = 0 To splithiden.Length - 1
                '        If i = 0 Then
                '            If splithiden(i) <> "" Then
                '                Hiddenrelacionvalidacion.Value = splithiden(i) & "|"
                '            End If

                '        Else
                '            If splithiden(i) <> "" Then
                '                Hiddenrelacionvalidacion.Value = Hiddenrelacionvalidacion.Value & splithiden(i) & "|"
                '            End If

                '        End If
                '    Next

                'End If

            End If
            Asigna_datos_validacion_interface_radicacion = "YES"
            ModalPopupExtenderdestinatario.Hide()
        Catch ex As Exception
