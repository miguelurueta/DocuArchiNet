    Function Retorna_id_scrip_plantilla_validacion(ByVal id_plantilla_validacion As Integer, ByRef id_script As Integer) As String
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "Select distinct script_actividades_Id_Script from relacion_script_plantilla " & _
                " where Plantilla_Validacion_Id_Plantilla_Validacion=" & id_plantilla_validacion
            Dim Datset As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Datset)
            If Result <> "YES" Then
                Retorna_id_scrip_plantilla_validacion = " Error Listando nombre plantilla VALIDACION   " & Result
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count = 0 Then
                id_script = 0
                Retorna_id_scrip_plantilla_validacion = "YES"
                Exit Function
            Else
                id_script = Datset.Tables(0).Rows(0).Item(0)
                Retorna_id_scrip_plantilla_validacion = "YES"
                Exit Function
            End If
        Catch ex As Exception
            Retorna_id_scrip_plantilla_validacion = "Inconsistencia general función Retorna_id_scrip_plantilla_validacion " & ex.Message
        End Try
    End Function
    Function Lista_plantillas_validacion_externa(ByRef matri_plnatillas_externas() As String) As String
        Try
            Erase matri_plnatillas_externas
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "Select distinct plantilla_validacion_id_plantilla_validacion,pv.Nombre_Plantilla from ra_relacion_usuario_plantilla_validacion as rup " & _
                " INNER JOIN plantilla_validacion AS pv on (pv.id_plantilla_validacion=rup.plantilla_validacion_id_plantilla_validacion)" & _
                " where usuario_radicador_Id_usuario=" & HttpContext.Current.Session.Item("RA_ID_USUARIO")
            Dim Datset As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Datset)
            If Result <> "YES" Then
                Lista_plantillas_validacion_externa = " Error Listando nombre plantilla VALIDACION   " & Result
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count = 0 Then
                Lista_plantillas_validacion_externa = "YES"
                Exit Function
            Else
                For i As Integer = 0 To Datset.Tables(0).Rows.Count - 1
                    ReDim Preserve matri_plnatillas_externas(i)
                    matri_plnatillas_externas(i) = Datset.Tables(0).Rows(i).Item(0).ToString & "¬" & Datset.Tables(0).Rows(i).Item(1).ToString
                Next
                Lista_plantillas_validacion_externa = "YES"
                Exit Function
            End If
        Catch ex As Exception
            Lista_plantillas_validacion_externa = "Inconsistencia general función Lista_plantillas_validacion_externa " & ex.Message
        End Try
    End Function

