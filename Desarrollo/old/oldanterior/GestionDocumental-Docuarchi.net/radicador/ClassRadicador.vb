            " inner join ra_relacion_pla_validacion_pla_radicacion as rpv on (rpv.id_registro_plantilla_radicacion=rg.id_Radicado and rpv.id_plantilla_radicacion=" & id_plantilla_radicacion & ")" & _
            " where Consecutivo_rad='" & consecutivo_radicado & "'"
            Dim Dat_reader As New DataSet
            Dim result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Dat_reader)
