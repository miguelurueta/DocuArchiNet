    Function Verififica_Existencia_datos_validacion_plantila_radicacion(ByVal pag1 As Page, _
                                                                        ByVal id_plantilla_radicado As Integer, _
                                                                        ByVal id_script As Integer, _
                                                                        ByVal valor_campo_identifcacion_plantilla As Integer, _
                                                                        ByVal Matri_Datos() As Campos_Plantilla) As String
        '***************************************************************************************
        'Funcion: valida datos interface plantilla radicado con los datos almacenados
        'en la plantilla valdacion
        'Fecha : 2014-08-22
        'Ingeniero Miguel Angel Urueta Miranda
        '***************************************************************************************

        Try
            '**********************************************************
            'Solicita campo padre validacion
            '**********************************************************
            Dim campo_validacion As String = ""
            Dim campo_radicacion As String = ""
            Dim nombre_plantilla_validacion As String = ""
            Dim nombre_plantilla_radicacion As String = ""
            Dim Result As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Campo_Validacion_nombre_plantilla_validacion(id_script,
                                                                                                     nombre_plantilla_radicacion,
                                                                                                     campo_radicacion)
            If Result <> "YES" Then
                Verififica_Existencia_datos_validacion_plantila_radicacion = Result
                Exit Function
            End If
            '**********************************************************
            'Lista campos destino y fuente validacion
            '**********************************************************
            Dim matri_campo_fuente_destino() As asignacion_plantilla_validacion
            Erase matri_campo_fuente_destino
            Result = Class_plantilla_validacion.Lista_Campos_fuente_destino_validacion_dinamica_externa(id_script,
                                                                                                        matri_campo_fuente_destino)
            If Result <> "YES" Then
                Verififica_Existencia_datos_validacion_plantila_radicacion = Result
                Exit Function
            End If
            '*********************************************************
            'Asigna datos al campo fuente
            '*********************************************************
            For i2 As Integer = 0 To matri_campo_fuente_destino.Length - 1
                For i As Integer = 0 To Matri_Datos.Length - 1
                    If matri_campo_fuente_destino(i2).Nombre_Campo_Destino_Pla_Radicacion = Matri_Datos(i).Campo_Plantilla Then
                        matri_campo_fuente_destino(i2).Valor_Campo_Fuente_Pla_Validacion = Matri_Datos(i).TEXTO_CAMPO
                        Exit For
                    End If
                Next
            Next
            '*********************************************************
            'Retorna  plantilla validacion 
            '*********************************************************

            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(id_script,
                                                                                    nombre_plantilla_validacion)
            If Result <> "YES" Then
                Verififica_Existencia_datos_validacion_plantila_radicacion = Result
                Exit Function
            End If
            Dim id_plantilla_validacion As Integer = -1
            Result = Class_plantilla_validacion.Retorna_id_plantilla_validacion_nombre(nombre_plantilla_validacion,
                                                                                      id_plantilla_validacion)
            If Result <> "YES" Then
                Verififica_Existencia_datos_validacion_plantila_radicacion = Result
                Exit Function
            End If
            '*********************************************************
            'Retorna id plantilla radciacion
            '*********************************************************
            Dim id_plantilla_radicacion As Integer = -1
            Dim Ref_Class_system_plantilla_radicado As New Class_system_plantilla_radicado
            Result = Ref_Class_system_plantilla_radicado.SolicitaIdPlantillaRadicado(id_plantilla_radicacion, _
                                                                                        nombre_plantilla_radicacion)
            If Result <> "YES" Then
                Verififica_Existencia_datos_validacion_plantila_radicacion = Result
                Exit Function
            End If
            '*********************************************************
            'Retorna campo crieterio busqueda validacion
            '********************************************************
            Result = Class_plantilla_validacion.Lista_Campo_criterio_busqueda_Plantilla_Validacion(id_script,
                                                                                                   campo_validacion)
            If Result <> "YES" Then
                Verififica_Existencia_datos_validacion_plantila_radicacion = Result
                Exit Function
            End If
            '*********************************************************
            'Busca valor campo plantilla criterio de busqueda
            'plantilla validacion
            '*********************************************************
            Dim valor_campo_validacion As String = ""
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).ID_SCRIPT = id_script Then
                    valor_campo_validacion = Matri_Datos(i).TEXTO_CAMPO
                    Exit For
                End If
            Next
            '*********************************************************
            'Retorna campo primary key plantilla validacion
            '*********************************************************
            Dim nombre_campo_prinary As String = ""
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Retorna_Campo_Primary_key_plantilla_validacion(id_plantilla_validacion,
                                                                                                      nombre_campo_prinary)
            If Result <> "YES" Then
                Verififica_Existencia_datos_validacion_plantila_radicacion = Result
                Exit Function
            End If
            '********************************************************
            'Genera campo sql 
            '********************************************************
            Dim campos_consulta As String = ""
            Dim sql As String = "Select * from " & nombre_plantilla_validacion & " where " & nombre_campo_prinary & "=" & valor_campo_identifcacion_plantilla & _
                " and " & campo_validacion & "='" & valor_campo_validacion & "' "
            For i2 As Integer = 0 To matri_campo_fuente_destino.Length - 1
                campos_consulta = campos_consulta & matri_campo_fuente_destino(i2).Nombre_Campo_Fuente_Pla_Validacion & "=" & matri_campo_fuente_destino(i2).Valor_Campo_Fuente_Pla_Validacion
                sql = sql & " and " & matri_campo_fuente_destino(i2).Nombre_Campo_Fuente_Pla_Validacion & "='" & matri_campo_fuente_destino(i2).Valor_Campo_Fuente_Pla_Validacion & "'"

            Next
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Dat_reader As New DataSet
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(sql, Dat_reader)
            If Result <> "YES" Then
                Verififica_Existencia_datos_validacion_plantila_radicacion = " Error validando campos plantilla radiacion con plantilla validacion  " & Result
                Exit Function
            End If
            If Dat_reader.Tables(0).Rows.Count = 0 Then

                Verififica_Existencia_datos_validacion_plantila_radicacion = "Imposible encontrar registros en la plantilla validacion con la siguiente consulta " & _
                    nombre_campo_prinary & "=" & valor_campo_identifcacion_plantilla & " " & campo_validacion & "='" & valor_campo_validacion & " " & campos_consulta & " valide nuevamente"
                Exit Function
            Else
                Verififica_Existencia_datos_validacion_plantila_radicacion = "YES"
                Exit Function

            End If
            Verififica_Existencia_datos_validacion_plantila_radicacion = "YES"
        Catch ex As Exception
            Verififica_Existencia_datos_validacion_plantila_radicacion = "Inconsistencia general funcion Verififica_Existencia_datos_validacion_plantila_radicacion " & ex.Message
        End Try
    End Function

    Function Registra_Radicacion_Guia(ByVal Tipo_Radicacion As String, _
                                      ByVal Codigo_Plantilla As String, _
                                      ByRef _RefPnel As Table, _
                                      ByRef Consecutivo_Impresion As String, _
                                      ByVal pag As Page) As String

        Dim ConseCRadicado As Integer = 0
        Dim ConseCCodbarra As Integer = 0
        Dim Objet As New Object
        Dim Nombre_Remitente As String = ""
        Dim Nombre_Destinatario As String = ""
        Dim Direccion_Dest As String = ""
        Dim Municipio_Dest As String = ""
        Dim Telefono_Dest As String = ""
        Dim Datoradicacion As Object = pag.FindControl("Hiddendatoradicacion")
        Datoradicacion.value = ""
        Dim a As String = ""
        For i As Integer = 0 To _RefPnel.Rows.Count - 1
            For i2 As Integer = 0 To _RefPnel.Rows(i).Cells.Count - 1
                For i3 As Integer = 0 To _RefPnel.Rows(i).Cells(i2).Controls.Count - 1
                    If _RefPnel.Rows(i).Cells(i2).Controls(i3).GetType().Name = "TextBox" Or _RefPnel.Rows(i).Cells(i2).Controls(i3).GetType().Name = "DropDownList" Then
