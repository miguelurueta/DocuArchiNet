                                             ByVal Visible_Campo_Empresa As Integer) As String
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Refclas_gestionfechas As New ClassGestionFechas
            Dim Parametro_Consulta As String = "select * from " & Nombre_Plantilla & _
