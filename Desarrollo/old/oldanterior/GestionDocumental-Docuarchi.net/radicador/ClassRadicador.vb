    Private Sub _comman_clik_guia_rad(ByVal sender As  _
    System.Object, ByVal e As System.EventArgs)
        Dim pag As Page = sender.page
        Dim updatedinamic As UpdatePanel = pag.FindControl("ActualizaindiceImage")
        Dim clasjava As New Classscrripjava
        Try

            Dim updat As UpdatePanel = pag.FindControl("UpdatePanelContenido")
            Dim panel As Table = pag.FindControl("TableControles")
            Dim upiframe As UpdatePanel = pag.FindControl("UpdatePaneliframe")
            Dim upiframe_post As UpdatePanel = pag.FindControl("UpdatePaneliframe_post")
            Dim hide As Object = pag.FindControl("Hiddendatoradicacion")
            Dim hide_ruta As Object = pag.FindControl("Hiddenruta")
            Dim Modal As ModalPopupExtender = pag.FindControl("ModalPopupExtenderimpre")
            Dim Modal_post As ModalPopupExtender = pag.FindControl("ModalPopupExtenderimpre_post")

            Dim ifra As Object = pag.FindControl("ifimpre")
            Dim ifra_post As Object = pag.FindControl("ifimpre_post_")

            Dim Matri_Split() As String = HttpContext.Current.Session("RA_MODULO_SELECCIONADO").ToString.Split("|")
            Dim Codigo_Impresion As String = ""
            If Matri_Split Is Nothing Then
                'clasjava.Showscripman("Imposible encontrar datos de la plantilla", updat)
                clasjava.Showscripman_menu("Imposible encontrar datos de la plantilla", updatedinamic, "ModalPopupExtender_mensaje_personalizado")
                Exit Sub
            End If

            Dim Result As String = ""
            Result = Registra_Radicacion_Guia(Matri_Split(0), Matri_Split(1), panel, Codigo_Impresion, sender.page)
            If Result <> "YES" Then
                'clasjava.Showscripman(Result, updatedinamic)
                clasjava.Showscripman_menu(Result, updatedinamic, "ModalPopupExtender_mensaje_personalizado")
                Exit Sub
            End If
            '***************************
            '0-codigo destinatario
            '1-codigo remitente
            '2-id usuario
            '3-codigo plantilla
            '4-Consecutivo Radicado
            '5-Consecutivo codigo barra
            '***************************
            'Codigo_Impresion = "38¬20¬23¬27¬18¬18¬2014/04/21 12:37:08"
            '*****************************************************************
            'Genera matriz datos rotulo impresion
            '*****************************************************************
            hide.value = Codigo_Impresion
            '-----------------------------------------------------------------
            'Asigna los datos de impresion para se leidos por las paginas
            'Impresion por texto o impresion post
            '-----------------------------------------------------------------
            HttpContext.Current.Session("RA_DATO_IMPRESION") = Codigo_Impresion
            If HttpContext.Current.Session("RA_TIPO_IMPRESION") = "2" Then
                Dim valor As String = hide.value
                Dim spltival() As String = valor.Split("¬")
                'ifra.Attributes("SRC") = "../radicador/WebFormImprimir.aspx"
                Dim Ruta_Sesion As String = ""
                Ruta_Sesion = HttpContext.Current.Session("RA_RUTA_TEMPO_IMPRESION").ToString()
                Dim rutafinal As String = Ruta_Sesion & "\" & "RA" & spltival(2) & spltival(3) & spltival(4) & ".pdf"
                HttpContext.Current.Session("RA_RUTA_IMPRESION_FINAL") = rutafinal
                hide_ruta.value = rutafinal
                'Exit Sub
                '************************************************************
                'Genera rotulo de impresion radicacion
                '************************************************************
                Dim pesta As String = ""
                pesta = HttpContext.Current.Session("RA_RUTA_IMPRESION_FINAL")
                Dim refplan() As Plantilla_Impresion
                Erase refplan
                Result = ""
                Result = Genera_Rotulo_Impresion(valor, rutafinal, refplan, HttpContext.Current.Session("RA_TIPO_IMPRESION").ToString())
                If Result <> "YES" Then
                    'clasjava.Showscripman(Result, updatedinamic)
                    clasjava.Showscripman_menu(Result, updatedinamic, "ModalPopupExtender_mensaje_personalizado")
                    Exit Sub
                End If
                upiframe.Update()
                updat.Update()
                Modal.Show()
            End If
            If HttpContext.Current.Session("RA_TIPO_IMPRESION") = "1" Then
                Dim valor As String = hide.value
                Dim spltival() As String = valor.Split("¬")
                ''ifra.Attributes("SRC") = "../radicador/WebFormImprimir.aspx"
                'Dim Ruta_Sesion As String = ""
                'Ruta_Sesion = HttpContext.Current.Session("RA_RUTA_TEMPO_IMPRESION").ToString()
                'Dim rutafinal As String = ""
                HttpContext.Current.Session("RA_RUTA_IMPRESION_FINAL") = ""
                hide_ruta.value = ""
                'Exit Sub
                '************************************************************
                'Genera rotulo de impresion radicacion
                '************************************************************
                'Dim pesta As String = ""
                'pesta = HttpContext.Current.Session("RA_RUTA_IMPRESION_FINAL")
                Dim refplan() As Plantilla_Impresion
                Erase refplan
                Result = ""
                Result = Genera_Rotulo_Impresion(valor, "", refplan, HttpContext.Current.Session("RA_TIPO_IMPRESION").ToString(), HttpContext.Current.Session("RA_RUTA_IMPRESION_FINAL"))
                If Result <> "YES" Then
                    'clasjava.Showscripman(Result, updatedinamic)
                    clasjava.Showscripman_menu(Result, updatedinamic, "ModalPopupExtender_mensaje_personalizado")
                    Exit Sub
                End If
                upiframe_post.Update()
                updat.Update()
                Modal_post.Show()
            End If
        Catch ex As Exception
            'clasjava.Showscripman(ex.Message, updatedinamic)
            clasjava.Showscripman_menu(ex.Message, updatedinamic, "ModalPopupExtender_mensaje_personalizado")
