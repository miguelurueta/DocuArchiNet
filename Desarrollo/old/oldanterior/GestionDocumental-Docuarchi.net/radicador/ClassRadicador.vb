    Function Retorna_Estado_Ubicacion_Plantilla_Validacion(ByVal id_script As Integer, ByRef estado_ubicacion As Integer) As String
        '******************************************************************************
        'Funcion : Retorna el estado ubicacion plantilla validacion con el parametro
        'id script
        'Fecha : 2014-07-24
        'Ingeniero : Miguel Angel Urueta Miranda
        '******************************************************************************
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "select Habilita_Ubicacion from  relacion_script_plantilla" & _
            " inner join plantilla_validacion as pv on (pv.Id_Plantilla_Validacion=plantilla_validacion_id_Plantilla_Validacion)" & _
            " where script_actividades_id_script=" & id_script
            Dim Dat_reader As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Dat_reader)
            If Result <> "YES" Then
                Retorna_Estado_Ubicacion_Plantilla_Validacion = " Error verificando estado ubicacion plantilla validación   " & Result
                Exit Function
            End If

            If Dat_reader.Tables(0).Rows.Count = 0 Then
                Retorna_Estado_Ubicacion_Plantilla_Validacion = "Imposible encontrar estado ubicacion plantilla validación"
                Exit Function
            Else
                estado_ubicacion = Dat_reader.Tables(0).Rows(0).Item(0)
                Retorna_Estado_Ubicacion_Plantilla_Validacion = "YES"
                Exit Function

            End If
        Catch ex As Exception
            Retorna_Estado_Ubicacion_Plantilla_Validacion = "Inconsistencia General Funcion REUPV " & ex.Message
        End Try
    End Function
