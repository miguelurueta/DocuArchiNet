    Function Editar_Indice_Plantilla_Validacion(ByRef pag1 As Page) As String
        '********************************************************************************
        'Funcion : Recupera los campos de la pagina web direccionado por la matriz
        'de de tipo CAMPOS_PLANTILLA_VALIDACION el sistema determina los cambios
        'realizados sobre los campos en el formulario, verifica los campos unicos,
        'campos obligatorios, determina la estrucutura de los campos de ubicacion
        'Ingeniero : Miguel Angel Urueta Miranda
        'Fecha : 2014-08-02
        '*********************************************************************************
        Try
            '--------------------------------------------------------------------------------
            'ubicacion de campos en la pagina web y comprobacion de existencia
            '--------------------------------------------------------------------------------
            Dim update As UpdatePanel = pag1.FindControl("UpdatePanelContenido")
            Dim hide As Object = pag1.FindControl("hdnEmailID")
            Dim dateplantilla() As String = HttpContext.Current.Session("RA_DATO_VALIDACION").ToString.Split("|")
            If update Is Nothing Then
                Editar_Indice_Plantilla_Validacion = "Imposible el control UpdatePanelContenido en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            If hide Is Nothing Then
                Editar_Indice_Plantilla_Validacion = "Imposible el control hdnEmailID en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            If hide.Value = "-1" Then
                Editar_Indice_Plantilla_Validacion = "Debe seleccionar el registro a  editar"
                Exit Function
            End If

            Dim hidepais As Object = pag1.FindControl("Hiddenselecionpais")
            If hidepais Is Nothing Then
                Editar_Indice_Plantilla_Validacion = "Imposible el control Hiddenselecionpais en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            Dim hidepartamento As Object = pag1.FindControl("Hiddenseleciondepartamento")
            If hidepartamento Is Nothing Then
                Editar_Indice_Plantilla_Validacion = "Imposible el control Hiddenselecionpais en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            Dim hidemunicipio As Object = pag1.FindControl("Hiddenmunicipio")
            If hidemunicipio Is Nothing Then
                Editar_Indice_Plantilla_Validacion = "Imposible el control hidemunicipio en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            Dim data_grid As GridView = pag1.FindControl("data_grid")
            If data_grid Is Nothing Then
                Editar_Indice_Plantilla_Validacion = "Imposible el control data_grid en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            Dim butonactualiza As Button = pag1.FindControl("" & "ACT_PLA" & "Actualizar")
            If butonactualiza Is Nothing Then
                Editar_Indice_Plantilla_Validacion = "Imposible el control buton actualizar(ACT_PLAActualizar) en la funcion Editar_Indice_Plnatilla_Validacion"
                Exit Function
            End If
            Dim Result As String = ""
            Dim Matri_Datos() As CAMPOS_PLANTILLA_VALIDACION
            Erase Matri_Datos
            Dim campo_idex As String = ""
            '****************************************************
            'Lista campos plantilla validacion
            '****************************************************
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Lista_Campos_Plantilla_Validacion(dateplantilla(2), Matri_Datos)
            If Result <> "YES" Then
                Editar_Indice_Plantilla_Validacion = Result
                Exit Function
            End If
            '*****************************************************
            'Busca campo identi en la mtriz campos
            '*****************************************************
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).IDENTI_CAMPO = 1 Then
                    campo_idex = Matri_Datos(i).Nombre_Campo
                End If
            Next
            If campo_idex = "" Then
                Editar_Indice_Plantilla_Validacion = "La plantilla carece de campo identi por favor agregelo en el modulo administracion"
                Exit Function
            End If
            '***************************************************
            'Retorna nombre plantilla validacion
            '***************************************************
            Dim nombre_plantillas As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(dateplantilla(2),
                                                                                    nombre_plantillas)
            If Result <> "YES" Then
                Editar_Indice_Plantilla_Validacion = Result
                Exit Function
            End If
            '-----------------------------------------------------
            'Asigna datos a los campos de la palntilla con el id
            '-----------------------------------------------------
            Result = Asigna_Datos_Matri_Validacion(nombre_plantillas, Matri_Datos, hide.Value)
            If Result <> "YES" Then
                Editar_Indice_Plantilla_Validacion = Result
                Exit Function
            End If
            '--------------------------------------------------------
            'Asignacion a los campos de formulario
            '--------------------------------------------------------
            Dim estado_ubicacion As Integer = -1
            For i As Integer = 0 To Matri_Datos.Length - 1
                '----------------------------------------------------------
                'Asignacion de de datos de la intrface a la matriz
                '---------------------------------------------------------
                If Matri_Datos(i).Nombre_Campo = "Pais" Or Matri_Datos(i).Nombre_Campo = "Municipio" _
                               Or Matri_Datos(i).Nombre_Campo = "Departemento" Then
                    Select Case Matri_Datos(i).Nombre_Campo
                        Case "Pais"
                            Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidepais.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If
                        Case "Departemento"
                            Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidepartamento.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If

                        Case "Municipio"
                            Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = hidemunicipio.value
                                'hidepais.value = ob.text
                                estado_ubicacion = 1
                            End If

                    End Select

                Else
                    Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                    If Not ob Is Nothing Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = ob.text
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida los formatos fecha
            '---------------------------------------------------------------------------------
            Dim ClassGestionFechas As New ClassGestionFechas
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then
                    If Matri_Datos(i).Tipo_Campo = "DATE" And Matri_Datos(i).TEXTO_CAMPO_MODIFICADO <> "" Then
                        Result = ClassGestionFechas.Verifi_campo_fecha(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                        If Result <> "YES" Then
                            Editar_Indice_Plantilla_Validacion = "El formato fecha no cumple " & Result
                            Exit Function
                        End If
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida campos obligatorios vacios
            '---------------------------------------------------------------------------------
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).Obligatorio_Campo = 1 Then
                    If Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "" Then
                        Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                        If Not ob Is Nothing Then
                            ob.focus()
                        End If
                        Editar_Indice_Plantilla_Validacion = "El campo " & Matri_Datos(i).Nombre_Campo & " es obligatorio"
                        Exit Function

                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Valida campos ubicacion 
            '---------------------------------------------------------------------------------
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).Obligatorio_Campo = 1 Then
                    If Matri_Datos(i).Nombre_Campo = "Pais" Or Matri_Datos(i).Nombre_Campo = "Municipio" _
                       Or Matri_Datos(i).Nombre_Campo = "Departemento" Then
                        If Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "" Or Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = "SELECCIONE" Then
                            Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.focus()
                            End If
                            Editar_Indice_Plantilla_Validacion = "El campo " & Matri_Datos(i).Nombre_Campo & " es obligatorio"
                            Exit Function

                        End If
                    End If
                End If
            Next
            '---------------------------------------------------------------------------------
            'Verifica existencia de los campos unicos
            '---------------------------------------------------------------------------------

            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then
                    If Matri_Datos(i).TEXTO_CAMPO <> Matri_Datos(i).TEXTO_CAMPO_MODIFICADO Then
                        If Matri_Datos(i).Unico_campo = 1 Then
                            Dim sql As String = "Select " & Matri_Datos(i).Nombre_Campo & " from " & nombre_plantillas & _
                                " where " & Matri_Datos(i).Nombre_Campo & "='" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                            Result = Class_plantilla_validacion.Verifica_Existencia_Campos_Unico_Validacion(sql, Matri_Datos(i).Nombre_Campo,
                                                                                                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO,
                                                                                                        Matri_Datos(i).Aleas_Campo_pqr)
                            If Result <> "YES" Then
                                Editar_Indice_Plantilla_Validacion = Result
                                Exit Function
                            End If
                        End If
                    End If
                End If
            Next
            '-------------------------------------------------------------
            'Actualiza los campos de letra capital, upercase o towupercase
            '-------------------------------------------------------------
            Dim clas_trd_documental As New ClassTrdDocumental
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 And Matri_Datos(i).TEXTO_CAMPO_MODIFICADO <> "" Then
                    If Matri_Datos(i).valida_capital_text = 1 Then
                        clas_trd_documental.Formato_sub_serie(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO, _
                                                              Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                    If Matri_Datos(i).valida_capital_text = 2 Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = UCase(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                    If Matri_Datos(i).valida_capital_text = 3 Then
                        Matri_Datos(i).TEXTO_CAMPO_MODIFICADO = LCase(Matri_Datos(i).TEXTO_CAMPO_MODIFICADO)
                    End If
                End If
            Next
            '---------------------------------------------------------------------------- -----
            'Genera comnando de actualizacion
            '---------------------------------------------------------------------------------
            Dim sqlactualizacion As String = "Update " & nombre_plantillas & " set "
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).Visible_Campo = 1 And Matri_Datos(i).IDENTI_CAMPO <> 1 Then
                    If Matri_Datos(i).TEXTO_CAMPO <> Matri_Datos(i).TEXTO_CAMPO_MODIFICADO Then
                        If sqlactualizacion = "Update " & nombre_plantillas & " set " Then
                            sqlactualizacion = sqlactualizacion & Matri_Datos(i).Nombre_Campo & "='" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                        Else
                            sqlactualizacion = sqlactualizacion & " , " & Matri_Datos(i).Nombre_Campo & "='" & Matri_Datos(i).TEXTO_CAMPO_MODIFICADO & "'"
                        End If
                    End If
                End If
            Next

            If sqlactualizacion = "Update " & nombre_plantillas & " set " Then
                Editar_Indice_Plantilla_Validacion = "No se modificaron campos para actualizar"
                Exit Function
            End If
            sqlactualizacion = sqlactualizacion & " where " & campo_idex & "='" & hide.value & "'"
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Result = Ref_Car_Conec.SELECTION_INSERT_COMMAND(sqlactualizacion)
            If Result <> "YES" Then
                Editar_Indice_Plantilla_Validacion = Result
                Exit Function
            End If
            '------------------------------------------------------------
            'Actualiza data gred con los nuevos datos consultando
            '------------------------------------------------------------
            Result = Genera_consulta_validacion_post(pag1)
            If Result <> "YES" Then
                Editar_Indice_Plantilla_Validacion = Result
                Exit Function
            End If
            Editar_Indice_Plantilla_Validacion = "YES"
        Catch ex As Exception
            Editar_Indice_Plantilla_Validacion = "Inconsistencia funcion Editar_Indice_Plantilla_Validacion " & ex.Message
        End Try
    End Function

    Function retorna_datos_radicacion_estructura(ByVal tipo_radicacion As String, _
                                                 ByVal consecutivo_radicacion As String, _
                                                 ByVal nombre_plantilla As String, _
                                                 ByRef sctru_radicado() As Campos_Plantilla) As String
        Try
            Dim typde As String = ""
            retorna_datos_radicacion_estructura = ""
            Dim selection_campo As String = ""
            For i As Integer = 0 To sctru_radicado.Length - 1
                If i = 0 Then
                    selection_campo = sctru_radicado(i).Campo_Plantilla
                Else
                    selection_campo = selection_campo & "," & sctru_radicado(i).Campo_Plantilla
                End If
            Next
            Dim sqlconsulta As String = "Select " & selection_campo & " from " & nombre_plantilla & " where Consecutivo_Rad='" & consecutivo_radicacion & "'"
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Dat_reader As New DataSet
            Dim Result As String = Ref_Car_Conec.SELECTION_SELECT_FIELD(sqlconsulta, Dat_reader)
            If Result <> "YES" Then
                retorna_datos_radicacion_estructura = " Función retorna_datos_radicacion_estructura  dice  " & Result
                Exit Function
            End If
            If Dat_reader.Tables(0).Rows.Count = 0 Then
                retorna_datos_radicacion_estructura = " Imposible encontrar datos del sistema del consecutivo radicado " & consecutivo_radicacion
                Exit Function
            Else
                For i As Integer = 0 To sctru_radicado.Length - 1
                    typde = Dat_reader.Tables(0).Rows(0).Item(sctru_radicado(i).Campo_Plantilla).GetType.ToString
                    If Dat_reader.Tables(0).Rows(0).IsNull(sctru_radicado(i).Campo_Plantilla) = True Then
                        sctru_radicado(i).TEXTO_CAMPO = ""
                    Else
                        If typde = "System.DateTime" Then
                            Dim SplitWf() As String = Left(Dat_reader.Tables(0).Rows(0).Item(sctru_radicado(i).Campo_Plantilla).ToString, 10).Split("/")
                            If Not SplitWf Is Nothing Then
                                sctru_radicado(i).TEXTO_CAMPO = SplitWf(2) & "-" & SplitWf(1) & "-" & SplitWf(0)
                            Else
                                sctru_radicado(i).TEXTO_CAMPO = "#Error"
                            End If
                        Else
                            sctru_radicado(i).TEXTO_CAMPO = Dat_reader.Tables(0).Rows(0).Item(sctru_radicado(i).Campo_Plantilla)
                        End If

                    End If
                Next
                retorna_datos_radicacion_estructura = "YES"
                Exit Function
            End If

        Catch ex As Exception
            retorna_datos_radicacion_estructura = "Inconsistencia general función retorna_datos_radicacion_estructura " & ex.Message
        End Try
    End Function
    '--Asigna datos plantilla para edicion
    Function Asignar_Datos_Plantilla_Para_Edicion(ByRef pag1 As Page) As String
        '**************************************************************************************************************
        'Funcion : Asignar datos plantilla car los dato seleccionados en la celda
        'de un datagredview de resultados relacionado con el control "hdnEmailID"
        'cullo valor guarda el id de plantilla de validacion, la estructura de los
        'campos que componen la plantilla se consultan en la base de datos con el id 
        'escrip de validacion que se alamacena en la varieable general "RA_DATO_VALIDACION"
        'en el split(2) en una matriz de tipo CAMPOS_PLANTILLA_VALIDACION que contiene la estruc
        'tura de cada campo, la cual se llena en una segunda instancia con los datos recuperados
        'de la plantilla con el ID, para luego buscar los campos y asignar los datos, hay que tener en cuenta
        'que cuando esta activa la opcion ubicaión el sistema carga los datos de los combos con dos fucniones externas
        'Ing : Miguel Angel Urueta Miranda
        'Fecha : 2014-08-01
        '**************************************************************************************************************
        Try
            '--------------------------------------------------------------------------------
            'ubicacion de campos en la pagina web y comprobacion de existencia
            '--------------------------------------------------------------------------------
            Dim update As UpdatePanel = pag1.FindControl("UpdatePanelContenido")
            Dim hide As Object = pag1.FindControl("hdnEmailID")
            Dim dateplantilla() As String = HttpContext.Current.Session("RA_DATO_VALIDACION").ToString.Split("|")
            If update Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion = "Imposible el control UpdatePanelContenido en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            If hide Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion = "Imposible el control hdnEmailID en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            If hide.Value = "-1" Then
                Asignar_Datos_Plantilla_Para_Edicion = "Imposible encontrar la celda seleccionada"
                Exit Function
            End If

            Dim hidepais As Object = pag1.FindControl("Hiddenselecionpais")
            If hidepais Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion = "Imposible el control Hiddenselecionpais en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            Dim hidepartamento As Object = pag1.FindControl("Hiddenseleciondepartamento")
            If hidepartamento Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion = "Imposible el control Hiddenselecionpais en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            Dim hidemunicipio As Object = pag1.FindControl("Hiddenmunicipio")
            If hidemunicipio Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion = "Imposible el control hidemunicipio en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            Dim data_grid As GridView = pag1.FindControl("data_grid")
            If data_grid Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion = "Imposible el control data_grid en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            Dim butonactualiza As Button = pag1.FindControl("" & "ACT_PLA" & "Actualizar")
            If butonactualiza Is Nothing Then
                Asignar_Datos_Plantilla_Para_Edicion = "Imposible el control buton actualizar(ACT_PLAActualizar) en la funcion Asignar_Datos_Plantilla_Para_Edicion"
                Exit Function
            End If
            Dim Result As String = ""
            Dim Matri_Datos() As CAMPOS_PLANTILLA_VALIDACION
            Erase Matri_Datos

            '****************************************************
            'Lista campos plantilla validacion
            '****************************************************
            Dim Class_campos_plantilla_validacion As New Class_campos_plantilla_validacion
            Result = Class_campos_plantilla_validacion.Lista_Campos_Plantilla_Validacion(dateplantilla(2), Matri_Datos)
            If Result <> "YES" Then
                Asignar_Datos_Plantilla_Para_Edicion = Result
                Exit Function
            End If
            '***************************************************
            'Retorna nombre plantilla validacion
            '***************************************************
            Dim nombre_plantillas As String = ""
            Dim Class_plantilla_validacion As New Class_plantilla_validacion
            Result = Class_plantilla_validacion.Retorna_Nombre_Plantilla_Validacion(dateplantilla(2),
                                                                                    nombre_plantillas)
            If Result <> "YES" Then
                Asignar_Datos_Plantilla_Para_Edicion = Result
                Exit Function
            End If
            '-----------------------------------------------------
            'Asigna datos a los campos de la palntilla con el id
            '-----------------------------------------------------
            Result = Asigna_Datos_Matri_Validacion(nombre_plantillas, Matri_Datos, hide.Value)
            If Result <> "YES" Then
                Asignar_Datos_Plantilla_Para_Edicion = Result
                Exit Function
            End If
            '--------------------------------------------------------
            'Asignacion a los campos de formulario
            '--------------------------------------------------------
            Dim estado_ubicacion As Integer = -1
            For i As Integer = 0 To Matri_Datos.Length - 1
                '----------------------------------------------------------
                'Asignacion de de datos a campos interface de ubicacion
                '---------------------------------------------------------
                If Matri_Datos(i).Nombre_Campo = "Pais" Or Matri_Datos(i).Nombre_Campo = "Municipio" _
                               Or Matri_Datos(i).Nombre_Campo = "Departemento" Then
                    Select Case Matri_Datos(i).Nombre_Campo
                        Case "Pais"
                            Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.text = Matri_Datos(i).TEXTO_CAMPO
                                hidepais.value = Matri_Datos(i).TEXTO_CAMPO
                                estado_ubicacion = 1
                            End If
                        Case "Departemento"
                            Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.text = Matri_Datos(i).TEXTO_CAMPO
                                hidepartamento.value = Matri_Datos(i).TEXTO_CAMPO
                                estado_ubicacion = 1
                            End If

                        Case "Municipio"
                            Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                            If Not ob Is Nothing Then
                                ob.text = Matri_Datos(i).TEXTO_CAMPO
                                hidemunicipio.value = Matri_Datos(i).TEXTO_CAMPO
                                estado_ubicacion = 1
                            End If

                    End Select

                Else
                    Dim ob As Object = pag1.FindControl(Matri_Datos(i).Nombre_Campo)
                    If Not ob Is Nothing Then
                        ob.text = Matri_Datos(i).TEXTO_CAMPO
                    End If
                End If
            Next
            '-----------------------------------------------------------------------------
            'Asignacion de datos a campos de ubicacion de la pagina web
            '-----------------------------------------------------------------------------
            If estado_ubicacion <> -1 Then
                Dim obpais As Object = pag1.FindControl("Pais")
                If obpais Is Nothing Then
                    Asignar_Datos_Plantilla_Para_Edicion = "Funcion asignar datos plantilla para edicion imposible encontrar control  combo pais"
                    Exit Function
                End If
                Dim obmunicipio As Object = pag1.FindControl("Municipio")
                If obmunicipio Is Nothing Then
                    Asignar_Datos_Plantilla_Para_Edicion = "Funcion asignar datos plantilla para edicion imposible encontrar control  combo obmunicipio"
                    Exit Function
                End If
                Dim obmdepartamento As Object = pag1.FindControl("Departemento")
                If obmdepartamento Is Nothing Then
                    Asignar_Datos_Plantilla_Para_Edicion = "Funcion asignar datos plantilla para edicion imposible encontrar control  combo Departemento"
                    Exit Function

                End If
                '-----------------------------------------
                'Asignacion del pais
                '-----------------------------------------
                If obpais.items.count > 0 Then
                    If hidepais.value <> "" Then
                        obpais.SelectedIndex = 1
                    Else
                        obpais.SelectedIndex = 0
                    End If
                Else
                    obpais.items.add("SELECCIONE")
                    obpais.items.add("COLOMBIA")
                End If
                '------------------------------------------
                'Asignacion departamento
                '------------------------------------------
                If hidepais.value <> "" And hidepais.value <> "SELECCIONE" Then
                    Result = Me.Lista_Departamentos_Paises(obmdepartamento, hidepais.value, update, hidepartamento.value)
                    If Result <> "YES" Then
                        Asignar_Datos_Plantilla_Para_Edicion = Result
                        Exit Function
                    End If
                Else
                    obmdepartamento.Items.Clear()
                End If
                '-------------------------------------------
                'Asignacion municipio o ciudad
                '-------------------------------------------
                If hidepartamento.value <> "" And hidepartamento.value <> "SELECCIONE" Then
                    Result = Me.lista_Municipios_Departamentos_asignado(obmunicipio, hidepartamento.value, hidemunicipio.value)
                    If Result <> "YES" Then
                        Asignar_Datos_Plantilla_Para_Edicion = Result
                        Exit Function
                    End If
                Else
                    obmunicipio.Items.Clear()

                End If
            End If
            butonactualiza.Enabled = True
            update.Update()
            Asignar_Datos_Plantilla_Para_Edicion = "YES"
        Catch ex As Exception
            Asignar_Datos_Plantilla_Para_Edicion = "Inconsistencia función Asignar_Datos_Plantilla_Para_Edicion " & ex.Message
        End Try
    End Function
    Function Asigna_Datos_Matri_Validacion(ByVal nombre_plantilla_validacion As String, ByRef Matri_Datos() As CAMPOS_PLANTILLA_VALIDACION, _
                                           ByVal id_registro As Integer) As String
        '***********************************************************************************
        'Funcion : Asigna los datos a la matriz de campos seleccionados desde la tabla
        'de la plantilla validacion basado en la estructura tipo CAMPOS_PLANTILLA_VALIDACION
        'identificado por el id del registro
        'Ingeniero :Miguel Angel Urueta Miranda
        'Fecha : 2014-01-08
        '***********************************************************************************
        Try
            Dim campo_idex As String = ""
            Dim Result As String = ""
            '*****************************************************
            'Busca campo identi en la mtriz campos
            '*****************************************************
            For i As Integer = 0 To Matri_Datos.Length - 1
                If Matri_Datos(i).IDENTI_CAMPO = 1 Then
                    campo_idex = Matri_Datos(i).Nombre_Campo
                End If
            Next
            If campo_idex = "" Then
                Asigna_Datos_Matri_Validacion = "La plantilla carece de campo identi por favor agregelo en el modulo administracion"
                Exit Function
            End If
            Dim sql_consulta As String = "Select * from " & nombre_plantilla_validacion & " where " & campo_idex & "='" & id_registro & "'"
            Dim ref As New conect.Dbase_Conction_Mysql_RA
            Dim Datset As DataSet = New DataSet("desxt")
            Result = ref.SELECTION_SELECT_FIELD(sql_consulta, Datset)
            If Result <> "YES" Then
                Asigna_Datos_Matri_Validacion = "Imposible Encontrar datos para listar"
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count > 0 Then
                For i As Integer = 0 To Datset.Tables(0).Columns.Count - 1
                    For z As Integer = 0 To Matri_Datos.Length - 1
                        If Matri_Datos(z).Nombre_Campo = Datset.Tables(0).Columns(i).ColumnName Then
                            If Datset.Tables(0).Rows(0).IsNull(i) = True Then
                                Matri_Datos(z).TEXTO_CAMPO = ""
                            Else
                                Matri_Datos(z).TEXTO_CAMPO = Datset.Tables(0).Rows(0).Item(i)
                            End If

                        End If
                    Next
                Next
            Else
                Asigna_Datos_Matri_Validacion = "Imposible encontrar datos para el registro funcion Asigna_Datos_Matri_Validacion"
                Exit Function
            End If

            Asigna_Datos_Matri_Validacion = "YES"
        Catch ex As Exception
            Asigna_Datos_Matri_Validacion = "Inconsistencia funcion Asigna_Datos_Matri_Validacion " & ex.Message
        End Try
    End Function
