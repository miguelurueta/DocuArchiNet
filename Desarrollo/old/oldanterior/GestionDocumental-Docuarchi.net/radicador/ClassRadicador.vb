    Function Genera_Rotulo_Impresion(ByVal Datos_Rotulo As String, _
                                     ByVal archivo As String, _
                                     ByRef _Plantilla_Impresion() As Plantilla_Impresion, _
                                     ByVal tipo_impresion As String, _
                                     Optional ByRef datos_post As String = "")
        Try
            Dim Result As String = ""
            'Dim _Plantilla_Impresion() As Plantilla_Impresion
            Erase _Plantilla_Impresion
            Dim Matri_Datos_Radicado() As String
            Erase Matri_Datos_Radicado
            '***************************
            '0-codigo destinatario
            '1-codigo remitente
            '2-id usuario
            '3-codigo plantilla
            '4-Consecutivo Radicado
            '5-Consecutivo codigo barra
            '***************************
            Matri_Datos_Radicado = Datos_Rotulo.Split("¬")
            If Matri_Datos_Radicado Is Nothing Then
                Genera_Rotulo_Impresion = "Matriz datos nula"
                Exit Function
            End If
            '*******************************************
            'Genera fill para codigo barras y radicado
            '*******************************************

            'Genera_Rotulo_Impresion = "YES"
            '*****************************************
            'Busca datos de la plantilla de impresion
            '*****************************************
            Result = Lista_Datos_Plantilla_Impresion(Matri_Datos_Radicado(3), _
                                                     _Plantilla_Impresion)
            If Result <> "YES" Then
                Genera_Rotulo_Impresion = Result
                Exit Function
            End If
            If _Plantilla_Impresion Is Nothing Then
                Genera_Rotulo_Impresion = "La plantilla radicacion no tiene plantilla impresión asociada"
                Exit Function
            End If
            '**************************
            'Determina si es visible
            'la entidad radicadora
            '**************************
            Result = ""
            Dim Visible_Campo_Empresa As Integer = 0
            Result = Determina_Visibilidad_Empresa_Radic(Matri_Datos_Radicado(3), _
                                                         Visible_Campo_Empresa)
            If Result <> "YES" Then
                Genera_Rotulo_Impresion = Result
                Exit Function
            End If
            '**************************
            'Busca datos campo nombre
            'entidad radicadora
            '**************************
            If Visible_Campo_Empresa = 1 Then
                Result = ""
                Result = Lista_Nombre_Entidad(_Plantilla_Impresion)
                If Result <> "YES" Then
                    Genera_Rotulo_Impresion = Result
                    Exit Function
                End If
            End If
            '**************************
            'consulta nombre plantilla
            '**************************
            Dim Nombre_Plantilla As String = ""
            Dim Ref_Clas_sytem_plantilla As New Class_system_plantilla_radicado
            Result = Ref_Clas_sytem_plantilla.Solicita_nombre_plantilla_radicado(Val(Matri_Datos_Radicado(3)), _
                                                                                 Nombre_Plantilla)
            If Result <> "YES" Then
                Genera_Rotulo_Impresion = Result
                Exit Function
            End If

            '*****************************
            'Determina el tipo plantilla
            '*****************************
            Dim ref_Class_system_plantilla_radicado As New Class_system_plantilla_radicado
            Dim Tipo_Plantilla As String = ""
            Result = ""
            Result = ref_Class_system_plantilla_radicado.Retorna_Tipo_Plantilla(Matri_Datos_Radicado(3), _
                                                                                Tipo_Plantilla)
            If Result <> "YES" Then
                Genera_Rotulo_Impresion = Result
                Exit Function
            End If
            '*************************
            'Consulta campos plantilla
            '*************************
            Result = ""
            Result = Lista_Datos_Radicacion(_Plantilla_Impresion, _
                                            Matri_Datos_Radicado, _
                                            Nombre_Plantilla, _
                                            Tipo_Plantilla, _
                                            Visible_Campo_Empresa)
            If Result <> "YES" Then
                Genera_Rotulo_Impresion = Result
                Exit Function
            End If

            If tipo_impresion = "2" Then
                Result = Genera_Archivo_Impresion(archivo, _
                                                  _Plantilla_Impresion)
                If Result <> "YES" Then
                    Genera_Rotulo_Impresion = Result
                    Exit Function
                End If
            End If

            If tipo_impresion = "1" Then
                'Result = Genera_Datos_Post_Impresion(datos_post, _Plantilla_Impresion)
                Result = Genera_Archivo_Impresion_tipo_texto(archivo, _
                                                             _Plantilla_Impresion)
                If Result <> "YES" Then
                    Genera_Rotulo_Impresion = Result
                    Exit Function
                End If
            End If
            Genera_Rotulo_Impresion = "YES"
        Catch ex As Exception
            Genera_Rotulo_Impresion = "Inconsistencia general funcion Genera_Rotulo_Impresion " & ex.Message
        End Try
    End Function
