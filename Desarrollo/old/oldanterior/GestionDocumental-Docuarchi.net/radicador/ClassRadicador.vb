    Function seleciona_usuario_interno_dest_gestion_drowp_list(ByVal id_usuario As Integer, _
                                                               ByRef pag As Page) As String
        '*******************************************************************
        'Función : Asigna el usuario de gestion seleccionado
        'Fecha : 2015-04-27
        'Ing : Miguel Angel Urueta Miranda
        '*******************************************************************
        Try
            Dim update As UpdatePanel = pag.FindControl("UpdatePnaelcontrolesradicacion")
            Dim Hiddendestinatario As Object = pag.FindControl("Hiddendestinatario")
            If update Is Nothing Then
                seleciona_usuario_interno_dest_gestion_drowp_list = "Imposible encontrar el control  UpdatePnaelcontrolesradicacion"
                Exit Function
            End If
            If Hiddendestinatario Is Nothing Then
                seleciona_usuario_interno_dest_gestion_drowp_list = "Imposible encontrar el control  Hiddendestinatario"
                Exit Function
            End If
            Dim Droplist As DropDownList = pag.FindControl("Destinatario_Cor")
            If Droplist Is Nothing Then
                seleciona_usuario_interno_dest_gestion_drowp_list = "Imposible encontrar el control  Destinatario_Cor"
                Exit Function
            End If
            Dim sqlconsulta As String = "Select Nombre_Remitente,Cargo_Remite from remit_dest_interno where id_Remit_Dest_Int=" & id_usuario
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA

            Dim Datset As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(sqlconsulta, Datset)
            If Result <> "YES" Then
                seleciona_usuario_interno_dest_gestion_drowp_list = " Función seleciona_usuario_interno_dest_gestion_drowp_list dice   " & Result
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count = 0 Then
                seleciona_usuario_interno_dest_gestion_drowp_list = "Destinatario o usuario de gestión no registrado"
                Exit Function
            Else
                Droplist.SelectedValue = Datset.Tables(0).Rows(0).Item(0).ToString & " ((" & Datset.Tables(0).Rows(0).Item(1).ToString & "))"
                Hiddendestinatario.value = Datset.Tables(0).Rows(0).Item(0).ToString & " ((" & Datset.Tables(0).Rows(0).Item(1).ToString & "))"
                update.Update()
                seleciona_usuario_interno_dest_gestion_drowp_list = "YES"
                Exit Function
            End If
        Catch ex As Exception
            seleciona_usuario_interno_dest_gestion_drowp_list = "Inconsistencia función seleciona_usuario_interno_dest_gestion_drowp_list " & ex.Message
        End Try
    End Function
   
    Function listar_usuarios_destinatarios_internos_auxiliar(ByRef pag As Page, _
                                                             ByRef updat As UpdatePanel) As String
        '**********************************************************************************
        'Llena el destinatario interno con base a la seleccion funcion estrategica
        'llenardestinario java escript activa botn llenardestinatario
        '**********************************************************************************
        Try
            Dim hide As Object = pag.FindControl("Hiddenareagestion")
            If hide Is Nothing Then
                listar_usuarios_destinatarios_internos_auxiliar = "Imposible encontrar el control Hiddenareagestion"
                Exit Function
            End If
            Dim dat_gred_view As GridView = updat.FindControl("data_grid_auxiliar_lista")
            Dim droparea As DropDownList = pag.FindControl("Area_Destinatario_Cor")
            Dim Droplist As DropDownList = pag.FindControl("Destinatario_Cor")
            If dat_gred_view Is Nothing Then
                listar_usuarios_destinatarios_internos_auxiliar = "Imposible encontrar el control data_grid_auxiliar_lista"
                Exit Function
            End If
            If droparea Is Nothing Then
                listar_usuarios_destinatarios_internos_auxiliar = "Imposible encontrar el control Area_Destinatario_Cor"
                Exit Function
            End If
            If Droplist Is Nothing Then
                listar_usuarios_destinatarios_internos_auxiliar = "Imposible encontrar el control Destinatario_Cor"
                Exit Function
            End If
            If droparea.Text = "SELECCIONE" Or droparea.Text = "" Then
                listar_usuarios_destinatarios_internos_auxiliar = "Por favor seleccione el área o las áreas a buscar"
                Exit Function
            End If
            Dim refclas As New ClassRadicador
            Dim refclasremit As New Class_remit_dest_interno
            Dim result As String = ""
            result = refclasremit.Retorna_id_empresa_usuario_gestion(HttpContext.Current.Session.Item("GA_IDUSUARIOGESTION"), _
                                                                     HttpContext.Current.Session.Item("RA_ID_EMPRESA_CONSULTA"))
            If result <> "YES" Then
                listar_usuarios_destinatarios_internos_auxiliar = result
                Exit Function
            Else
                Dim k = HttpContext.Current.Session.Item("RA_ID_EMPRESA_CONSULTA")
                Dim ref_clas_empresa As New Class_registro_organigrama
                Dim id_organigrama As Integer = 0
                result = ref_clas_empresa.Retorna_Id_Organigrama_activo_empresa(Val(HttpContext.Current.Session.Item("RA_ID_EMPRESA_CONSULTA")), _
                                                                                id_organigrama)
                If result <> "YES" Then
                    listar_usuarios_destinatarios_internos_auxiliar = result
                    Exit Function
                Else
                    HttpContext.Current.Session.Item("RA_ID_ORGANIGRAMA") = id_organigrama
                    If Not Droplist Is Nothing Then
                        result = refclasremit.Lista_usuarios_gestion_internos_por_area_auxiliar(Val(HttpContext.Current.Session.Item("RA_ID_ORGANIGRAMA")), _
                                                                                           hide.Value, _
                                                                                           dat_gred_view, _
                                                                                           Val(HttpContext.Current.Session.Item("RA_ID_EMPRESA_CONSULTA")), _
                                                                                           "", _
                                                                                           1, _
                                                                                           "", _
                                                                                           "ASC")
                        If result <> "YES" Then
                            listar_usuarios_destinatarios_internos_auxiliar = result
                            Exit Function
                        End If
                    End If
                End If

            End If
            listar_usuarios_destinatarios_internos_auxiliar = "YES"
        Catch ex As Exception
            listar_usuarios_destinatarios_internos_auxiliar = "Inconsistencia función listar_usuarios_destinatarios_internos_auxiliar " & ex.Message
        End Try
    End Function
    Function Verifica_existencia_radicado_en_plantilla(ByVal nombre_plantilla_radicado As String, _
                                                       ByVal radicado As String) As String
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "select Consecutivo_Rad from " & nombre_plantilla_radicado & " where Consecutivo_Rad='" & _
            radicado & "'"
            Dim Datset As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Datset)
            If Result <> "YES" Then
                Verifica_existencia_radicado_en_plantilla = " Error Listando existencia radicado   " & Result
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count = 0 Then
                Verifica_existencia_radicado_en_plantilla = "El radicado no existe en la plantilla " & nombre_plantilla_radicado
                Exit Function
            Else
                Verifica_existencia_radicado_en_plantilla = "YES"
                Exit Function
            End If
        Catch ex As Exception
            Verifica_existencia_radicado_en_plantilla = "Inconsistencia general función Verifica_existencia_radicado_en_plantilla " & ex.Message
        End Try
    End Function
    Function Verifica_Existencia_Destinatario_Ext_Guia(ByVal Nombre_Destinatario_Ext As String, _
                                                       ByRef Matri_Datos() As String) As String
        '******************************************************
        'Funcion : Verifica_Existencia_Destinatario_Ext_Guia
        'Ing Fidel Eduardo Becerra
        'Descripcion : Verifica la existencia del destinatario
        'interno en la base de datos
        'Modificado : Ing Miguel Angel Urueta Miranda
        'para cumplir con el modo de conexion de la plataforma
        'web
        '******************************************************
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "select DIRECCION_DEST,MUNICIPIO,TELEFONO from destinatario_externo where Nombre_Remitente='" & _
            Nombre_Destinatario_Ext & "'"
            Dim Datset As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Datset)
            If Result <> "YES" Then
                Verifica_Existencia_Destinatario_Ext_Guia = " Error Listando destinatario   " & Result
                Exit Function
            End If
            If Datset.Tables(0).Rows.Count = 0 Then
                Verifica_Existencia_Destinatario_Ext_Guia = "Destinatario no registrado "
                Exit Function
            Else
                Dim Ite As Integer = 0

                For i As Integer = 0 To 2
                    ReDim Preserve Matri_Datos(i)
                    If Datset.Tables(0).Rows(0).IsNull(i) = False Then
                        Matri_Datos(i) = Datset.Tables(0).Rows(0).Item(i).ToString
                    Else
                        Matri_Datos(i) = ""
                    End If

                Next
                Verifica_Existencia_Destinatario_Ext_Guia = "YES"
                Exit Function
            End If

            Verifica_Existencia_Destinatario_Ext_Guia = "YES"
        Catch ex As Exception
            Verifica_Existencia_Destinatario_Ext_Guia = "Error General Funcion  Verifica_Existencia_Destinatario_Ext_Guia " & ex.Message
        End Try
    End Function
