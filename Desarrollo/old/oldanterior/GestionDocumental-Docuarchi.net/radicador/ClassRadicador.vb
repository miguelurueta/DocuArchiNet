            '--------------------------------------------------------------------------------------
            Dim TextBoxEditNombreDestRem As TextBox = pag.FindControl("TextBoxEditNombreDestRem")
            Dim TextBoxEditDirecionDestEst As TextBox = pag.FindControl("TextBoxEditDirecionDestEst")
