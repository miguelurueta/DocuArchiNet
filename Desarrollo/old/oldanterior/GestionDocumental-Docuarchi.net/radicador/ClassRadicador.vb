        '--------------------------------------------------------------------
        'Caso usuario responsable con flujo o sin flujo
        '--------------------------------------------------------------------
        If actividades_generales_workflow_.Nombre_tipo_actividad = "USUARIORESPONSABLE" Then
            If Hidden_id_user_wf.value = "-1" Or Hidden_id_user_wf.value = "" Then
