                                                                                   matri)
        If Result <> "YES" Then
            Registra_Radicado_plantilla_respuesta = Result
            Exit Function
        End If

        If Not matri Is Nothing Then
            For i2 As Integer = 0 To matri.Length - 1
                For i3 As Integer = 0 To Matri_Datos.Length - 1
