    Function Retorna_nombre_expediente_id_expediente_radicado(ByVal radicado As String,
                                                              ByVal nombre_plantilla_radicado As String,
                                                              ByRef id_expediente As Integer,
                                                              ByRef nombre_expediente As String,
                                                              ByRef id_tipo_expediente As Integer) As String
        '----------------------------------------------
        'Función : Retorna el nombre del expediente
        'y el id del expediente
        'Ing : Miguel Angel Urueta Miranda
        'Fecha : 2017-04-19
        '----------------------------------------------
        Try
            Dim Ref_Car_Conec As New conect.Dbase_Conction_Mysql_RA
            Dim Parametro_Consulta As String = "SELECT rad.id_Expediente,rad.Expediente,ea.RA_TIP_EXPE_ID_TIPO_EXPEDIENTE " &
            "FROM " & nombre_plantilla_radicado & " as rad " &
            " INNER JOIN expediente_archivo as ea on (ea.ID_EXPEDIENTE=rad.id_Expediente)" &
            "where Consecutivo_Rad='" & radicado & "'"
            Dim Dat_reader As New DataSet
            Dim Result As String = ""
            Result = Ref_Car_Conec.SELECTION_SELECT_FIELD(Parametro_Consulta, Dat_reader)
            If Result <> "YES" Then
                Retorna_nombre_expediente_id_expediente_radicado = " Error consultando el consecutivo del radicado  " & Result
                Exit Function
            End If
            If Dat_reader.Tables(0).Rows.Count = 0 Then
                Retorna_nombre_expediente_id_expediente_radicado = "YES"
                Exit Function
            Else
                If Dat_reader.Tables(0).Rows(0).IsNull(0) = False Then
                    id_expediente = Dat_reader.Tables(0).Rows(0).Item(0)
                Else
                    id_expediente = 0
                End If
                If Dat_reader.Tables(0).Rows(0).IsNull(1) = False Then
                    nombre_expediente = Dat_reader.Tables(0).Rows(0).Item(1)
                Else
                    nombre_expediente = ""
                End If
                If Dat_reader.Tables(0).Rows(0).IsNull(2) = False Then
                    id_tipo_expediente = Dat_reader.Tables(0).Rows(0).Item(2)
                Else
                    id_tipo_expediente = 0
                End If
                Retorna_nombre_expediente_id_expediente_radicado = "YES"
                Exit Function
            End If
        Catch ex As Exception
            Retorna_nombre_expediente_id_expediente_radicado = "Inconsistencia general funcion Retorna_nombre_expediente_id_expediente_radicado " & ex.Message
        End Try
    End Function


