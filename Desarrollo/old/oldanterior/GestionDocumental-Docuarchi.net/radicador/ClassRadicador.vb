                Exit Function
            End If
            Dim contador As Integer = 0
            If Dat_reader.Tables(0).Rows.Count > 0 Then
                consecutivo_plantilla_validacion = Dat_reader.Tables(0).Rows(0).Item(0)
                Retorna_id_registro_plantilla_validacion = "YES"
                Exit Function
            Else
