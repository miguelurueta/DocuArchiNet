# Copie este archivo como ".env.jira" y complete los valores.

# Jira (Atlassian)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# GitHub
GITHUB_TOKEN=

# Repositorio (use una de las dos opciones)
# Opcion A: owner/name
GITHUB_REPO=

# Opcion B: separado
GITHUB_OWNER=
GITHUB_REPO_NAME=

# Opcional
GITHUB_BASE_BRANCH=main
GIT_AUTO_PUSH=true
